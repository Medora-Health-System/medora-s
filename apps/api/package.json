{
  "name": "@medora/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf dist tsconfig.build.tsbuildinfo && nest start --watch",
    "postinstall": "prisma generate",
    "prebuild": "pnpm --filter @medora/shared build && prisma generate",
    "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "start": "node dist/main.js",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "node -e \"console.log('lint not configured yet')\"",
    "test": "jest --config jest.config.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "seed": "prisma db seed",
    "prisma:seed-catalogs": "pnpm --filter @medora/shared build && ts-node --transpile-only prisma/seed-catalogs.ts",
    "prisma:seed-pathways": "ts-node --transpile-only prisma/seed-pathways.ts",
    "create-admin": "ts-node --transpile-only scripts/create-admin.ts",
    "db:clear:patients": "ts-node --transpile-only scripts/clearPatientData.ts",
    "backfill:mspp-disease-reviews": "ts-node --transpile-only scripts/backfill-mspp-disease-reviews.ts",
    "backfill:billing-events-from-capture": "ts-node --transpile-only scripts/backfill-billing-events-from-capture.ts",
    "billing:recode-unmapped": "ts-node --transpile-only scripts/recode-unmapped-billing-events.ts",
    "backfill:mar-route-from-catalog": "ts-node --transpile-only scripts/backfill-mar-route-from-catalog.ts",
    "import:icd10-catalog": "ts-node --transpile-only scripts/import-icd10-catalog.ts",
    "icd10:report-readiness": "ts-node --transpile-only scripts/report-icd10-readiness.ts",
    "export:ed-diagnosis-shadow": "ts-node --transpile-only scripts/export-ed-diagnosis-shadow-audit.ts",
    "diagnose:ed-diagnosis-export": "ts-node --transpile-only scripts/diagnose-ed-diagnosis-export.ts",
    "import:billing-procedure-codes": "ts-node --transpile-only scripts/import-billing-procedure-codes.ts",
    "import:medication-billing-catalog": "ts-node --transpile-only scripts/import-medication-billing-catalog.ts",
    "catalog:import-display-en": "ts-node --transpile-only scripts/import-catalog-display-en.ts",
    "catalog:report-display-en": "ts-node --transpile-only scripts/report-catalog-display-en-coverage.ts",
    "catalog:transfer-ct-head-alias": "ts-node --transpile-only prisma/scripts/transfer-ct-head-alias.ts",
    "catalog:deactivate-ct-head": "ts-node --transpile-only prisma/scripts/deactivate-ct-head-catalog.ts",
    "catalog:readiness": "pnpm run catalog:report-display-en && pnpm run icd10:report-readiness",
    "catalog:gen-haiti-med-en-csv": "ts-node --transpile-only scripts/generate-phase-f-medication-display-en-csv.ts",
    "catalog:guard-stale-js": "ts-node --transpile-only scripts/assert-no-stale-prisma-catalog-js.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@medora/shared": "workspace:*",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.44.0",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "multer": "^2.1.1",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.2.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2-sftp-client": "^12.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.7",
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
