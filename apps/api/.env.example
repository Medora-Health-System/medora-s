DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medora?schema=public"
# TEMP : si la base n’a pas encore OrderItem.manualLabel / manualSecondaryText, mettre 0 jusqu’à migrate deploy — retirer le repli côté code ensuite.
# MEDORA_ORDER_ITEM_MANUAL_COLUMNS=0
PORT=3001

# Origines CORS autorisées (séparées par des virgules), ex. https://app.votredomaine.com
# En production (NODE_ENV=production), localhost n’est pas inclus par défaut — définir au moins l’origine du front.
# En dev, localhost:3002 / :3003 et 127.0.0.1 équivalents sont ajoutés automatiquement.
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
# Durée de vie du jeton d’accès — doit être identique à JWT_ACCESS_TTL dans apps/web/.env (cookies + intervalle de refresh UI).
JWT_ACCESS_TTL=8h
# D4SEC.1C.4A: access tokens require an authoritative AuthSession `sid`.
# Deploying this transition requires users with older sid-less tokens to sign in again.
JWT_REFRESH_TTL=14d
TOKEN_ISSUER=medora-s

# Base URL for password reset links (use your web app URL, e.g. http://localhost:3002). In dev the link is also logged to API console.
RESET_PASSWORD_BASE_URL=http://localhost:3002

# Audit: persistence mode.
# - best_effort (default): clinical writes succeed even if audit insert fails (failure is logged).
# - fail_closed: critical clinical actions require audit insert in the same DB transaction; failure returns 503 with code AUDIT_WRITE_FAILED_BLOCKED_ACTION.
# AUDIT_FAILURE_MODE=best_effort
