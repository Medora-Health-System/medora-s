generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  PROVIDER
  RN
  FRONT_DESK
  LAB
  RADIOLOGY
  PHARMACY
  BILLING
}

enum DepartmentCode {
  PRIMARY_CARE
  LAB
  RAD
  PHARM
  INPATIENT
}

/// Clinical / legacy shorthand stored alongside `Patient.sex` (canonical demographic enum).
enum SexAtBirth {
  M
  F
  X
  U
}

/// Canonical patient demographic sex for APIs, search, and offline snapshots (no age stored).
enum PatientSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum InsuranceCoverageRank {
  PRIMARY
  SECONDARY
}

enum PathwayType {
  STROKE
  SEPSIS
  STEMI
  TRAUMA
}

enum PathwayStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PathwayMilestoneStatus {
  PENDING
  MET
  OVERDUE
  SKIPPED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  VIEW
  SEED
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_VIEW
  ENCOUNTER_CREATE
  ENCOUNTER_UPDATE
  ENCOUNTER_CLOSE
  ENCOUNTER_VIEW
  ORDER_CREATE
  ORDER_CANCEL
  ORDER_VIEW
  CHART_ACCESS
  ORDER_UPDATE
  RESULT_UPLOAD
  MEDICATION_DISPENSED
  BILLING_FINALIZED
  BILLING_REOPENED
  CHART_OPEN
  TRIAGE_SAVE
  ORDER_ACK
  ORDER_START
  ORDER_COMPLETE
  RESULT_VERIFY
  CRITICAL_FLAG
  PATHWAY_ACTIVATED
  ORDERS_CREATED
  PROVIDER_DOCUMENTATION_SIGN
  PROVIDER_DOCUMENTATION_ADDENDUM
  BREAK_GLASS_START
  BREAK_GLASS_ACCESS
  BREAK_GLASS_END
}

/// Charge-capture ledger (Phase 1) — complements Encounter.billingCaptureJson; idempotent per source.
enum BillingSourceModule {
  DIAGNOSIS
  ORDER_ITEM
  MEDICATION_DISPENSE
  MEDICATION_ADMINISTRATION
  ENCOUNTER_DISPOSITION
  MANUAL
  VACCINE_ADMINISTRATION
  /// Catalog-driven auto billing (Phase 4.5) — distinct from ORDER_ITEM ledger lines.
  LAB_RESULT
  IMAGING_RESULT
  MED_ADMIN
  PROCEDURE
  /// Emergency E/M (Phase 4.6) — one per encounter, idempotent on encounter id.
  ENCOUNTER_EM
  /// Catalog-driven supply billing (Phase 4.6).
  SUPPLY
}

enum BillingReviewStatus {
  CAPTURED
  REVIEWED
  VOIDED
  SKIPPED
}

enum BillingCodeType {
  UNKNOWN
  INTERNAL
  CPT
  HCPCS
  ICD10_CM
}

enum BillingSide {
  UNKNOWN
  PROFESSIONAL
  FACILITY
  BOTH
}

/// Claim-readiness workflow for an encounter (Phase 3 — no payer submission).
enum EncounterBillingFinalizationStatus {
  NOT_READY
  READY_FOR_REVIEW
  FINALIZED
  REOPENED
}

/// Phase 6.2 — persisted claim submission artifacts (no live clearinghouse transmission).
enum ClaimSubmissionKind {
  PROFESSIONAL_837P
  FACILITY_837I
}

enum ClaimSubmissionStatus {
  DRAFT
  GENERATED
  READY_TO_SEND
  SENT
  ACK_PENDING
  ACCEPTED
  REJECTED
  NEEDS_CORRECTION
  CANCELLED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  URGENT_CARE
}

enum EncounterStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Explicit clinical / operational pathway (distinct from `EncounterStatus` lifecycle).
enum EncounterWorkflowState {
  ARRIVED
  TRIAGE
  IN_TREATMENT
  RESULTS_PENDING
  DISPOSITION
  DISCHARGE_READY
  FINALIZED
  CLOSED
}

enum DischargeStatus {
  DISCHARGED
  AMA
  TRANSFERRED
  DECEASED
}

enum OrderStatus {
  DRAFT
  PLACED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  RESULTED
  VERIFIED
  CANCELLED
  PENDING
  SIGNED
}

/// Closed-loop line-item lifecycle (distinct from legacy `OrderStatus` values like RESULTED / VERIFIED).
enum OrderItemLifecycleState {
  ORDERED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELLED
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

/// Med order intent: RN executes in-chart vs pharmacy fulfills for outpatient / discharge.
enum MedicationFulfillmentIntent {
  ADMINISTER_CHART
  PHARMACY_DISPENSE
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

enum InventoryTransactionType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  WASTE
}

enum DiseaseCaseStatus {
  SUSPECTED
  CONFIRMED
  RULED_OUT
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Classification for facilities (for future use on `Facility`; Phase 1 adds enum only).
enum FacilityType {
  HOSPITAL
  CLINIC
  HEALTH_CENTER
  LABORATORY
  SURVEILLANCE_POST
  COMMUNITY_SITE
  OTHER
}

/// National MSPP portal roles (separate from facility-scoped `RoleCode`).
enum MsppRoleCode {
  MSPP_MINISTRE
  MSPP_EPIDEMIOLOGIE
  MSPP_VALIDATOR_DEPT
  MSPP_VALIDATOR_CENTRAL
  /// Administration déléguée des accès MSPP (sans pouvoirs plateforme).
  MSPP_ADMIN
  /// Accès module partagé « Santé publique » (résumé) — UI ; API toujours liée à l’établissement actif.
  MSPP_PUBLIC_HEALTH
  /// Accès module « Déclarations maladies » — UI ; API toujours liée à l’établissement actif.
  MSPP_DISEASE_REPORTS
  /// Accès module « Vaccinations » — UI ; API toujours liée à l’établissement actif.
  MSPP_VACCINATIONS
}

model Facility {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  country   String
  timezone  String
  defaultLanguage String @default("fr")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments            Department[]
  userRoles              UserRole[]
  patientsRegistered     Patient[]               @relation("RegisteredAtFacility")
  patients               Patient[]               @relation("PatientFacility")
  encounters             Encounter[]
  orders                 Order[]
  auditLogs              AuditLog[]
  triages                Triage[]
  results                Result[]
  pathwaySessions        PathwaySession[]
  protocolOrderSets      ProtocolOrderSet[]
  diagnoses              Diagnosis[]
  medicationDispenses    MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  inventoryItems             InventoryItem[]
  inventoryTransactions      InventoryTransaction[]
  facilityMedicationUsages   FacilityMedicationUsage[]
  vaccineAdministrations     VaccineAdministration[]
  diseaseCaseReports         DiseaseCaseReport[]
  followUps                  FollowUp[]
  triageVitalsReadings       TriageVitalsReading[]
  encounterProviderAddenda   EncounterProviderAddendum[]
  breakGlassSessions         BreakGlassSession[]
  encounterIntakes           EncounterIntake[]
  patientInsuranceCoverages  PatientInsuranceCoverage[]
  billingEvents              BillingEvent[]
  claimSubmissionBatches     ClaimSubmissionBatch[]
  claimSubmissions           ClaimSubmission[]
  claimControlCounters       ClaimControlCounter[]
  claimAcknowledgments            ClaimAcknowledgment[]
  claimAcknowledgmentDeadLetters  ClaimAcknowledgmentDeadLetter[]
}

/// Catalogue payeur (installation) — recherche par nom normalisé.
model InsurancePayer {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  /// Stable catalog key for idempotent seed (e.g. US_CAT_AETNA). Optional for legacy / manual rows.
  code           String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coverages PatientInsuranceCoverage[]

  @@index([normalizedName])
}

/// Couverture par patient et établissement — V2+ peut étendre sans casser Phase 2.
model PatientInsuranceCoverage {
  id                   String                @id @default(uuid())
  patientId            String
  facilityId           String
  rank                 InsuranceCoverageRank
  payerId              String?
  payerNameFreeText    String?
  planName             String?
  memberId             String?
  groupNumber          String?
  subscriberName       String?
  relationToSubscriber String?
  phone                String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility  Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  payer     InsurancePayer? @relation(fields: [payerId], references: [id], onDelete: SetNull)

  @@unique([patientId, facilityId, rank])
  @@index([patientId])
  @@index([facilityId])
}

model Department {
  id         String         @id @default(uuid())
  facilityId String
  code       DepartmentCode
  name       String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([facilityId, code])
}

model Role {
  id        String   @id @default(uuid())
  code      RoleCode @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  firstName        String
  lastName         String
  passwordHash     String
  refreshTokenHash String?
  isActive         Boolean  @default(true)
  /// Plateforme : réservé au compte principal unique (`atranchant@medora.local`); tenir aligné avec les migrations (index unique partiel).
  canCreateFacilities Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userRoles              UserRole[]
  auditLogs              AuditLog[]
  medicationDispenses    MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  inventoryTransactions  InventoryTransaction[]
  vaccineAdministrations VaccineAdministration[]
  diseaseCaseReports     DiseaseCaseReport[]
  followUpsCreated      FollowUp[]
  passwordResetTokens   PasswordResetToken[]

  encountersAsAssignedPhysician Encounter[] @relation("EncounterPhysicianAssigned")
  encountersSignedByProvider    Encounter[] @relation("EncounterSignedBy")
  encountersBillingFinalizedBy  Encounter[] @relation("EncounterBillingFinalizedBy")
  encountersBillingReopenedBy   Encounter[] @relation("EncounterBillingReopenedBy")
  providerAddendaCreated EncounterProviderAddendum[]
  orderItemsCompletedNurse      OrderItem[] @relation("OrderItemNurseCompleted")
  ordersCancelled               Order[]     @relation("OrderCancelledBy")
  msppUserRoleAssignments       MsppUserRoleAssignment[]
  msppReviewAuditEvents         MsppReviewAuditEvent[]
  msppAlertTriagesAcknowledged  MsppAlertTriage[]        @relation("MsppAlertTriageAckBy")
  msppAlertTriagesAssigned      MsppAlertTriage[]        @relation("MsppAlertTriageAssignTo")
  msppAlertInvestigationsOpened   MsppAlertInvestigation[]       @relation("MsppAlertInvestigationOpenedBy")
  msppAlertInvestigationsAssigned MsppAlertInvestigation[]       @relation("MsppAlertInvestigationAssignedTo")
  msppAlertInvestigationEventsCreated MsppAlertInvestigationEvent[] @relation("MsppAlertInvestigationEventCreatedBy")
  msppDiseaseReportFeedbacksCreated          MsppDiseaseReportFeedback[] @relation("MsppDiseaseReportFeedbackCreatedBy")
  msppDiseaseReportFeedbacksFacilityReviewed MsppDiseaseReportFeedback[] @relation("MsppDiseaseReportFeedbackFacilityReviewedBy")
  msppDiseaseReportFeedbacksResolved         MsppDiseaseReportFeedback[] @relation("MsppDiseaseReportFeedbackResolvedBy")
  authSessions                               AuthSession[]
  breakGlassSessions                         BreakGlassSession[]
}

/// Session de rafraîchissement par appareil / navigateur (jeton avec revendication `sid` dans le JWT refresh).
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

/// Facility-scoped role assignment (user + Role row + facility). Same idea as a dedicated `FacilityUserRole` model.
model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  facilityId   String
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, facilityId])
  @@index([userId])
  @@index([facilityId])
  @@index([facilityId, roleId])
  @@index([departmentId])
}

/// Demographics: date of birth is `dob` only (age is always derived). `sex` is canonical; `sexAtBirth` kept for legacy/API parity.
model Patient {
  id                     String      @id @default(uuid())
  facilityId             String
  mrn                    String?
  globalMrn              String      @unique
  firstName              String
  lastName               String
  middleName             String?
  dob                    DateTime?
  phone                  String?
  email                  String?
  sexAtBirth             SexAtBirth?
  sex                    PatientSex  @default(UNKNOWN)
  nationalId             String?
  address                String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  stateProvince          String?
  postalCode             String?
  country                String?
  emergencyContactName           String?
  emergencyContactRelationship   String?
  emergencyContactPhone          String?
  adminNotes                     String?
  language               String?
  registeredAtFacilityId String
  /// Denormalized latest vitals JSON for chart header / offline read models; updated when triage or encounter vitals are saved.
  latestVitalsJson       Json?
  latestVitalsAt         DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  facility               Facility                @relation("PatientFacility", fields: [facilityId], references: [id], onDelete: Restrict)
  registeredAtFacility   Facility                @relation("RegisteredAtFacility", fields: [registeredAtFacilityId], references: [id], onDelete: Restrict)
  encounters             Encounter[]
  orders                 Order[]
  auditLogs              AuditLog[]
  diagnoses              Diagnosis[]
  medicationDispenses    MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  vaccineAdministrations VaccineAdministration[]
  diseaseCaseReports     DiseaseCaseReport[]
  followUps              FollowUp[]
  triageVitalsReadings   TriageVitalsReading[]
  breakGlassSessions     BreakGlassSession[]
  insuranceCoverages     PatientInsuranceCoverage[]
  billingEvents          BillingEvent[]

  @@unique([facilityId, mrn])
  @@index([facilityId])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([mrn])
}

model AuditLog {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  userId     String?
  facilityId String?
  patientId  String?
  ip         String?
  userAgent  String?
  entityType String
  entityId   String?
  action     AuditAction
  metadata   Json?

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  facility    Facility?  @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  patient     Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounter   Encounter? @relation("EncounterAuditLogs", fields: [encounterId], references: [id], onDelete: SetNull)
  order       Order?     @relation("OrderAuditLogs", fields: [orderId], references: [id], onDelete: SetNull)
  encounterId String?
  orderId     String?

  @@index([userId])
  @@index([facilityId])
  @@index([createdAt])
  @@index([encounterId])
}

model Encounter {
  id         String          @id @default(uuid())
  facilityId String
  patientId  String
  providerId String?
  type       EncounterType
  status     EncounterStatus @default(OPEN)
  workflowState EncounterWorkflowState @default(ARRIVED)

  chiefComplaint    String?
  triageAcuity      Int?
  vitals            Json?
  nursingAssessment Json?
  providerNote      String?
  /// Outpatient / clinic: structured treatment summary (distinct from free-text notes)
  treatmentPlan     String?
  followUpDate      DateTime?
  disposition       String?
  dischargeStatus   DischargeStatus?
  dischargedAt      DateTime?

  /// French-facing room label: "Salle d'attente" or "1"…"30"
  roomLabel               String?
  /// Assigned attending physician (display name only in UI; never use for nurse attribution)
  physicianAssignedUserId String?
  physicianAssigned       User?   @relation("EncounterPhysicianAssigned", fields: [physicianAssignedUserId], references: [id], onDelete: SetNull)
  /// Structured discharge summary (French UI keys / values); saved before closing when using discharge flow
  dischargeSummaryJson    Json?

  /// Synthèse structurée d'admission (hospitalisation depuis la consultation) — MVP, une décision par visite
  admissionSummaryJson Json?
  /// U.S. billing foundation — charge capture / billing event candidates (V1 shared schema)
  billingCaptureJson   Json?
  /// Phase 3 — billing finalization for claim assembly (no submission in this phase).
  billingFinalizationStatus EncounterBillingFinalizationStatus @default(NOT_READY)
  billingFinalizedAt        DateTime?
  billingFinalizedByUserId  String?
  billingFinalizedBy        User?   @relation("EncounterBillingFinalizedBy", fields: [billingFinalizedByUserId], references: [id], onDelete: SetNull)
  billingReopenedAt         DateTime?
  billingReopenedByUserId   String?
  billingReopenedBy         User?   @relation("EncounterBillingReopenedBy", fields: [billingReopenedByUserId], references: [id], onDelete: SetNull)
  /// Last computed readiness snapshot (blockers, warnings, counts) for audit / UI.
  billingReadinessSnapshotJson Json?
  /// Horodatage de la décision d'admission (rempli côté serveur à la 1re sauvegarde du dossier d'admission)
  admittedAt           DateTime?

  notes String?

  /// DRAFT | SIGNED — signature médicale sur l’évaluation (V1)
  providerDocumentationStatus         String    @default("DRAFT")
  providerDocumentationSignedAt       DateTime?
  providerDocumentationSignedByUserId String?
  providerDocumentationSignedBy       User?     @relation("EncounterSignedBy", fields: [providerDocumentationSignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Optimistic locking — increment on every successful mutating write.
  version   Int      @default(1)

  patient                Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility               Facility                @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  orders                 Order[]
  auditLogs              AuditLog[]              @relation("EncounterAuditLogs")
  triage                 Triage?
  pathwaySession         PathwaySession?
  diagnoses              Diagnosis[]
  medicationDispenses    MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  vaccineAdministrations VaccineAdministration[]
  diseaseCaseReports     DiseaseCaseReport[]
  followUps              FollowUp[]
  triageVitalsReadings   TriageVitalsReading[]
  providerAddenda        EncounterProviderAddendum[]
  breakGlassSessions     BreakGlassSession[]
  intake                 EncounterIntake?
  billingEvents          BillingEvent[]
  claimSubmissions       ClaimSubmission[]

  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([workflowState])
  @@index([physicianAssignedUserId])
  @@index([providerDocumentationSignedByUserId])
  @@index([billingFinalizationStatus])
}

/// Optional mapping from clinical catalog / external codes to billable CPT/HCPCS (Phase 4.5 auto engine).
model BillingCatalog {
  id            String   @id @default(uuid())
  /// Billable code (CPT or HCPCS) to apply when matched.
  code          String
  /// "CPT" | "HCPCS"
  system        String
  description   String
  /// LAB | IMAGING | MEDICATION | PROCEDURE | SUPPLY
  triggerSource String
  /// LOINC, internal lab code, imaging study code, medication code, etc.
  externalCode  String?
  /// "professional" | "facility" | "both"
  billClass     String
  createdAt     DateTime @default(now())

  @@index([triggerSource])
  @@index([externalCode])
}

/// Relational billing event ledger — automatic capture from clinical actions (Phase 1).
model BillingEvent {
  id                  String              @id @default(uuid())
  facilityId          String
  patientId           String
  encounterId         String
  /// Latest BillingCaptureItem.id when synced from JSON pipeline.
  captureItemId       String?
  sourceModule        BillingSourceModule
  /// Business key for idempotency (order item id, diagnosis id, administration id, etc.).
  sourceRecordId      String
  eventType           String              @default("CHARGE_CAPTURE")
  serviceDate         DateTime?
  units               Int?
  codeType            BillingCodeType?
  code                String?
  procedureCode       String?
  hcpcsCode           String?
  diagnosisCodes      String?
  descriptionSnapshot String?             @db.Text
  priceSnapshot       Decimal?            @db.Decimal(14, 2)
  modifier1           String?
  modifier2           String?
  revenueCode         String?
  billingSide         BillingSide         @default(UNKNOWN)
  reviewStatus        BillingReviewStatus @default(CAPTURED)
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@unique([facilityId, sourceModule, sourceRecordId])
  @@index([encounterId])
  @@index([facilityId, reviewStatus])
  @@index([patientId])
}

/// Métadonnées d’accueil / arrivée liées à une visite — ne remplace pas le motif clinique sur Encounter.
model EncounterIntake {
  id                    String    @id @default(uuid())
  encounterId           String    @unique
  facilityId            String
  arrivalAt             DateTime?
  modeOfArrival         String?
  initialChiefComplaint String?
  initialAcuity         Int?
  initialRoom           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([encounterId])
  @@index([facilityId])
}

/// Time-limited emergency chart access (break-glass) — scoped to one patient (and optionally one encounter) per session.
model BreakGlassSession {
  id          String    @id @default(uuid())
  userId      String
  facilityId  String
  patientId   String
  encounterId String?
  reason      String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([userId, facilityId, patientId])
  @@index([facilityId, patientId])
  @@index([expiresAt])
}

/// Append-only addendum after provider documentation is signed (V1 — no edit/delete).
model EncounterProviderAddendum {
  id              String   @id @default(uuid())
  encounterId     String
  facilityId      String
  text            String
  createdAt       DateTime @default(now())
  createdByUserId String

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([encounterId, createdAt])
  @@index([createdByUserId])
  @@index([facilityId])
}

model Order {
  id                 String        @id @default(uuid())
  encounterId        String
  facilityId         String
  type               String // "LAB", "IMAGING", "MEDICATION"
  status             OrderStatus   @default(PENDING)
  priority           OrderPriority @default(ROUTINE)
  notes              String?
  orderedBy          String?
  source             String? // "MANUAL", "PROTOCOL"
  pathwaySessionId   String?
  prescriberName     String?
  prescriberLicense  String?
  prescriberContact  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?

  encounter      Encounter       @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId      String
  pathwaySession PathwaySession? @relation(fields: [pathwaySessionId], references: [id], onDelete: SetNull)
  cancelledBy    User?           @relation("OrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  auditLogs      AuditLog[]      @relation("OrderAuditLogs")

  @@index([encounterId])
  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([pathwaySessionId])
  @@index([cancelledByUserId])
}

model OrderItem {
  id              String      @id @default(uuid())
  orderId         String
  /// Référence catalogue (nullable si saisie manuelle — `manualLabel` requis dans ce cas).
  catalogItemId   String?
  catalogItemType String // "LAB_TEST", "IMAGING_STUDY", "MEDICATION"
  /// Libellé saisi à la main lorsque l’article n’existe pas au catalogue (analyse, examen, médicament).
  manualLabel          String?
  /// Précision (ex. région imagerie) ou texte secondaire d’affichage.
  manualSecondaryText  String?
  quantity        Int?
  notes           String?
  strength        String?     // e.g. "500 mg" for medication
  refillCount     Int?        // number of refills for Rx
  medicationFulfillmentIntent MedicationFulfillmentIntent?
  /// Administration prévue (information clinique, pas planification récurrente).
  intendedAdministrationAt DateTime?
  completedAt     DateTime?
  completedByUserId String?
  completedByNurse User?     @relation("OrderItemNurseCompleted", fields: [completedByUserId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PENDING)
  /// Explicit visit lifecycle — kept in sync with `status` in application code; `REVIEWED` = chart/review closure.
  lifecycleState  OrderItemLifecycleState @default(ORDERED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  result Result?
  pharmacyDispenseRecord MedicationDispense?
  medicationAdministrations MedicationAdministration[]

  @@index([orderId])
  @@index([status])
  @@index([lifecycleState])
  @@index([catalogItemType])
  @@index([catalogItemId])
  @@index([completedByUserId])
  @@index([medicationFulfillmentIntent])
}

model Triage {
  id               String    @id @default(uuid())
  encounterId      String    @unique
  facilityId       String
  chiefComplaint   String?
  onsetAt          DateTime?
  esi              Int?
  vitalsJson       Json?
  strokeScreen     Json?
  sepsisScreen     Json?
  triageCompleteAt DateTime?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  triageVitalsReadings TriageVitalsReading[]

  @@index([facilityId])
  @@index([encounterId])
}

/// Append-only vitals readings per triage save (Signes vitaux); `Triage.vitalsJson` remains current row.
model TriageVitalsReading {
  id               String    @id @default(uuid())
  facilityId       String
  patientId        String
  encounterId      String
  triageId         String
  vitalsJson       Json
  triageCompleteAt DateTime?
  recordedAt       DateTime  @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  triage    Triage    @relation(fields: [triageId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([patientId, recordedAt])
  @@index([encounterId])
  @@index([triageId])
}

model Result {
  id                       String    @id @default(uuid())
  orderItemId              String    @unique
  facilityId               String
  resultData               Json?
  resultText               String?
  criticalValue            Boolean   @default(false)
  verifiedByUserId         String?
  verifiedAt               DateTime?
  acknowledgedByProviderAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([orderItemId])
  @@index([criticalValue])
}

/// Shared catalog row: stable `code`, French label, `searchText` for unified search, `updatedAt` for sync.
model CatalogLabTest {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  displayNameFr String?
  /// Optional U.S. CPT/HCPCS-style code suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description   String?
  searchText    String?
  sortPriority  Int      @default(0)
  isEssential   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases LabTestAlias[]
}

model LabTestAlias {
  id               String   @id @default(uuid())
  catalogLabTestId String
  alias            String
  language         String?
  createdAt        DateTime @default(now())

  catalogLabTest CatalogLabTest @relation(fields: [catalogLabTestId], references: [id], onDelete: Cascade)

  @@index([catalogLabTestId])
  @@index([alias])
  @@unique([catalogLabTestId, alias])
}

/// Shared catalog row: stable `code`, French label, `searchText` for unified search, `updatedAt` for sync.
model CatalogImagingStudy {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  displayNameFr String?
  /// Optional U.S. CPT/HCPCS-style code suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description   String?
  modality      String?
  bodyRegion    String?
  searchText    String?
  sortPriority  Int      @default(0)
  isEssential   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases ImagingStudyAlias[]
}

model ImagingStudyAlias {
  id                     String   @id @default(uuid())
  catalogImagingStudyId  String
  alias                  String
  language               String?
  createdAt              DateTime @default(now())

  catalogImagingStudy CatalogImagingStudy @relation(fields: [catalogImagingStudyId], references: [id], onDelete: Cascade)

  @@index([catalogImagingStudyId])
  @@index([alias])
  @@unique([catalogImagingStudyId, alias])
}

/// Shared catalog row: stable `code`, French label, `searchText` for unified search, `updatedAt` for sync.
model CatalogMedication {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  /// Optional HCPCS/J-code-style suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  genericName       String?
  displayNameFr     String?
  strength          String?
  dosageForm        String?
  route             String?
  therapeuticClass  String?
  sortPriority      Int      @default(0)
  isEssential       Boolean  @default(false)
  searchText        String?

