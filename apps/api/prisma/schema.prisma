generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id                                     String                                 @id @default(uuid())
  code                                   String                                 @unique
  name                                   String
  country                                String
  timezone                               String
  isActive                               Boolean                                @default(true)
  createdAt                              DateTime                               @default(now())
  updatedAt                              DateTime                               @updatedAt
  defaultLanguage                        String                                 @default("fr")
  /// Phase 7 — institutional / UB-style claim billing identity (optional).
  billingLegalName                       String?
  billingNpi                             String?
  taxIdEin                               String?
  billingAddressLine1                    String?
  billingAddressLine2                    String?
  billingCity                            String?
  billingStateProvince                   String?
  billingPostalCode                      String?
  billingCountry                         String?
  billingFacilityTypeLabel               String?
  /// Phase 1 — freestanding-ER policy: when true, RN may submit `LAB_TEST` results at this facility.
  /// Default false preserves existing safe behavior (LAB/RADIOLOGY/ADMIN only). Never grants RN
  /// imaging submission, provider verification, order creation, or other LAB-role privileges.
  allowRnLabResultSubmission             Boolean                                @default(false)
  /// Phase 19UCED.1 — structured billing site profile for default encounter classification.
  billingSiteType                        FacilityBillingSiteType?
  /// Phase 19UCED.2 — facility billing workflow mode (nullable = infer from billingSiteType / legacy).
  billingClassificationMode              FacilityBillingClassificationMode?
  allowedEncounterBillingClassifications BillingClassification[]                @default([])
  allowUrgentCareToEmergencyUpgrade      Boolean                                @default(false)
  requireUcToEdPatientAcknowledgement    Boolean                                @default(true)
  showEncounterBillingControls           Boolean                                @default(false)
  /// EDOC.4 — optional facility overrides for dual-signature clinical documentation cards.
  clinicalDocumentationWitnessPolicyJson Json?
  auditLogs                              AuditLog[]
  billingEvents                          BillingEvent[]
  billingReviewDecisions                 BillingReviewDecision[]
  breakGlassSessions                     BreakGlassSession[]
  chartRoiRequests                       ChartRoiRequest[]
  claimAcknowledgments                   ClaimAcknowledgment[]
  claimAcknowledgmentDeadLetters         ClaimAcknowledgmentDeadLetter[]
  claimControlCounters                   ClaimControlCounter[]
  claimOperationalEvents                 ClaimOperationalEvent[]
  claimSubmissions                       ClaimSubmission[]
  claimSubmissionBatches                 ClaimSubmissionBatch[]
  departments                            Department[]
  diagnoses                              Diagnosis[]
  diseaseCaseReports                     DiseaseCaseReport[]
  encounters                             Encounter[]
  encounterChartExports                  EncounterChartExport[]
  clinicalDocumentationEntries           EncounterClinicalDocumentationEntry[]
  encounterClinicalEvents                EncounterClinicalEvent[]
  encounterIntakes                       EncounterIntake[]
  encounterNotes                         EncounterNote[]
  encounterProviderAddenda               EncounterProviderAddendum[]
  facilityFormularyItems                 FacilityFormularyItem[]
  facilityMedicationUsages               FacilityMedicationUsage[]
  followUps                              FollowUp[]
  infusionSessions                       InfusionSession[]
  inventoryItems                         InventoryItem[]
  inventoryTransactions                  InventoryTransaction[]
  medicationAdministrations              MedicationAdministration[]
  medicationAdministrationCorrections    MedicationAdministrationCorrection[]
  medicationAdministrationOverrides      MedicationAdministrationOverride[]
  medicationAdministrationVerifications  MedicationAdministrationVerification[]
  medicationDispenses                    MedicationDispense[]
  medicationFormularyImportStaging       MedicationFormularyImportStaging[]
  medicationWasteDocumentations          MedicationWasteDocumentation[]
  orders                                 Order[]
  orderEvents                            OrderEvent[]
  pathwaySessions                        PathwaySession[]
  patients                               Patient[]                              @relation("PatientFacility")
  patientsRegistered                     Patient[]                              @relation("RegisteredAtFacility")
  patientInsuranceCoverages              PatientInsuranceCoverage[]
  pharmacyVerifications                  PharmacyVerification[]
  protocolOrderSets                      ProtocolOrderSet[]
  results                                Result[]
  triages                                Triage[]
  triageVitalsReadings                   TriageVitalsReading[]
  userRoles                              UserRole[]
  vaccineAdministrations                 VaccineAdministration[]
}

/// Catalogue payeur (installation) — recherche par nom normalisé.
model InsurancePayer {
  id             String                     @id @default(uuid())
  name           String
  normalizedName String
  /// Stable catalog key for idempotent seed (e.g. US_CAT_AETNA). Optional for legacy / manual rows.
  code           String?                    @unique
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  coverages      PatientInsuranceCoverage[]

  @@index([normalizedName])
}

/// Couverture par patient et établissement — V2+ peut étendre sans casser Phase 2.
model PatientInsuranceCoverage {
  id                   String                @id @default(uuid())
  patientId            String
  facilityId           String
  rank                 InsuranceCoverageRank
  payerId              String?
  payerNameFreeText    String?
  planName             String?
  memberId             String?
  groupNumber          String?
  subscriberName       String?
  relationToSubscriber String?
  phone                String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  policyNumber         String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  isActive             Boolean               @default(true)
  facility             Facility              @relation(fields: [facilityId], references: [id])
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payer                InsurancePayer?       @relation(fields: [payerId], references: [id])

  @@unique([patientId, facilityId, rank])
  @@index([patientId])
  @@index([facilityId])
}

model Department {
  id         String         @id @default(uuid())
  facilityId String
  code       DepartmentCode
  name       String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  facility   Facility       @relation(fields: [facilityId], references: [id])
  userRoles  UserRole[]

  @@unique([facilityId, code])
}

model Role {
  id        String     @id @default(uuid())
  code      RoleCode   @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userRoles UserRole[]
}

model User {
  id                                              String                                 @id @default(uuid())
  email                                           String                                 @unique
  firstName                                       String
  lastName                                        String
  passwordHash                                    String
  refreshTokenHash                                String?
  isActive                                        Boolean                                @default(true)
  createdAt                                       DateTime                               @default(now())
  updatedAt                                       DateTime                               @updatedAt
  /// Plateforme : réservé au compte principal unique (`atranchant@medora.local`); tenir aligné avec les migrations (index unique partiel).
  canCreateFacilities                             Boolean                                @default(false)
  /// Phase 7 — 10-digit NPI for professional claim rendering (optional).
  billingNpi                                      String?
  billingTaxonomyCode                             String?
  billingNameOverride                             String?
  /// Phase 9 — TOTP-based MFA (RFC 6238). All fields additive; defaults preserve pre-MFA behavior.
  mfaEnabled                                      Boolean                                @default(false)
  /// AES-256-GCM ciphertext of the base32 TOTP secret. Format: `v1:<b64Iv>:<b64Ct>:<b64Tag>`. Pending enrollment also lives here while mfaEnabled=false.
  mfaSecretEncrypted                              String?
  mfaEnabledAt                                    DateTime?
  /// JSON array `[{ hash, usedAt }]`. Argon2id hash; single-use; cleared on disable / regenerate / admin reset.
  mfaRecoveryCodesHash                            Json?
  mfaLastVerifiedAt                               DateTime?
  /// RFC 6238 step counter (epoch / 30s) of last accepted code, used to reject replay within the same step window.
  mfaLastUsedStep                                 BigInt?
  auditLogs                                       AuditLog[]
  authSessions                                    AuthSession[]
  billingReviewDecisionsReviewed                  BillingReviewDecision[]                @relation("BillingReviewDecisionReviewer")
  breakGlassSessions                              BreakGlassSession[]
  chartRoiRequestsApproved                        ChartRoiRequest[]                      @relation("ChartRoiApprovedBy")
  chartRoiRequestsFulfilled                       ChartRoiRequest[]                      @relation("ChartRoiFulfilledBy")
  chartRoiRequestsRequested                       ChartRoiRequest[]                      @relation("ChartRoiRequestedBy")
  diseaseCaseReports                              DiseaseCaseReport[]
  encountersBillingClassificationAckBy            Encounter[]                            @relation("EncounterBillingClassificationAckBy")
  encountersBillingClassificationChangedBy        Encounter[]                            @relation("EncounterBillingClassificationChangedBy")
  encountersBillingFinalizedBy                    Encounter[]                            @relation("EncounterBillingFinalizedBy")
  encountersBillingReopenedBy                     Encounter[]                            @relation("EncounterBillingReopenedBy")
  encountersAsAssignedNurse                       Encounter[]                            @relation("EncounterNurseAssigned")
  encountersAsAssignedPhysician                   Encounter[]                            @relation("EncounterPhysicianAssigned")
  encountersSignedByProvider                      Encounter[]                            @relation("EncounterSignedBy")
  encounterChartExportsExported                   EncounterChartExport[]                 @relation("EncounterChartExportExportedBy")
  clinicalDocumentationEntriesAuthored            EncounterClinicalDocumentationEntry[]  @relation("ClinicalDocumentationEntryAuthor")
  clinicalDocumentationEntriesVoided              EncounterClinicalDocumentationEntry[]  @relation("ClinicalDocumentationEntryVoidedBy")
  clinicalDocumentationEntriesWitnessed           EncounterClinicalDocumentationEntry[]  @relation("ClinicalDocumentationEntryWitnessedBy")
  encounterClinicalEventsCreated                  EncounterClinicalEvent[]               @relation("EncounterClinicalEventCreatedBy")
  encounterNotesAuthored                          EncounterNote[]                        @relation("EncounterNoteAuthor")
  encounterNotesCosigned                          EncounterNote[]                        @relation("EncounterNoteCosignedBy")
  encounterNotesVoided                            EncounterNote[]                        @relation("EncounterNoteVoidedBy")
  providerAddendaCreated                          EncounterProviderAddendum[]
  followUpsCreated                                FollowUp[]
  inventoryTransactions                           InventoryTransaction[]
  medicationAdministrations                       MedicationAdministration[]
  medicationAdministrationCorrections             MedicationAdministrationCorrection[]   @relation("MedicationAdministrationCorrectionBy")
  medicationAdministrationOverridesAsActor        MedicationAdministrationOverride[]     @relation("MedicationAdministrationOverrideActor")
  medicationAdministrationVerificationsAsVerifier MedicationAdministrationVerification[] @relation("MedicationAdministrationVerificationVerifier")
  medicationAdministrationVerificationsAsWitness  MedicationAdministrationVerification[] @relation("MedicationAdministrationVerificationWitness")
  medicationDispenses                             MedicationDispense[]
  medicationFormularyImportStagingImported        MedicationFormularyImportStaging[]     @relation("MedicationFormularyImportStagingImportedBy")
  medicationProductsActivationApproved            MedicationProduct[]                    @relation("MedicationProductActivationApprovedBy")
  medicationWasteDocumentationsDocumented         MedicationWasteDocumentation[]         @relation("MedicationWasteDocumentedBy")
  medicationWasteDocumentationsWitnessed          MedicationWasteDocumentation[]         @relation("MedicationWasteWitness")
  msppAlertInvestigationsAssigned                 MsppAlertInvestigation[]               @relation("MsppAlertInvestigationAssignedTo")
  msppAlertInvestigationsOpened                   MsppAlertInvestigation[]               @relation("MsppAlertInvestigationOpenedBy")
  msppAlertInvestigationEventsCreated             MsppAlertInvestigationEvent[]          @relation("MsppAlertInvestigationEventCreatedBy")
  msppAlertTriagesAcknowledged                    MsppAlertTriage[]                      @relation("MsppAlertTriageAckBy")
  msppAlertTriagesAssigned                        MsppAlertTriage[]                      @relation("MsppAlertTriageAssignTo")
  msppDiseaseReportFeedbacksCreated               MsppDiseaseReportFeedback[]            @relation("MsppDiseaseReportFeedbackCreatedBy")
  msppDiseaseReportFeedbacksFacilityReviewed      MsppDiseaseReportFeedback[]            @relation("MsppDiseaseReportFeedbackFacilityReviewedBy")
  msppDiseaseReportFeedbacksResolved              MsppDiseaseReportFeedback[]            @relation("MsppDiseaseReportFeedbackResolvedBy")
  msppReviewAuditEvents                           MsppReviewAuditEvent[]
  msppUserRoleAssignments                         MsppUserRoleAssignment[]
  ordersCancelled                                 Order[]                                @relation("OrderCancelledBy")
  performedOrderEvents                            OrderEvent[]
  orderItemsCompletedNurse                        OrderItem[]                            @relation("OrderItemNurseCompleted")
  passwordResetTokens                             PasswordResetToken[]
  pharmacyVerificationsAsPharmacist               PharmacyVerification[]                 @relation("PharmacyVerificationPharmacist")
  platformAnnouncementsCreated                    PlatformAnnouncement[]                 @relation("PlatformAnnouncementCreatedBy")
  platformAnnouncementAcknowledgements            PlatformAnnouncementAcknowledgement[]
  userRoles                                       UserRole[]
  vaccineAdministrations                          VaccineAdministration[]
}

/// Session de rafraîchissement par appareil / navigateur (jeton avec revendication `sid` dans le JWT refresh).
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  userAgent        String?
  ipAddress        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Facility-scoped role assignment (user + Role row + facility). Same idea as a dedicated `FacilityUserRole` model.
model UserRole {
  id           String      @id @default(uuid())
  userId       String
  roleId       String
  facilityId   String
  departmentId String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facility     Facility    @relation(fields: [facilityId], references: [id])
  role         Role        @relation(fields: [roleId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@unique([userId, roleId, facilityId])
  @@index([userId])
  @@index([facilityId])
  @@index([facilityId, roleId])
  @@index([departmentId])
}

/// Demographics: date of birth is `dob` only (age is always derived). `sex` is canonical; `sexAtBirth` kept for legacy/API parity.
model Patient {
  id                           String                                @id @default(uuid())
  globalMrn                    String                                @unique
  firstName                    String
  lastName                     String
  dob                          DateTime?
  phone                        String?
  sexAtBirth                   SexAtBirth?
  nationalId                   String?
  registeredAtFacilityId       String
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  address                      String?
  city                         String?
  country                      String?
  email                        String?
  facilityId                   String
  language                     String?
  mrn                          String?
  latestVitalsAt               DateTime?
  /// Denormalized latest vitals JSON for chart header / offline read models; updated when triage or encounter vitals are saved.
  latestVitalsJson             Json?
  sex                          PatientSex                            @default(UNKNOWN)
  middleName                   String?
  addressLine1                 String?
  addressLine2                 String?
  stateProvince                String?
  postalCode                   String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  adminNotes                   String?
  /// Phase 19T.3 — canonical longitudinal clinical history (allergies, home meds, PMH/PSH, social).
  clinicalHistoryProfileJson   Json?
  auditLogs                    AuditLog[]
  billingEvents                BillingEvent[]
  billingReviewDecisions       BillingReviewDecision[]
  breakGlassSessions           BreakGlassSession[]
  chartRoiRequests             ChartRoiRequest[]
  diagnoses                    Diagnosis[]
  diseaseCaseReports           DiseaseCaseReport[]
  encounters                   Encounter[]
  encounterChartExports        EncounterChartExport[]
  clinicalDocumentationEntries EncounterClinicalDocumentationEntry[]
  encounterClinicalEvents      EncounterClinicalEvent[]
  encounterNotes               EncounterNote[]
  followUps                    FollowUp[]
  medicationAdministrations    MedicationAdministration[]
  medicationDispenses          MedicationDispense[]
  orders                       Order[]
  facility                     Facility                              @relation("PatientFacility", fields: [facilityId], references: [id])
  registeredAtFacility         Facility                              @relation("RegisteredAtFacility", fields: [registeredAtFacilityId], references: [id])
  insuranceCoverages           PatientInsuranceCoverage[]
  triageVitalsReadings         TriageVitalsReading[]
  vaccineAdministrations       VaccineAdministration[]

  @@unique([facilityId, mrn])
  @@index([facilityId])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([mrn])
}

model AuditLog {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  userId      String?
  facilityId  String?
  patientId   String?
  ip          String?
  userAgent   String?
  entityType  String
  entityId    String?
  action      AuditAction
  metadata    Json?
  encounterId String?
  orderId     String?
  encounter   Encounter?  @relation("EncounterAuditLogs", fields: [encounterId], references: [id])
  facility    Facility?   @relation(fields: [facilityId], references: [id])
  order       Order?      @relation("OrderAuditLogs", fields: [orderId], references: [id])
  patient     Patient?    @relation(fields: [patientId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([facilityId])
  @@index([createdAt])
  @@index([encounterId])
}

/// Phase 5F — immutable encounter chart export snapshot.
///
/// Persists the JSON manifest exactly as composed at export time, plus a
/// SHA-256 hash of its canonical (sorted-key) form. HTML rendering is
/// regenerated from the stored manifest on retrieval; rendered HTML itself
/// is not stored (template version evolves independently from content).
///
/// Created only for CLOSED encounters (livePreview = false). The live
/// preview / chart-export endpoint continues to support OPEN encounters
/// without persistence.
///
/// Foreign keys use `Restrict` on facility / encounter / patient so a
/// snapshot cannot be silently invalidated by an upstream delete; the
/// exporting user is `SetNull` to keep snapshots if a user account is
/// later deactivated/removed.
model EncounterChartExport {
  id                String            @id @default(uuid())
  facilityId        String
  encounterId       String
  patientId         String
  exportedByUserId  String?
  manifestVersion   String
  manifestHash      String
  manifestJson      Json
  /// "json" | "html" — format requested at creation time (informational; HTML is rendered server-side from the stored manifest).
  renderedFormat    String
  /// Optional template/render version (decoupled from manifestVersion). Lets HTML rendering evolve without invalidating prior snapshots.
  templateVersion   String?
  livePreview       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  /// Phase 6 — server-issued HMAC-SHA256 signature over the manifestHash, formatted as "<sigVersion>:<hex>". Nullable to support legacy snapshots created before signing was introduced; new snapshots require it in production.
  manifestSignature String?
  chartRoiRequests  ChartRoiRequest[]
  encounter         Encounter         @relation(fields: [encounterId], references: [id])
  exportedByUser    User?             @relation("EncounterChartExportExportedBy", fields: [exportedByUserId], references: [id])
  facility          Facility          @relation(fields: [facilityId], references: [id])
  patient           Patient           @relation(fields: [patientId], references: [id])

  @@index([facilityId, encounterId, createdAt])
  @@index([patientId, createdAt])
  @@index([manifestHash])
}

/// Phase 5G — governed Release of Information (ROI) workflow for external record disclosure.
///
/// Facility-scoped. Only facility `ADMIN` users may mutate or view requests in the MVP API.
/// Immutable chart snapshots (`EncounterChartExport`) are linked on fulfillment after approval.
/// No outbound email / portal delivery in this phase — workflow + audit trail only.
model ChartRoiRequest {
  id                     String                  @id @default(uuid())
  facilityId             String
  patientId              String
  encounterId            String?
  requestedByUserId      String
  approvedByUserId       String?
  fulfilledByUserId      String?
  encounterChartExportId String?
  requestType            ChartRoiRequestType
  status                 ChartRoiRequestStatus   @default(DRAFT)
  recipientName          String?
  recipientOrganization  String?
  deliveryMethod         ChartRoiDeliveryMethod?
  /// Free-text purpose / scope (stored for legal traceability; never copied into audit metadata).
  purpose                String
  authorizationReference String?
  denialReason           String?
  cancelledReason        String?
  createdAt              DateTime                @default(now())
  approvedAt             DateTime?
  fulfilledAt            DateTime?
  cancelledAt            DateTime?
  deniedAt               DateTime?
  approvedBy             User?                   @relation("ChartRoiApprovedBy", fields: [approvedByUserId], references: [id])
  encounterChartExport   EncounterChartExport?   @relation(fields: [encounterChartExportId], references: [id])
  encounter              Encounter?              @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility               Facility                @relation(fields: [facilityId], references: [id])
  fulfilledBy            User?                   @relation("ChartRoiFulfilledBy", fields: [fulfilledByUserId], references: [id])
  patient                Patient                 @relation(fields: [patientId], references: [id])
  requestedBy            User                    @relation("ChartRoiRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([facilityId, status, createdAt])
  @@index([facilityId, patientId, createdAt])
  @@index([encounterId])
}

model Encounter {
  id                                        String                                 @id @default(uuid())
  patientId                                 String
  facilityId                                String
  type                                      EncounterType
  status                                    EncounterStatus                        @default(OPEN)
  providerId                                String?
  notes                                     String?
  createdAt                                 DateTime                               @default(now())
  updatedAt                                 DateTime                               @updatedAt
  chiefComplaint                            String?
  triageAcuity                              Int?
  vitals                                    Json?
  dischargeStatus                           DischargeStatus?
  dischargedAt                              DateTime?
  disposition                               String?
  nursingAssessment                         Json?
  providerNote                              String?
  /// Outpatient / clinic: structured treatment summary (distinct from free-text notes)
  treatmentPlan                             String?
  followUpDate                              DateTime?
  /// French-facing room label: "Salle d'attente" or "1"…"30"
  roomLabel                                 String?
  /// Assigned attending physician (display name only in UI; never use for nurse attribution)
  physicianAssignedUserId                   String?
  /// Structured discharge summary (French UI keys / values); saved before closing when using discharge flow
  dischargeSummaryJson                      Json?
  /// Synthèse structurée d'admission (hospitalisation depuis la consultation) — MVP, une décision par visite
  admissionSummaryJson                      Json?
  /// Horodatage de la décision d'admission (rempli côté serveur à la 1re sauvegarde du dossier d'admission)
  admittedAt                                DateTime?
  /// DRAFT | SIGNED — signature médicale sur l’évaluation (V1)
  providerDocumentationStatus               String                                 @default("DRAFT")
  providerDocumentationSignedAt             DateTime?
  providerDocumentationSignedByUserId       String?
  /// U.S. billing foundation — charge capture / billing event candidates (V1 shared schema)
  billingCaptureJson                        Json?
  /// Optimistic locking — increment on every successful mutating write.
  version                                   Int                                    @default(1)
  workflowState                             EncounterWorkflowState                 @default(ARRIVED)
  /// Phase 3 — billing finalization for claim assembly (no submission in this phase).
  billingFinalizationStatus                 EncounterBillingFinalizationStatus     @default(NOT_READY)
  billingFinalizedAt                        DateTime?
  billingFinalizedByUserId                  String?
  billingReopenedAt                         DateTime?
  billingReopenedByUserId                   String?
  /// Last computed readiness snapshot (blockers, warnings, counts) for audit / UI.
  billingReadinessSnapshotJson              Json?
  /// Phase 10A — RN currently responsible for the encounter (operational ownership only;
  /// never used for clinical authorship/signature/order authority).
  nurseAssignedUserId                       String?
  nurseAssignedAt                           DateTime?
  /// Phase 10A — timestamp of the most recent physician assignment (operational only).
  physicianAssignedAt                       DateTime?
  /// Phase 19UCED.1 — billing/regulatory classification (one chart; explicit changes only).
  billingClassification                     BillingClassification                  @default(URGENT_CARE)
  billingClassificationChangedAt            DateTime?
  billingClassificationChangedByUserId      String?
  billingClassificationChangeReason         String?
  billingClassificationAcknowledgedAt       DateTime?
  billingClassificationAcknowledgedByUserId String?
  billingClassificationAcknowledgmentMethod String?
  billingClassificationTransitionJson       Json?
  auditLogs                                 AuditLog[]                             @relation("EncounterAuditLogs")
  billingEvents                             BillingEvent[]
  billingReviewDecisions                    BillingReviewDecision[]
  breakGlassSessions                        BreakGlassSession[]
  chartRoiRequests                          ChartRoiRequest[]
  claimSubmissions                          ClaimSubmission[]
  diagnoses                                 Diagnosis[]
  diseaseCaseReports                        DiseaseCaseReport[]
  billingClassificationAcknowledgedBy       User?                                  @relation("EncounterBillingClassificationAckBy", fields: [billingClassificationAcknowledgedByUserId], references: [id])
  billingClassificationChangedBy            User?                                  @relation("EncounterBillingClassificationChangedBy", fields: [billingClassificationChangedByUserId], references: [id])
  billingFinalizedBy                        User?                                  @relation("EncounterBillingFinalizedBy", fields: [billingFinalizedByUserId], references: [id])
  billingReopenedBy                         User?                                  @relation("EncounterBillingReopenedBy", fields: [billingReopenedByUserId], references: [id])
  facility                                  Facility                               @relation(fields: [facilityId], references: [id])
  nurseAssigned                             User?                                  @relation("EncounterNurseAssigned", fields: [nurseAssignedUserId], references: [id])
  patient                                   Patient                                @relation(fields: [patientId], references: [id])
  physicianAssigned                         User?                                  @relation("EncounterPhysicianAssigned", fields: [physicianAssignedUserId], references: [id])
  providerDocumentationSignedBy             User?                                  @relation("EncounterSignedBy", fields: [providerDocumentationSignedByUserId], references: [id])
  chartExports                              EncounterChartExport[]
  clinicalDocumentationEntries              EncounterClinicalDocumentationEntry[]
  encounterClinicalEvents                   EncounterClinicalEvent[]
  intake                                    EncounterIntake?
  encounterNotes                            EncounterNote[]
  providerAddenda                           EncounterProviderAddendum[]
  followUps                                 FollowUp[]
  infusionSessions                          InfusionSession[]
  medicationAdministrations                 MedicationAdministration[]
  medicationAdministrationOverrides         MedicationAdministrationOverride[]
  medicationAdministrationVerifications     MedicationAdministrationVerification[]
  medicationDispenses                       MedicationDispense[]
  medicationWasteDocumentations             MedicationWasteDocumentation[]
  orders                                    Order[]
  orderEvents                               OrderEvent[]
  pathwaySession                            PathwaySession?
  pharmacyVerifications                     PharmacyVerification[]
  triage                                    Triage?
  triageVitalsReadings                      TriageVitalsReading[]
  vaccineAdministrations                    VaccineAdministration[]

  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([workflowState])
  @@index([physicianAssignedUserId])
  @@index([nurseAssignedUserId])
  @@index([providerDocumentationSignedByUserId])
  @@index([billingFinalizationStatus])
  @@index([billingClassification])
}

/// Optional mapping from clinical catalog / external codes to billable CPT/HCPCS (Phase 4.5 auto engine).
model BillingCatalog {
  id            String   @id @default(uuid())
  /// Billable code (CPT or HCPCS) to apply when matched.
  code          String
  /// "CPT" | "HCPCS"
  system        String
  description   String
  /// LAB | IMAGING | MEDICATION | PROCEDURE | SUPPLY
  triggerSource String
  /// LOINC, internal lab code, imaging study code, medication code, etc.
  externalCode  String?
  /// "professional" | "facility" | "both"
  billClass     String
  createdAt     DateTime @default(now())

  @@index([triggerSource])
  @@index([externalCode])
}

/// Relational billing event ledger — automatic capture from clinical actions (Phase 1).
model BillingEvent {
  id                     String                  @id @default(uuid())
  facilityId             String
  patientId              String
  encounterId            String
  /// Latest BillingCaptureItem.id when synced from JSON pipeline.
  captureItemId          String?
  sourceModule           BillingSourceModule
  /// Business key for idempotency (order item id, diagnosis id, administration id, etc.).
  sourceRecordId         String
  eventType              String                  @default("CHARGE_CAPTURE")
  serviceDate            DateTime?
  units                  Int?
  codeType               BillingCodeType?
  code                   String?
  procedureCode          String?
  hcpcsCode              String?
  diagnosisCodes         String?
  descriptionSnapshot    String?
  priceSnapshot          Decimal?                @db.Decimal(14, 2)
  modifier1              String?
  modifier2              String?
  revenueCode            String?
  billingSide            BillingSide             @default(UNKNOWN)
  reviewStatus           BillingReviewStatus     @default(CAPTURED)
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  encounter              Encounter               @relation(fields: [encounterId], references: [id])
  facility               Facility                @relation(fields: [facilityId], references: [id])
  patient                Patient                 @relation(fields: [patientId], references: [id])
  billingReviewDecisions BillingReviewDecision[]

  @@unique([facilityId, sourceModule, sourceRecordId])
  @@index([encounterId])
  @@index([facilityId, reviewStatus])
  @@index([patientId])
}

model BillingReviewDecision {
  id             String                      @id @default(uuid())
  facilityId     String
  encounterId    String
  patientId      String
  orderItemId    String
  billingEventId String?
  decision       BillingReviewDecisionStatus
  notes          String?
  reviewerId     String
  reviewedAt     DateTime
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  billingEvent   BillingEvent?               @relation(fields: [billingEventId], references: [id])
  encounter      Encounter                   @relation(fields: [encounterId], references: [id])
  facility       Facility                    @relation(fields: [facilityId], references: [id])
  orderItem      OrderItem                   @relation(fields: [orderItemId], references: [id])
  patient        Patient                     @relation(fields: [patientId], references: [id])
  reviewer       User                        @relation("BillingReviewDecisionReviewer", fields: [reviewerId], references: [id])

  @@unique([facilityId, orderItemId])
  @@index([facilityId, decision])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([reviewerId])
}

/// Métadonnées d’accueil / arrivée liées à une visite — ne remplace pas le motif clinique sur Encounter.
model EncounterIntake {
  id                    String    @id @default(uuid())
  encounterId           String    @unique
  facilityId            String
  arrivalAt             DateTime?
  modeOfArrival         String?
  initialChiefComplaint String?
  initialAcuity         Int?
  initialRoom           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  encounter             Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility              Facility  @relation(fields: [facilityId], references: [id])

  @@index([encounterId])
  @@index([facilityId])
}

/// Time-limited emergency chart access (break-glass) — scoped to one patient (and optionally one encounter) per session.
model BreakGlassSession {
  id          String     @id @default(uuid())
  userId      String
  facilityId  String
  patientId   String
  encounterId String?
  reason      String
  startedAt   DateTime   @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  facility    Facility   @relation(fields: [facilityId], references: [id])
  patient     Patient    @relation(fields: [patientId], references: [id])
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, facilityId, patientId])
  @@index([facilityId, patientId])
  @@index([expiresAt])
}

/// Append-only addendum after provider documentation is signed (V1 — no edit/delete).
model EncounterProviderAddendum {
  id              String    @id @default(uuid())
  encounterId     String
  facilityId      String
  text            String
  createdAt       DateTime  @default(now())
  createdByUserId String
  createdBy       User      @relation(fields: [createdByUserId], references: [id])
  encounter       Encounter @relation(fields: [encounterId], references: [id])
  facility        Facility  @relation(fields: [facilityId], references: [id])

  @@index([encounterId, createdAt])
  @@index([createdByUserId])
  @@index([facilityId])
}

model EncounterNote {
  id                        String                       @id @default(uuid())
  encounterId               String
  patientId                 String
  facilityId                String
  noteType                  EncounterNoteType
  body                      String
  authorUserId              String
  authorDisplayNameSnapshot String
  authorRoleSnapshot        String
  createdAt                 DateTime                     @default(now())
  voidedAt                  DateTime?
  voidedByUserId            String?
  voidReasonCode            EncounterNoteVoidReasonCode?
  isAmendment               Boolean                      @default(false)
  amendedFromNoteId         String?
  amendmentReason           String?
  requiresCosign            Boolean                      @default(false)
  cosignedAt                DateTime?
  cosignedByUserId          String?
  cosignRoleSnapshot        String?
  amendedFrom               EncounterNote?               @relation("EncounterNoteAmendment", fields: [amendedFromNoteId], references: [id], onDelete: Restrict)
  amendments                EncounterNote[]              @relation("EncounterNoteAmendment")
  author                    User                         @relation("EncounterNoteAuthor", fields: [authorUserId], references: [id])
  cosignedBy                User?                        @relation("EncounterNoteCosignedBy", fields: [cosignedByUserId], references: [id])
  encounter                 Encounter                    @relation(fields: [encounterId], references: [id])
  facility                  Facility                     @relation(fields: [facilityId], references: [id])
  patient                   Patient                      @relation(fields: [patientId], references: [id])
  voidedBy                  User?                        @relation("EncounterNoteVoidedBy", fields: [voidedByUserId], references: [id])

  @@index([encounterId, createdAt])
  @@index([facilityId])
  @@index([patientId])
  @@index([authorUserId])
  @@index([amendedFromNoteId])
}

/// EDOC.2 — append-only structured clinical documentation entries (legal chart).
model EncounterClinicalDocumentationEntry {
  id                         String    @id @default(uuid())
  facilityId                 String
  encounterId                String
  patientId                  String
  category                   String
  cardId                     String
  payloadJson                Json
  authorUserId               String
  authorDisplayNameSnapshot  String
  authorRoleSnapshot         String
  createdAt                  DateTime  @default(now())
  voidedAt                   DateTime?
  voidedByUserId             String?
  /// EDOC.4 — frozen at create from facility + card policy.
  requiresWitnessSignature   Boolean   @default(false)
  witnessedAt                DateTime?
  witnessedByUserId          String?
  witnessDisplayNameSnapshot String?
  witnessRoleSnapshot        String?
  author                     User      @relation("ClinicalDocumentationEntryAuthor", fields: [authorUserId], references: [id])
  encounter                  Encounter @relation(fields: [encounterId], references: [id])
  facility                   Facility  @relation(fields: [facilityId], references: [id])
  patient                    Patient   @relation(fields: [patientId], references: [id])
  voidedBy                   User?     @relation("ClinicalDocumentationEntryVoidedBy", fields: [voidedByUserId], references: [id])
  witnessedBy                User?     @relation("ClinicalDocumentationEntryWitnessedBy", fields: [witnessedByUserId], references: [id])

  @@index([encounterId, createdAt])
  @@index([facilityId])
  @@index([patientId])
  @@index([cardId])
  @@index([authorUserId])
  @@index([witnessedByUserId])
}

model Order {
  id                 String          @id @default(uuid())
  encounterId        String
  facilityId         String
  type               String
  status             OrderStatus     @default(PENDING)
  priority           OrderPriority   @default(ROUTINE)
  notes              String?
  orderedBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  patientId          String
  pathwaySessionId   String?
  source             String?
  prescriberContact  String?
  prescriberLicense  String?
  prescriberName     String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?
  auditLogs          AuditLog[]      @relation("OrderAuditLogs")
  cancelledBy        User?           @relation("OrderCancelledBy", fields: [cancelledByUserId], references: [id])
  encounter          Encounter       @relation(fields: [encounterId], references: [id])
  facility           Facility        @relation(fields: [facilityId], references: [id])
  pathwaySession     PathwaySession? @relation(fields: [pathwaySessionId], references: [id])
  patient            Patient         @relation(fields: [patientId], references: [id])
  orderEvents        OrderEvent[]
  items              OrderItem[]

  @@index([encounterId])
  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([pathwaySessionId])
  @@index([cancelledByUserId])
}

model OrderItem {
  id                                    String                                 @id @default(uuid())
  orderId                               String
  /// Référence catalogue (nullable si saisie manuelle — `manualLabel` requis dans ce cas).
  catalogItemId                         String?
  catalogItemType                       String
  quantity                              Int?
  notes                                 String?
  createdAt                             DateTime                               @default(now())
  status                                OrderStatus                            @default(PENDING)
  updatedAt                             DateTime                               @updatedAt
  refillCount                           Int?
  strength                              String?
  medicationFulfillmentIntent           MedicationFulfillmentIntent?
  completedAt                           DateTime?
  completedByUserId                     String?
  /// Libellé saisi à la main lorsque l’article n’existe pas au catalogue (analyse, examen, médicament).
  manualLabel                           String?
  /// Précision (ex. région imagerie) ou texte secondaire d’affichage.
  manualSecondaryText                   String?
  /// Administration prévue (information clinique, pas planification récurrente).
  intendedAdministrationAt              DateTime?
  /// Explicit visit lifecycle — kept in sync with `status` in application code; `REVIEWED` = chart/review closure.
  lifecycleState                        OrderItemLifecycleState                @default(ORDERED)
  route                                 String?
  /// System time when the line was first marked complete (immutable after set).
  documentedCompletedAt                 DateTime?
  /// User-entered when care/procedure was actually performed (CARE lines only).
  effectiveClinicalAt                   DateTime?
  effectiveClinicalAtSetAt              DateTime?
  effectiveClinicalAtSetByUserId        String?
  effectiveClinicalAtReason             String?
  /// Incremented on each effective-time correction (audit / reason rules).
  effectiveClinicalAtVersion            Int                                    @default(0)
  /// Lab: specimen collected (system time at START; clinical correction via effectiveCollectedAt).
  documentedCollectedAt                 DateTime?
  effectiveCollectedAt                  DateTime?
  effectiveCollectedAtSetAt             DateTime?
  effectiveCollectedAtSetByUserId       String?
  effectiveCollectedAtReason            String?
  effectiveCollectedAtVersion           Int                                    @default(0)
  /// Lab: specimen received at department (system time at ACK).
  documentedReceivedAt                  DateTime?
  effectiveReceivedAt                   DateTime?
  effectiveReceivedAtSetAt              DateTime?
  effectiveReceivedAtSetByUserId        String?
  effectiveReceivedAtReason             String?
  effectiveReceivedAtVersion            Int                                    @default(0)
  /// Imaging: exam performed (system time at START).
  documentedPerformedAt                 DateTime?
  effectivePerformedAt                  DateTime?
  effectivePerformedAtSetAt             DateTime?
  effectivePerformedAtSetByUserId       String?
  effectivePerformedAtReason            String?
  effectivePerformedAtVersion           Int                                    @default(0)
  /// Phase 19B.1 — future dual-write to canonical package (nullable; not populated in this phase).
  medicationPackageId                   String?
  /// Phase 19B.1 — future dual-write to canonical product (nullable; not populated in this phase).
  medicationProductId                   String?
  /// Canonical enterprise procedure catalog id (MEDPROC.2) — stable identity for CARE lines; manualLabel is display snapshot.
  enterpriseProcedureId                 String?
  billingReviewDecisions                BillingReviewDecision[]
  infusionSessions                      InfusionSession[]
  medicationAdministrations             MedicationAdministration[]
  medicationAdministrationOverrides     MedicationAdministrationOverride[]
  medicationAdministrationVerifications MedicationAdministrationVerification[]
  pharmacyDispenseRecord                MedicationDispense?
  medicationWasteDocumentations         MedicationWasteDocumentation[]
  completedByNurse                      User?                                  @relation("OrderItemNurseCompleted", fields: [completedByUserId], references: [id])
  medicationPackage                     MedicationPackage?                     @relation(fields: [medicationPackageId], references: [id])
  medicationProduct                     MedicationProduct?                     @relation(fields: [medicationProductId], references: [id])
  order                                 Order                                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacyVerifications                 PharmacyVerification[]
  result                                Result?

  @@index([orderId])
  @@index([status])
  @@index([lifecycleState])
  @@index([catalogItemType])
  @@index([catalogItemId])
  @@index([completedByUserId])
  @@index([medicationFulfillmentIntent])
  @@index([medicationProductId])
  @@index([medicationPackageId])
  @@index([enterpriseProcedureId])
}

/// ER-ORDER-LIFECYCLE: immutable audit events for all order domains.
model OrderEvent {
  id                String              @id @default(cuid())
  facilityId        String
  encounterId       String
  orderId           String
  orderType         OrderEventOrderType
  eventType         OrderEventType
  performedByUserId String
  performedAt       DateTime            @default(now())
  roleSnapshot      String
  note              String?
  metadata          Json?
  createdAt         DateTime            @default(now())
  encounter         Encounter           @relation(fields: [encounterId], references: [id])
  facility          Facility            @relation(fields: [facilityId], references: [id])
  order             Order               @relation(fields: [orderId], references: [id])
  performedBy       User                @relation(fields: [performedByUserId], references: [id])

  @@index([encounterId])
  @@index([orderId])
  @@index([performedAt])
  @@index([facilityId, encounterId, performedAt])
}

/// Append-only encounter-level clinical events (vitals saves, documentation, signatures, handoffs).
/// Application rule: INSERT only — never UPDATE or DELETE.
model EncounterClinicalEvent {
  id              String                     @id @default(uuid())
  facilityId      String
  encounterId     String
  patientId       String
  eventType       EncounterClinicalEventType
  payloadJson     Json
  createdByUserId String
  createdAt       DateTime                   @default(now())
  createdBy       User                       @relation("EncounterClinicalEventCreatedBy", fields: [createdByUserId], references: [id])
  encounter       Encounter                  @relation(fields: [encounterId], references: [id])
  facility        Facility                   @relation(fields: [facilityId], references: [id])
  patient         Patient                    @relation(fields: [patientId], references: [id])

  @@index([facilityId, encounterId, createdAt])
  @@index([encounterId, createdAt])
  @@index([patientId, createdAt])
  @@index([createdByUserId])
}

model Triage {
  id                   String                @id @default(uuid())
  encounterId          String                @unique
  facilityId           String
  chiefComplaint       String?
  onsetAt              DateTime?
  esi                  Int?
  vitalsJson           Json?
  strokeScreen         Json?
  sepsisScreen         Json?
  triageCompleteAt     DateTime?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  encounter            Encounter             @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility             Facility              @relation(fields: [facilityId], references: [id])
  triageVitalsReadings TriageVitalsReading[]

  @@index([facilityId])
  @@index([encounterId])
}

/// Append-only vitals readings per triage save (Signes vitaux); `Triage.vitalsJson` remains current row.
model TriageVitalsReading {
  id               String    @id @default(uuid())
  facilityId       String
  patientId        String
  encounterId      String
  triageId         String
  vitalsJson       Json
  triageCompleteAt DateTime?
  recordedAt       DateTime  @default(now())
  encounter        Encounter @relation(fields: [encounterId], references: [id])
  facility         Facility  @relation(fields: [facilityId], references: [id])
  patient          Patient   @relation(fields: [patientId], references: [id])
  triage           Triage    @relation(fields: [triageId], references: [id])

  @@index([facilityId])
  @@index([patientId, recordedAt])
  @@index([encounterId])
  @@index([triageId])
}

model Result {
  id                              String    @id @default(uuid())
  orderItemId                     String    @unique
  facilityId                      String
  resultData                      Json?
  resultText                      String?
  criticalValue                   Boolean   @default(false)
  /// Department user who last saved substantive result text/attachments (lab/radiology); not physician sign-off.
  verifiedByUserId                String?
  verifiedAt                      DateTime?
  acknowledgedByProviderAt        DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  /// Receiving clinician who acknowledged the result in-chart (distinct from `verifiedByUserId`).
  acknowledgedByUserId            String?
  /// Lab: clinical result time (documented entry time remains `verifiedAt`).
  effectiveResultedAt             DateTime?
  effectiveResultedAtSetAt        DateTime?
  effectiveResultedAtSetByUserId  String?
  effectiveResultedAtReason       String?
  effectiveResultedAtVersion      Int       @default(0)
  /// Imaging: clinical finalized/report time (documented entry remains `verifiedAt`).
  effectiveFinalizedAt            DateTime?
  effectiveFinalizedAtSetAt       DateTime?
  effectiveFinalizedAtSetByUserId String?
  effectiveFinalizedAtReason      String?
  effectiveFinalizedAtVersion     Int       @default(0)
  facility                        Facility  @relation(fields: [facilityId], references: [id])
  orderItem                       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([orderItemId])
  @@index([criticalValue])
  @@index([acknowledgedByUserId])
}

/// Phase 2B.2 — Medora Reference Vocabulary classifier (canonical terminology; labels in `TermClassifierLabel`).
model TermClassifier {
  id                       String                           @id @default(uuid())
  domain                   String                           @db.VarChar(32)
  code                     String                           @db.VarChar(64)
  isActive                 Boolean                          @default(true)
  retiredAt                DateTime?
  successorClassifierId    String?
  sortPriority             Int                              @default(0)
  searchText               String?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  backfillAudits           CatalogClassifierBackfillAudit[]
  imagingAnatomicSubregion CatalogImagingStudy[]            @relation("ImagingAnatomicSubregionClassifier")
  imagingBodyRegion        CatalogImagingStudy[]            @relation("ImagingBodyRegionClassifier")
  imagingContrastType      CatalogImagingStudy[]            @relation("ImagingContrastTypeClassifier")
  imagingLaterality        CatalogImagingStudy[]            @relation("ImagingLateralityClassifier")
  imagingModality          CatalogImagingStudy[]            @relation("ImagingModalityClassifier")
  imagingProtocol          CatalogImagingStudy[]            @relation("ImagingProtocolClassifier")
  imagingViewCount         CatalogImagingStudy[]            @relation("ImagingViewCountClassifier")
  labCategory              CatalogLabTest[]                 @relation("LabCategoryClassifier")
  TermClassifier           TermClassifier?                  @relation("TermClassifierToTermClassifier", fields: [successorClassifierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_TermClassifier     TermClassifier[]                 @relation("TermClassifierToTermClassifier")
  aliases                  TermClassifierAlias[]
  labels                   TermClassifierLabel[]

  @@unique([domain, code])
  @@index([domain])
  @@index([domain, isActive])
  @@index([successorClassifierId])
}

model TermClassifierLabel {
  id           String         @id @default(uuid())
  classifierId String
  locale       String         @db.VarChar(8)
  displayName  String
  definition   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  classifier   TermClassifier @relation(fields: [classifierId], references: [id], onUpdate: NoAction)

  @@unique([classifierId, locale])
  @@index([classifierId])
}

model TermClassifierAlias {
  id           String         @id @default(uuid())
  classifierId String
  alias        String
  language     String?        @db.VarChar(8)
  createdAt    DateTime       @default(now())
  classifier   TermClassifier @relation(fields: [classifierId], references: [id], onUpdate: NoAction)

  @@unique([classifierId, alias])
  @@index([classifierId])
  @@index([alias])
}

/// Phase 2B.2 — audit trail for catalog classifier backfill runs.
model CatalogClassifierBackfillAudit {
  id           String          @id @default(uuid())
  runId        String          @db.VarChar(64)
  catalogTable String          @db.VarChar(64)
  catalogRowId String
  catalogCode  String?         @db.VarChar(64)
  fieldName    String          @db.VarChar(64)
  legacyValue  String?
  classifierId String?
  status       String          @db.VarChar(32)
  message      String?
  createdAt    DateTime        @default(now())
  classifier   TermClassifier? @relation(fields: [classifierId], references: [id], onUpdate: NoAction)

  @@index([runId])
  @@index([catalogTable, catalogRowId])
  @@index([status])
}

/// Shared catalog row: stable `code`, human-readable labels, `searchText` for unified search, `updatedAt` for sync.
model CatalogLabTest {
  id                      String          @id @default(uuid())
  code                    String          @unique
  /// Legacy internal / compat field; historically French-first for Haiti seeds. Do not use as English UI — use `displayNameEn`.
  name                    String
  description             String?
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  /// French display label; must not be overwritten by English backfill workflows.
  displayNameFr           String?
  isEssential             Boolean         @default(false)
  searchText              String?
  sortPriority            Int             @default(0)
  /// Optional U.S. CPT/HCPCS-style code suggestion for billing; not validated or auto-applied.
  billingCodeDefault      String?
  /// English-primary display label for catalog search, orders, MAR, and billing-enrichment line text.
  displayNameEn           String?
  labCategoryClassifierId String?
  labCategoryClassifier   TermClassifier? @relation("LabCategoryClassifier", fields: [labCategoryClassifierId], references: [id], onUpdate: NoAction)
  aliases                 LabTestAlias[]

  @@index([labCategoryClassifierId])
}

model LabTestAlias {
  id               String         @id @default(uuid())
  catalogLabTestId String
  alias            String
  language         String?
  createdAt        DateTime       @default(now())
  catalogLabTest   CatalogLabTest @relation(fields: [catalogLabTestId], references: [id], onDelete: Cascade)

  @@unique([catalogLabTestId, alias])
  @@index([catalogLabTestId])
  @@index([alias])
}

/// Shared catalog row: stable `code`, human-readable labels, `searchText` for unified search, `updatedAt` for sync.
model CatalogImagingStudy {
  id                            String              @id @default(uuid())
  code                          String              @unique
  /// Legacy internal / compat field; French-first for Haiti seeds. Do not use as English UI — use `displayNameEn`.
  name                          String
  description                   String?
  isActive                      Boolean             @default(true)
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  bodyRegion                    String?
  /// French display label; must not be overwritten by English backfill workflows.
  displayNameFr                 String?
  isEssential                   Boolean             @default(false)
  modality                      String?
  searchText                    String?
  sortPriority                  Int                 @default(0)
  /// Optional U.S. CPT/HCPCS-style code suggestion for billing; not validated or auto-applied.
  billingCodeDefault            String?
  /// English-primary display label for catalog search, orders, and billing-enrichment line text.
  displayNameEn                 String?
  bodyRegionClassifierId        String?
  modalityClassifierId          String?
  contrastTypeClassifierId      String?
  viewCountClassifierId         String?
  lateralityClassifierId        String?
  anatomicSubregionClassifierId String?
  protocolClassifierId          String?
  anatomicSubregionClassifier   TermClassifier?     @relation("ImagingAnatomicSubregionClassifier", fields: [anatomicSubregionClassifierId], references: [id], onUpdate: NoAction)
  bodyRegionClassifier          TermClassifier?     @relation("ImagingBodyRegionClassifier", fields: [bodyRegionClassifierId], references: [id], onUpdate: NoAction)
  contrastTypeClassifier        TermClassifier?     @relation("ImagingContrastTypeClassifier", fields: [contrastTypeClassifierId], references: [id], onUpdate: NoAction)
  lateralityClassifier          TermClassifier?     @relation("ImagingLateralityClassifier", fields: [lateralityClassifierId], references: [id], onUpdate: NoAction)
  modalityClassifier            TermClassifier?     @relation("ImagingModalityClassifier", fields: [modalityClassifierId], references: [id], onUpdate: NoAction)
  protocolClassifier            TermClassifier?     @relation("ImagingProtocolClassifier", fields: [protocolClassifierId], references: [id], onUpdate: NoAction)
  viewCountClassifier           TermClassifier?     @relation("ImagingViewCountClassifier", fields: [viewCountClassifierId], references: [id], onUpdate: NoAction)
  aliases                       ImagingStudyAlias[]

  @@index([bodyRegionClassifierId])
  @@index([modalityClassifierId])
  @@index([contrastTypeClassifierId])
  @@index([viewCountClassifierId])
  @@index([lateralityClassifierId])
  @@index([anatomicSubregionClassifierId])
  @@index([protocolClassifierId])
}

model ImagingStudyAlias {
  id                    String              @id @default(uuid())
  catalogImagingStudyId String
  alias                 String
  language              String?
  createdAt             DateTime            @default(now())
  catalogImagingStudy   CatalogImagingStudy @relation(fields: [catalogImagingStudyId], references: [id], onDelete: Cascade)

  @@unique([catalogImagingStudyId, alias])
  @@index([catalogImagingStudyId])
  @@index([alias])
}

/// Shared catalog row: stable `code`, human-readable labels, `searchText` for unified search, `updatedAt` for sync.
model CatalogMedication {
  id                                    String                                 @id @default(uuid())
  code                                  String                                 @unique
  /// Legacy internal / compat (often mirrors `displayNameFr`). Do not use as English UI — use `displayNameEn`.
  name                                  String
  description                           String?
  isActive                              Boolean                                @default(true)
  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
  /// French display label; must not be overwritten by English backfill workflows.
  displayNameFr                         String?
  dosageForm                            String?
  genericName                           String?
  isEssential                           Boolean                                @default(false)
  route                                 String?
  searchText                            String?
  sortPriority                          Int                                    @default(0)
  strength                              String?
  therapeuticClass                      String?
  /// Optional HCPCS/J-code-style suggestion for billing; not validated or auto-applied.
  billingCodeDefault                    String?
  /// ER-3: normalized National Drug Code (11 digits). Optional until local catalog quality is complete.
  ndc11                                 String?                                @db.VarChar(11)
  /// ER-3: display NDC as entered/imported (e.g. 12345-6789-01) for UI readability.
  ndcDisplay                            String?                                @db.VarChar(32)
  /// ER-3: preferred quantity basis for billing math (e.g. mg, mL, each, unit).
  billingUnitType                       String?                                @db.VarChar(32)
  /// English-primary display label for pharmacy, search, orders, and MAR surfaces.
  displayNameEn                         String?
  isControlled                          Boolean                                @default(false)
  controlledSchedule                    String?
  requiresWitness                       Boolean                                @default(false)
  requiresDoubleSign                    Boolean                                @default(false)
  /// Structured administration hint: INFUSION | PUSH | ORAL | IM | SQ | OTHER | UNKNOWN (optional; null = legacy / unspecified).
  administrationType                    String?
  /// Structured billing-review class: HYDRATION | THERAPEUTIC | DRUG_SUPPLY | UNKNOWN (optional; suggestions only).
  billingClass                          String?
  facilityMedicationUsages              FacilityMedicationUsage[]
  inventoryItems                        InventoryItem[]
  medicationAdministrationVerifications MedicationAdministrationVerification[]
  aliases                               MedicationAlias[]
  medicationDispenses                   MedicationDispense[]
  legacyMedicationProducts              MedicationProduct?                     @relation("CatalogMedicationLegacyProduct")
  medicationWasteDocumentations         MedicationWasteDocumentation[]
  pharmacyVerifications                 PharmacyVerification[]

  @@index([ndc11])
}

model MedicationAlias {
  id                  String            @id @default(uuid())
  catalogMedicationId String
  alias               String
  language            String?
  isPrimary           Boolean           @default(false)
  createdAt           DateTime          @default(now())
  catalogMedication   CatalogMedication @relation(fields: [catalogMedicationId], references: [id], onDelete: Cascade)

