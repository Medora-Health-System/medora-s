  concentrationDenominators  MedicationConcentration[]         @relation("MedicationConcentrationDenominatorUnit")
  concentrationNumerators    MedicationConcentration[]         @relation("MedicationConcentrationNumeratorUnit")
  concentrationTotalVolumes  MedicationConcentration[]         @relation("MedicationConcentrationTotalVolumeUnit")
  packageContentsUnits       MedicationPackage[]               @relation("MedicationPackageContentsUnit")
  packageDefaultDoseUnits    MedicationPackage[]               @relation("MedicationPackageDefaultDoseUnit")
  safetyMaxSingleDoseUnits   MedicationSafetyProfile[]         @relation("MedicationSafetyMaxSingleDoseUnit")
}

model MedicationConcept {
  id                 String                      @id @default(uuid())
  code               String                      @unique
  genericName        String
  displayName        String
  therapeuticClassId String?
  rxNormConceptId         String?                     @db.VarChar(64)
  rxNormTermType          String?                     @db.VarChar(32)
  rxNormSourceVocabulary  String?                     @db.VarChar(32)
  rxNormMappingStatus     String                      @default("UNMAPPED") @db.VarChar(32)
  rxNormMappingConfidence String?                     @db.VarChar(16)
  rxNormMappingVersion    String?                     @db.VarChar(64)
  rxNormMappedAt          DateTime?
  rxNormMappedByUserId    String?
  rxNormReviewedAt        DateTime?
  rxNormReviewNotes       String?
  /// PRODUCTION | FIXTURE | DEV_SAMPLE | UNKNOWN | CONTROLLED_REAL_PILOT
  dataClassification      String                      @default("UNKNOWN") @db.VarChar(32)
  /// Phase 6.5 — deterministic concept identity key (nullable until backfill).
  identityKey             String?                     @db.VarChar(255)
  isActive                Boolean                     @default(true)
  retiredAt               DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  therapeuticClass        MedicationTherapeuticClass? @relation(fields: [therapeuticClassId], references: [id])
  rxNormMappedBy          User?                       @relation("MedicationConceptRxNormMappedBy", fields: [rxNormMappedByUserId], references: [id])
  products                MedicationProduct[]
  safetyProfile           MedicationSafetyProfile?
  searchAliases           MedicationSearchAlias[]
  clinicalProfiles        MedicationClinicalProfile[]
  safetyClassMemberships  MedicationTherapeuticClassMembership[]
  subjectDrugInteractions MedicationDrugInteraction[] @relation("MedicationDrugInteractionSubjectConcept")
  objectDrugInteractions  MedicationDrugInteraction[] @relation("MedicationDrugInteractionObjectConcept")
  drugClassInteractions   MedicationDrugClassInteraction[]
  allergenMappings        MedicationAllergenMapping[]
  crossReactivityRules    MedicationAllergyCrossReactivityRule[]
  duplicateTherapyMemberships MedicationDuplicateTherapyMembership[]

  @@index([therapeuticClassId])
  @@index([isActive])
  @@index([rxNormConceptId])
  @@index([rxNormMappingStatus])
  @@index([dataClassification])
  @@index([identityKey])
}

model MedicationConcentration {
  id                String              @id @default(uuid())
  numeratorAmount   Decimal?            @db.Decimal(16, 6)
  numeratorUnitId   String?
  denominatorAmount Decimal?            @db.Decimal(16, 6)
  denominatorUnitId String?
  totalVolumeAmount Decimal?            @db.Decimal(16, 6)
  totalVolumeUnitId String?
  displayText       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  denominatorUnit   MedicationDoseUnit? @relation("MedicationConcentrationDenominatorUnit", fields: [denominatorUnitId], references: [id])
  numeratorUnit     MedicationDoseUnit? @relation("MedicationConcentrationNumeratorUnit", fields: [numeratorUnitId], references: [id])
  totalVolumeUnit   MedicationDoseUnit? @relation("MedicationConcentrationTotalVolumeUnit", fields: [totalVolumeUnitId], references: [id])
  products          MedicationProduct[]

  @@index([numeratorUnitId])
  @@index([denominatorUnitId])
  @@index([totalVolumeUnitId])
}

model MedicationProduct {
  id                         String                           @id @default(uuid())
  code                       String                           @unique
  conceptId                  String
  /// Backfill link to legacy `CatalogMedication` during migration (optional, unique when set).
  legacyCatalogMedicationId  String?                          @unique
  strengthDisplay            String
  concentrationId            String?
  dosageForm                 String                           @db.VarChar(64)
  defaultRouteId             String?
  /// ORAL | IM | SQ | PUSH | INFUSION | OTHER
  administrationType         String                           @db.VarChar(32)
  /// HYDRATION | THERAPEUTIC | DRUG_SUPPLY | UNKNOWN
  billingClass               String                           @db.VarChar(32)
  isActive                   Boolean                          @default(true)
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  /// Phase 19D.1 — governance activation state (does not affect runtime ordering/MAR/billing).
  governanceStatus           String                           @default("REVIEW_REQUIRED") @db.VarChar(48)
  activationApprovedAt       DateTime?
  activationApprovedByUserId String?
  governanceNotes            String?
  /// Phase 19H — global baseline catalog row (all facilities); does not enable ordering/MAR/billing.
  baselineAvailable          Boolean                          @default(false)
  baselineSource             String?                          @db.VarChar(48)
  baselineSourceRowId        String?                          @db.VarChar(128)
  dualLayerLinkageStatus     String                           @default("UNLINKED") @db.VarChar(32)
  dualLayerLinkageMethod     String?                          @db.VarChar(48)
  dualLayerLinkageConfidence String?                          @db.VarChar(16)
  dualLayerLinkageReviewedAt DateTime?
  dualLayerLinkageNotes      String?
  /// Phase 6.5 — deterministic product identity key (nullable until backfill).
  identityKey                String?                          @db.VarChar(512)
  infusionProfile            InfusionProfile?
  infusionSessions           InfusionSession[]
  administrations            MedicationAdministration[]
  administrationProfile      MedicationAdministrationProfile?
  dispenses                  MedicationDispense[]
  orderSetLinks              MedicationOrderSetLink[]
  packages                   MedicationPackage[]
  activationApprovedBy       User?                            @relation("MedicationProductActivationApprovedBy", fields: [activationApprovedByUserId], references: [id])
  concentration              MedicationConcentration?         @relation(fields: [concentrationId], references: [id])
  concept                    MedicationConcept                @relation(fields: [conceptId], references: [id])
  defaultRoute               MedicationRoute?                 @relation("MedicationProductDefaultRoute", fields: [defaultRouteId], references: [id])
  legacyCatalogMedication    CatalogMedication?               @relation("CatalogMedicationLegacyProduct", fields: [legacyCatalogMedicationId], references: [id])
  searchAliases              MedicationSearchAlias[]
  routePermissions           MedicationProductRoutePermission[]
  orderItems                 OrderItem[]
  clinicalProfiles           MedicationClinicalProfile[]
  safetyClassMemberships     MedicationTherapeuticClassMembership[]
  subjectDrugInteractions    MedicationDrugInteraction[] @relation("MedicationDrugInteractionSubjectProduct")
  objectDrugInteractions     MedicationDrugInteraction[] @relation("MedicationDrugInteractionObjectProduct")
  drugClassInteractions      MedicationDrugClassInteraction[]
  allergenMappings           MedicationAllergenMapping[]
  crossReactivityRules       MedicationAllergyCrossReactivityRule[]
  duplicateTherapyMemberships MedicationDuplicateTherapyMembership[]

  @@index([conceptId])
  @@index([legacyCatalogMedicationId])
  @@index([isActive])
  @@index([administrationType])
  @@index([governanceStatus])
  @@index([baselineAvailable])
  @@index([baselineSource])
  @@index([dualLayerLinkageStatus])
  @@index([identityKey])
}

model MedicationPackage {
  id                     String                     @id @default(uuid())
  code                   String                     @unique
  productId              String
  packageDescription     String
  /// VIAL | SYRINGE | BAG_PREMIX | BAG_BASE | AMPULE | TABLET_BOTTLE | OTHER
  packageType            String                     @db.VarChar(32)
  ndc11                  String?                    @db.VarChar(11)
  ndcDisplay             String?                    @db.VarChar(32)
  contentsAmount         Decimal?                   @db.Decimal(16, 6)
  contentsUnitId         String?
  defaultDoseUnitId      String?
  isDefaultForProduct    Boolean                    @default(false)
  isActive               Boolean                    @default(true)
  /// Phase 6.5 — deterministic package identity key (nullable until backfill).
  identityKey            String?                    @db.VarChar(768)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  facilityFormularyItems FacilityFormularyItem[]
  infusionSessions       InfusionSession[]
  inventoryItems         InventoryItem[]
  administrations        MedicationAdministration[]
  billingProfiles        MedicationBillingProfile[]
  dispenses              MedicationDispense[]
  orderSetLinksDefault   MedicationOrderSetLink[]   @relation("MedicationOrderSetLinkDefaultPackage")
  contentsUnit           MedicationDoseUnit?        @relation("MedicationPackageContentsUnit", fields: [contentsUnitId], references: [id])
  defaultDoseUnit        MedicationDoseUnit?        @relation("MedicationPackageDefaultDoseUnit", fields: [defaultDoseUnitId], references: [id])
  product                MedicationProduct          @relation(fields: [productId], references: [id])
  orderItems             OrderItem[]

  @@index([productId])
  @@index([ndc11])
  @@index([isActive])
  @@index([isDefaultForProduct])
  @@index([identityKey])
}

model FacilityFormularyItem {
