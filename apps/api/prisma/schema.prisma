model DiseaseCaseReport {
  id                            String                      @id @default(uuid())
  patientId                     String?
  facilityId                    String
  encounterId                   String?
  diseaseCode                   String
  diseaseName                   String
  status                        DiseaseCaseStatus
  reportedAt                    DateTime                    @default(now())
  /// Date de début des signes (équivalent dossier initial « symptom onset »).
  onsetDate                     DateTime?
  commune                       String?
  department                    String?
  notes                         String?
  reportedByUserId              String?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  /// Dossier initial — signes (pas de champs de décision MSPP département/central ici).
  feverReported                 Boolean?
  symptomDuration               String?                     @db.VarChar(256)
  hospitalized                  Boolean?
  outcomeStatus                 String?                     @db.VarChar(128)
  labConfirmed                  Boolean?
  labEvidenceType               MsppLabEvidenceType?
  epiLinkedCase                 Boolean?
  travelOrExposureContext       String?
  clinicalSummary               String?
  provisionalCaseClassification MsppCaseClassification?
  /// Référentiel national GeoCommune (obligatoire à la création via API ; dénormalisation `commune`/`department` pour affichage).
  geoCommuneId                  String?
  encounter                     Encounter?                  @relation(fields: [encounterId], references: [id])
  facility                      Facility                    @relation(fields: [facilityId], references: [id])
  geoCommune                    GeoCommune?                 @relation(fields: [geoCommuneId], references: [id])
  patient                       Patient?                    @relation(fields: [patientId], references: [id])
  reportedBy                    User?                       @relation(fields: [reportedByUserId], references: [id])
  msppFeedbacks                 MsppDiseaseReportFeedback[]

  @@index([facilityId])
  @@index([patientId])
  @@index([diseaseCode])
  @@index([status])
  @@index([reportedAt])
  @@index([geoCommuneId])
}

/// FRONT_DESK (and others) create via API; `encounterId` optional for registration desk follow-ups.
model FollowUp {
  id              String         @id @default(uuid())
  patientId       String
  facilityId      String
  encounterId     String?
  dueDate         DateTime
  reason          String?
  status          FollowUpStatus @default(OPEN)
  notes           String?
  createdByUserId String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       User?          @relation(fields: [createdByUserId], references: [id])
  encounter       Encounter?     @relation(fields: [encounterId], references: [id])
  facility        Facility       @relation(fields: [facilityId], references: [id])
  patient         Patient        @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([facilityId])
  @@index([dueDate])
  @@index([status])
  @@index([facilityId, status, dueDate])
}

/// MSPP-style review record. Phase 1: optional `diseaseCaseReportId` without FK to `DiseaseCaseReport` until relations are confirmed.
model DiseaseCaseReview {
  id                       String                      @id @default(uuid())
  diseaseCaseReportId      String?                     @unique
  reviewerUserId           String?
  notes                    String?
  reviewedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  status                   String
  reviewerLevel            String
  departmentId             String
  /// Dernière décision : critère structuré — présence de fièvre (oui/non).
  validationFever          Boolean?
  /// Durée des signes ou de l’épisode (texte court).
  validationDuration       String?
  /// Confirmation biologique (oui/non).
  validationLabConfirmed   Boolean?
  /// Risque d’exposition : LOW | MEDIUM | HIGH | UNKNOWN.
  validationExposureRisk   String?
  /// Classification épidémiologique du cas (revue structurée).
  caseClassification       MsppCaseClassification?
  inclusionCriteriaSummary String?
  exclusionCriteriaSummary String?
  symptomOnsetDate         DateTime?
  hospitalized             Boolean?
  outcomeStatus            String?                     @db.VarChar(128)
  labEvidenceType          MsppLabEvidenceType?
  epiLinkedCase            Boolean?
  travelOrExposureContext  String?
  finalDecisionRationale   String?
  msppFeedbacks            MsppDiseaseReportFeedback[]
  auditEvents              MsppReviewAuditEvent[]

  @@index([reviewerUserId])
  @@index([departmentId])
}

/// Immutable MSPP validation/review events (append-only; complements `notes` on DiseaseCaseReview).
model MsppReviewAuditEvent {
  id                  String            @id @default(uuid())
  diseaseCaseReviewId String
  diseaseCaseReportId String?
  /// e.g. DEPARTMENT_APPROVE, CENTRAL_REQUEUE — see `mspp.constants` / app layer.
  action              String
  reviewerUserId      String
  /// DEPARTMENT | CENTRAL — niveau de la décision ou de la file concernée.
  reviewerLevel       String
  statusBefore        String?
  statusAfter         String?
  requeued            Boolean           @default(false)
  criteriaSnapshot    Json?
  createdAt           DateTime          @default(now())
  diseaseCaseReview   DiseaseCaseReview @relation(fields: [diseaseCaseReviewId], references: [id], onDelete: Cascade)
  reviewer            User              @relation(fields: [reviewerUserId], references: [id])

  @@index([diseaseCaseReviewId])
  @@index([diseaseCaseReportId])
  @@index([createdAt])
}

/// Haiti national geographic department (département).
model GeoDepartment {
