generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  /// Medora platform operations (exports, env health, backup readiness). Assigned only by platform ops / DB — not in facility admin role picker.
  MEDORA_SUPER_ADMIN
  PROVIDER
  RN
  FRONT_DESK
  LAB
  RADIOLOGY
  PHARMACY
  BILLING
}

enum DepartmentCode {
  PRIMARY_CARE
  LAB
  RAD
  PHARM
  INPATIENT
}

/// Clinical / legacy shorthand stored alongside `Patient.sex` (canonical demographic enum).
enum SexAtBirth {
  M
  F
  X
  U
}

/// Canonical patient demographic sex for APIs, search, and offline snapshots (no age stored).
enum PatientSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum InsuranceCoverageRank {
  PRIMARY
  SECONDARY
}

enum PathwayType {
  STROKE
  SEPSIS
  STEMI
  TRAUMA
}

enum PathwayStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PathwayMilestoneStatus {
  PENDING
  MET
  OVERDUE
  SKIPPED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  VIEW
  SEED
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_VIEW
  ENCOUNTER_CREATE
  ENCOUNTER_UPDATE
  ENCOUNTER_CLOSE
  ENCOUNTER_VIEW
  ORDER_CREATE
  ORDER_CANCEL
  ORDER_VIEW
  CHART_ACCESS
  ORDER_UPDATE
  RESULT_UPLOAD
  MEDICATION_DISPENSED
  BILLING_FINALIZED
  BILLING_REOPENED
  CHART_OPEN
  TRIAGE_SAVE
  ORDER_ACK
  ORDER_START
  ORDER_COMPLETE
  RESULT_VERIFY
  CRITICAL_FLAG
  PATHWAY_ACTIVATED
  ORDERS_CREATED
  PROVIDER_DOCUMENTATION_SIGN
  PROVIDER_DOCUMENTATION_ADDENDUM
  BREAK_GLASS_START
  BREAK_GLASS_ACCESS
  BREAK_GLASS_END
}

/// Charge-capture ledger (Phase 1) — complements Encounter.billingCaptureJson; idempotent per source.
enum BillingSourceModule {
  DIAGNOSIS
  ORDER_ITEM
  MEDICATION_DISPENSE
  MEDICATION_ADMINISTRATION
  ENCOUNTER_DISPOSITION
  MANUAL
  VACCINE_ADMINISTRATION
  /// Catalog-driven auto billing (Phase 4.5) — distinct from ORDER_ITEM ledger lines.
  LAB_RESULT
  IMAGING_RESULT
  MED_ADMIN
  PROCEDURE
  /// Emergency E/M (Phase 4.6) — one per encounter, idempotent on encounter id.
  ENCOUNTER_EM
  /// Catalog-driven supply billing (Phase 4.6).
  SUPPLY
}

enum BillingReviewStatus {
  CAPTURED
  REVIEWED
  VOIDED
  SKIPPED
}

enum BillingReviewDecisionStatus {
  APPROVED
  NEEDS_INFO
  DO_NOT_BILL
}

enum BillingCodeType {
  UNKNOWN
  INTERNAL
  CPT
  HCPCS
  ICD10_CM
}

/// CPT vs HCPCS on the unified procedure reference table (ER-2).
enum BillingProcedureCodeSystem {
  CPT
  HCPCS
}

enum BillingSide {
  UNKNOWN
  PROFESSIONAL
  FACILITY
  BOTH
}

/// Claim-readiness workflow for an encounter (Phase 3 — no payer submission).
enum EncounterBillingFinalizationStatus {
  NOT_READY
  READY_FOR_REVIEW
  FINALIZED
  REOPENED
}

/// Phase 6.2 — persisted claim submission artifacts (no live clearinghouse transmission).
enum ClaimSubmissionKind {
  PROFESSIONAL_837P
  FACILITY_837I
}

enum ClaimSubmissionStatus {
  DRAFT
  GENERATED
  READY_TO_SEND
  SENT
  ACK_PENDING
  ACCEPTED
  REJECTED
  NEEDS_CORRECTION
  CANCELLED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  URGENT_CARE
}

enum EncounterStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// Explicit clinical / operational pathway (distinct from `EncounterStatus` lifecycle).
enum EncounterWorkflowState {
  ARRIVED
  TRIAGE
  IN_TREATMENT
  RESULTS_PENDING
  DISPOSITION
  DISCHARGE_READY
  FINALIZED
  CLOSED
}

enum DischargeStatus {
  DISCHARGED
  AMA
  TRANSFERRED
  DECEASED
}

enum OrderStatus {
  DRAFT
  PLACED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  RESULTED
  VERIFIED
  CANCELLED
  PENDING
  SIGNED
}

/// ER-ORDER-LIFECYCLE: normalized order domains for legal/clinical audit.
enum OrderEventOrderType {
  LAB
  MEDICATION
  IMAGING
  PROCEDURE
}

/// ER-ORDER-LIFECYCLE: additive event stream for order lifecycle auditing.
enum OrderEventType {
  CREATED
  STARTED
  COMPLETED
  CANCELLED
}

/// Append-only clinical documentation / workflow events (S8A — INSERT only; no updates or deletes).
enum EncounterClinicalEventType {
  VITALS_RECORDED
  NURSING_ASSESSMENT_SAVED
  PROVIDER_MSE_SAVED
  PROVIDER_SIGNED
  PROVIDER_UNLOCKED
  HANDOFF_PROVIDER
  HANDOFF_NURSING
  IV_INSERTED
  IV_REMOVED
  PROCEDURE_DOCUMENTED
  DISCHARGE_SUMMARY_SAVED
  ADMISSION_SUMMARY_SAVED
  DISPOSITION_SUPPLEMENT_SAVED
  TRIAGE_ASSESSMENT_SAVED
}

/// Closed-loop line-item lifecycle (distinct from legacy `OrderStatus` values like RESULTED / VERIFIED).
enum OrderItemLifecycleState {
  ORDERED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELLED
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

/// Med order intent: RN executes in-chart vs pharmacy fulfills for outpatient / discharge.
enum MedicationFulfillmentIntent {
  ADMINISTER_CHART
  PHARMACY_DISPENSE
}

/// ER-3.2: structured MAR clinical outcome (stored on `MedicationAdministration`; notes are supplemental).
enum MedicationMarAction {
  administered
  refused
  not_available
  md_changed
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

/// How a clinical diagnosis row was coded (ER-1 — billing / export metadata).
enum DiagnosisCodeSource {
  /// Pre–ER-1 rows or API calls without explicit catalog or manual declaration.
  LEGACY
  /// Selected from `Icd10DiagnosisCode` reference table.
  ICD10_CATALOG
  /// User explicitly documented a non-catalog code (not validated as ICD-10-CM).
  MANUAL_DECLARED
}

enum InventoryTransactionType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  WASTE
}

enum DiseaseCaseStatus {
  SUSPECTED
  CONFIRMED
  RULED_OUT
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Classification for facilities (for future use on `Facility`; Phase 1 adds enum only).
enum FacilityType {
  HOSPITAL
  CLINIC
  HEALTH_CENTER
  LABORATORY
  SURVEILLANCE_POST
  COMMUNITY_SITE
  OTHER
}

/// National MSPP portal roles (separate from facility-scoped `RoleCode`).
enum MsppRoleCode {
  MSPP_MINISTRE
  MSPP_EPIDEMIOLOGIE
  MSPP_VALIDATOR_DEPT
  MSPP_VALIDATOR_CENTRAL
  /// Administration déléguée des accès MSPP (sans pouvoirs plateforme).
  MSPP_ADMIN
  /// Accès module partagé « Santé publique » (résumé) — UI ; API toujours liée à l’établissement actif.
  MSPP_PUBLIC_HEALTH
  /// Accès module « Déclarations maladies » — UI ; API toujours liée à l’établissement actif.
  MSPP_DISEASE_REPORTS
  /// Accès module « Vaccinations » — UI ; API toujours liée à l’établissement actif.
  MSPP_VACCINATIONS
}

model Facility {
  id                       String   @id @default(uuid())
  code                     String   @unique
  name                     String
  country                  String
  timezone                 String
  defaultLanguage          String   @default("fr")
  isActive                 Boolean  @default(true)
  /// Phase 7 — institutional / UB-style claim billing identity (optional).
  billingLegalName         String?
  billingNpi               String?
  taxIdEin                 String?
  billingAddressLine1      String?
  billingAddressLine2      String?
  billingCity              String?
  billingStateProvince     String?
  billingPostalCode        String?
  billingCountry           String?
  billingFacilityTypeLabel String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  departments                    Department[]
  userRoles                      UserRole[]
  patientsRegistered             Patient[]                       @relation("RegisteredAtFacility")
  patients                       Patient[]                       @relation("PatientFacility")
  encounters                     Encounter[]
  orders                         Order[]
  auditLogs                      AuditLog[]
  triages                        Triage[]
  results                        Result[]
  pathwaySessions                PathwaySession[]
  protocolOrderSets              ProtocolOrderSet[]
  diagnoses                      Diagnosis[]
  medicationDispenses            MedicationDispense[]
  medicationAdministrations      MedicationAdministration[]
  inventoryItems                 InventoryItem[]
  inventoryTransactions          InventoryTransaction[]
  facilityMedicationUsages       FacilityMedicationUsage[]
  vaccineAdministrations         VaccineAdministration[]
  diseaseCaseReports             DiseaseCaseReport[]
  followUps                      FollowUp[]
  triageVitalsReadings           TriageVitalsReading[]
  encounterProviderAddenda       EncounterProviderAddendum[]
  breakGlassSessions             BreakGlassSession[]
  encounterIntakes               EncounterIntake[]
  patientInsuranceCoverages      PatientInsuranceCoverage[]
  billingEvents                  BillingEvent[]
  claimSubmissionBatches         ClaimSubmissionBatch[]
  claimSubmissions               ClaimSubmission[]
  claimControlCounters           ClaimControlCounter[]
  claimAcknowledgments           ClaimAcknowledgment[]
  claimAcknowledgmentDeadLetters ClaimAcknowledgmentDeadLetter[]
  claimOperationalEvents         ClaimOperationalEvent[]
  orderEvents                    OrderEvent[]
  billingReviewDecisions         BillingReviewDecision[]
  encounterClinicalEvents        EncounterClinicalEvent[]
}

/// Catalogue payeur (installation) — recherche par nom normalisé.
model InsurancePayer {
  id             String   @id @default(uuid())
  name           String
  normalizedName String
  /// Stable catalog key for idempotent seed (e.g. US_CAT_AETNA). Optional for legacy / manual rows.
  code           String?  @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coverages PatientInsuranceCoverage[]

  @@index([normalizedName])
}

/// Couverture par patient et établissement — V2+ peut étendre sans casser Phase 2.
model PatientInsuranceCoverage {
  id                   String                @id @default(uuid())
  patientId            String
  facilityId           String
  rank                 InsuranceCoverageRank
  payerId              String?
  payerNameFreeText    String?
  planName             String?
  memberId             String?
  policyNumber         String?
  groupNumber          String?
  subscriberName       String?
  relationToSubscriber String?
  phone                String?
  notes                String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  patient  Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  payer    InsurancePayer? @relation(fields: [payerId], references: [id], onDelete: SetNull)

  @@unique([patientId, facilityId, rank])
  @@index([patientId])
  @@index([facilityId])
}

model Department {
  id         String         @id @default(uuid())
  facilityId String
  code       DepartmentCode
  name       String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([facilityId, code])
}

model Role {
  id        String   @id @default(uuid())
  code      RoleCode @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  firstName           String
  lastName            String
  /// Phase 7 — 10-digit NPI for professional claim rendering (optional).
  billingNpi          String?
  billingTaxonomyCode String?
  billingNameOverride String?
  passwordHash        String
  refreshTokenHash    String?
  isActive            Boolean  @default(true)
  /// Plateforme : réservé au compte principal unique (`atranchant@medora.local`); tenir aligné avec les migrations (index unique partiel).
  canCreateFacilities Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userRoles                 UserRole[]
  auditLogs                 AuditLog[]
  medicationDispenses       MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  inventoryTransactions     InventoryTransaction[]
  vaccineAdministrations    VaccineAdministration[]
  diseaseCaseReports        DiseaseCaseReport[]
  followUpsCreated          FollowUp[]
  passwordResetTokens       PasswordResetToken[]

  encountersAsAssignedPhysician              Encounter[]                   @relation("EncounterPhysicianAssigned")
  encountersSignedByProvider                 Encounter[]                   @relation("EncounterSignedBy")
  encountersBillingFinalizedBy               Encounter[]                   @relation("EncounterBillingFinalizedBy")
  encountersBillingReopenedBy                Encounter[]                   @relation("EncounterBillingReopenedBy")
  providerAddendaCreated                     EncounterProviderAddendum[]
  orderItemsCompletedNurse                   OrderItem[]                   @relation("OrderItemNurseCompleted")
  ordersCancelled                            Order[]                       @relation("OrderCancelledBy")
  msppUserRoleAssignments                    MsppUserRoleAssignment[]
  msppReviewAuditEvents                      MsppReviewAuditEvent[]
  msppAlertTriagesAcknowledged               MsppAlertTriage[]             @relation("MsppAlertTriageAckBy")
  msppAlertTriagesAssigned                   MsppAlertTriage[]             @relation("MsppAlertTriageAssignTo")
  msppAlertInvestigationsOpened              MsppAlertInvestigation[]      @relation("MsppAlertInvestigationOpenedBy")
  msppAlertInvestigationsAssigned            MsppAlertInvestigation[]      @relation("MsppAlertInvestigationAssignedTo")
  msppAlertInvestigationEventsCreated        MsppAlertInvestigationEvent[] @relation("MsppAlertInvestigationEventCreatedBy")
  msppDiseaseReportFeedbacksCreated          MsppDiseaseReportFeedback[]   @relation("MsppDiseaseReportFeedbackCreatedBy")
  msppDiseaseReportFeedbacksFacilityReviewed MsppDiseaseReportFeedback[]   @relation("MsppDiseaseReportFeedbackFacilityReviewedBy")
  msppDiseaseReportFeedbacksResolved         MsppDiseaseReportFeedback[]   @relation("MsppDiseaseReportFeedbackResolvedBy")
  authSessions                               AuthSession[]
  breakGlassSessions                         BreakGlassSession[]
  performedOrderEvents                       OrderEvent[]
  billingReviewDecisionsReviewed             BillingReviewDecision[]        @relation("BillingReviewDecisionReviewer")
  encounterClinicalEventsCreated             EncounterClinicalEvent[]       @relation("EncounterClinicalEventCreatedBy")
}

/// Session de rafraîchissement par appareil / navigateur (jeton avec revendication `sid` dans le JWT refresh).
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Facility-scoped role assignment (user + Role row + facility). Same idea as a dedicated `FacilityUserRole` model.
model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  facilityId   String
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, facilityId])
  @@index([userId])
  @@index([facilityId])
  @@index([facilityId, roleId])
  @@index([departmentId])
}

/// Demographics: date of birth is `dob` only (age is always derived). `sex` is canonical; `sexAtBirth` kept for legacy/API parity.
model Patient {
  id                           String      @id @default(uuid())
  facilityId                   String
  mrn                          String?
  globalMrn                    String      @unique
  firstName                    String
  lastName                     String
  middleName                   String?
  dob                          DateTime?
  phone                        String?
  email                        String?
  sexAtBirth                   SexAtBirth?
  sex                          PatientSex  @default(UNKNOWN)
  nationalId                   String?
  address                      String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  stateProvince                String?
  postalCode                   String?
  country                      String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  adminNotes                   String?
  language                     String?
  registeredAtFacilityId       String
  /// Denormalized latest vitals JSON for chart header / offline read models; updated when triage or encounter vitals are saved.
  latestVitalsJson             Json?
  latestVitalsAt               DateTime?
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt

  facility                  Facility                   @relation("PatientFacility", fields: [facilityId], references: [id], onDelete: Restrict)
  registeredAtFacility      Facility                   @relation("RegisteredAtFacility", fields: [registeredAtFacilityId], references: [id], onDelete: Restrict)
  encounters                Encounter[]
  orders                    Order[]
  auditLogs                 AuditLog[]
  diagnoses                 Diagnosis[]
  medicationDispenses       MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  vaccineAdministrations    VaccineAdministration[]
  diseaseCaseReports        DiseaseCaseReport[]
  followUps                 FollowUp[]
  triageVitalsReadings      TriageVitalsReading[]
  breakGlassSessions        BreakGlassSession[]
  insuranceCoverages        PatientInsuranceCoverage[]
  billingEvents             BillingEvent[]
  billingReviewDecisions    BillingReviewDecision[]
  encounterClinicalEvents     EncounterClinicalEvent[]

  @@unique([facilityId, mrn])
  @@index([facilityId])
  @@index([lastName, firstName])
  @@index([phone])
  @@index([mrn])
}

model AuditLog {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  userId     String?
  facilityId String?
  patientId  String?
  ip         String?
  userAgent  String?
  entityType String
  entityId   String?
  action     AuditAction
  metadata   Json?

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  facility    Facility?  @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  patient     Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounter   Encounter? @relation("EncounterAuditLogs", fields: [encounterId], references: [id], onDelete: SetNull)
  order       Order?     @relation("OrderAuditLogs", fields: [orderId], references: [id], onDelete: SetNull)
  encounterId String?
  orderId     String?

  @@index([userId])
  @@index([facilityId])
  @@index([createdAt])
  @@index([encounterId])
}

model Encounter {
  id            String                 @id @default(uuid())
  facilityId    String
  patientId     String
  providerId    String?
  type          EncounterType
  status        EncounterStatus        @default(OPEN)
  workflowState EncounterWorkflowState @default(ARRIVED)

  chiefComplaint    String?
  triageAcuity      Int?
  vitals            Json?
  nursingAssessment Json?
  providerNote      String?
  /// Outpatient / clinic: structured treatment summary (distinct from free-text notes)
  treatmentPlan     String?
  followUpDate      DateTime?
  disposition       String?
  dischargeStatus   DischargeStatus?
  dischargedAt      DateTime?

  /// French-facing room label: "Salle d'attente" or "1"…"30"
  roomLabel               String?
  /// Assigned attending physician (display name only in UI; never use for nurse attribution)
  physicianAssignedUserId String?
  physicianAssigned       User?   @relation("EncounterPhysicianAssigned", fields: [physicianAssignedUserId], references: [id], onDelete: SetNull)
  /// Structured discharge summary (French UI keys / values); saved before closing when using discharge flow
  dischargeSummaryJson    Json?

  /// Synthèse structurée d'admission (hospitalisation depuis la consultation) — MVP, une décision par visite
  admissionSummaryJson         Json?
  /// U.S. billing foundation — charge capture / billing event candidates (V1 shared schema)
  billingCaptureJson           Json?
  /// Phase 3 — billing finalization for claim assembly (no submission in this phase).
  billingFinalizationStatus    EncounterBillingFinalizationStatus @default(NOT_READY)
  billingFinalizedAt           DateTime?
  billingFinalizedByUserId     String?
  billingFinalizedBy           User?                              @relation("EncounterBillingFinalizedBy", fields: [billingFinalizedByUserId], references: [id], onDelete: SetNull)
  billingReopenedAt            DateTime?
  billingReopenedByUserId      String?
  billingReopenedBy            User?                              @relation("EncounterBillingReopenedBy", fields: [billingReopenedByUserId], references: [id], onDelete: SetNull)
  /// Last computed readiness snapshot (blockers, warnings, counts) for audit / UI.
  billingReadinessSnapshotJson Json?
  /// Horodatage de la décision d'admission (rempli côté serveur à la 1re sauvegarde du dossier d'admission)
  admittedAt                   DateTime?

  notes String?

  /// DRAFT | SIGNED — signature médicale sur l’évaluation (V1)
  providerDocumentationStatus         String    @default("DRAFT")
  providerDocumentationSignedAt       DateTime?
  providerDocumentationSignedByUserId String?
  providerDocumentationSignedBy       User?     @relation("EncounterSignedBy", fields: [providerDocumentationSignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Optimistic locking — increment on every successful mutating write.
  version   Int      @default(1)

  patient                   Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility                  Facility                    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  orders                    Order[]
  auditLogs                 AuditLog[]                  @relation("EncounterAuditLogs")
  triage                    Triage?
  pathwaySession            PathwaySession?
  diagnoses                 Diagnosis[]
  medicationDispenses       MedicationDispense[]
  medicationAdministrations MedicationAdministration[]
  vaccineAdministrations    VaccineAdministration[]
  diseaseCaseReports        DiseaseCaseReport[]
  followUps                 FollowUp[]
  triageVitalsReadings      TriageVitalsReading[]
  providerAddenda           EncounterProviderAddendum[]
  breakGlassSessions        BreakGlassSession[]
  intake                    EncounterIntake?
  billingEvents             BillingEvent[]
  claimSubmissions          ClaimSubmission[]
  orderEvents               OrderEvent[]
  billingReviewDecisions    BillingReviewDecision[]
  encounterClinicalEvents   EncounterClinicalEvent[]

  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([workflowState])
  @@index([physicianAssignedUserId])
  @@index([providerDocumentationSignedByUserId])
  @@index([billingFinalizationStatus])
}

/// Optional mapping from clinical catalog / external codes to billable CPT/HCPCS (Phase 4.5 auto engine).
model BillingCatalog {
  id            String   @id @default(uuid())
  /// Billable code (CPT or HCPCS) to apply when matched.
  code          String
  /// "CPT" | "HCPCS"
  system        String
  description   String
  /// LAB | IMAGING | MEDICATION | PROCEDURE | SUPPLY
  triggerSource String
  /// LOINC, internal lab code, imaging study code, medication code, etc.
  externalCode  String?
  /// "professional" | "facility" | "both"
  billClass     String
  createdAt     DateTime @default(now())

  @@index([triggerSource])
  @@index([externalCode])
}

/// Relational billing event ledger — automatic capture from clinical actions (Phase 1).
model BillingEvent {
  id                  String              @id @default(uuid())
  facilityId          String
  patientId           String
  encounterId         String
  /// Latest BillingCaptureItem.id when synced from JSON pipeline.
  captureItemId       String?
  sourceModule        BillingSourceModule
  /// Business key for idempotency (order item id, diagnosis id, administration id, etc.).
  sourceRecordId      String
  eventType           String              @default("CHARGE_CAPTURE")
  serviceDate         DateTime?
  units               Int?
  codeType            BillingCodeType?
  code                String?
  procedureCode       String?
  hcpcsCode           String?
  diagnosisCodes      String?
  descriptionSnapshot String?             @db.Text
  priceSnapshot       Decimal?            @db.Decimal(14, 2)
  modifier1           String?
  modifier2           String?
  revenueCode         String?
  billingSide         BillingSide         @default(UNKNOWN)
  reviewStatus        BillingReviewStatus @default(CAPTURED)
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  billingReviewDecisions BillingReviewDecision[]

  @@unique([facilityId, sourceModule, sourceRecordId])
  @@index([encounterId])
  @@index([facilityId, reviewStatus])
  @@index([patientId])
}

model BillingReviewDecision {
  id             String                      @id @default(uuid())
  facilityId     String
  encounterId    String
  patientId      String
  orderItemId    String
  billingEventId String?
  decision       BillingReviewDecisionStatus
  notes          String?
  reviewerId     String
  reviewedAt     DateTime
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  facility     Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter    Encounter     @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  billingEvent BillingEvent? @relation(fields: [billingEventId], references: [id], onDelete: SetNull)
  reviewer     User          @relation("BillingReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([facilityId, orderItemId])
  @@index([facilityId, decision])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([reviewerId])
}

/// Métadonnées d’accueil / arrivée liées à une visite — ne remplace pas le motif clinique sur Encounter.
model EncounterIntake {
  id                    String    @id @default(uuid())
  encounterId           String    @unique
  facilityId            String
  arrivalAt             DateTime?
  modeOfArrival         String?
  initialChiefComplaint String?
  initialAcuity         Int?
  initialRoom           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([encounterId])
  @@index([facilityId])
}

/// Time-limited emergency chart access (break-glass) — scoped to one patient (and optionally one encounter) per session.
model BreakGlassSession {
  id          String    @id @default(uuid())
  userId      String
  facilityId  String
  patientId   String
  encounterId String?
  reason      String
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([userId, facilityId, patientId])
  @@index([facilityId, patientId])
  @@index([expiresAt])
}

/// Append-only addendum after provider documentation is signed (V1 — no edit/delete).
model EncounterProviderAddendum {
  id              String   @id @default(uuid())
  encounterId     String
  facilityId      String
  text            String
  createdAt       DateTime @default(now())
  createdByUserId String

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([encounterId, createdAt])
  @@index([createdByUserId])
  @@index([facilityId])
}

model Order {
  id                 String        @id @default(uuid())
  encounterId        String
  facilityId         String
  type               String // "LAB", "IMAGING", "MEDICATION"
  status             OrderStatus   @default(PENDING)
  priority           OrderPriority @default(ROUTINE)
  notes              String?
  orderedBy          String?
  source             String? // "MANUAL", "PROTOCOL"
  pathwaySessionId   String?
  prescriberName     String?
  prescriberLicense  String?
  prescriberContact  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?

  encounter      Encounter       @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId      String
  pathwaySession PathwaySession? @relation(fields: [pathwaySessionId], references: [id], onDelete: SetNull)
  cancelledBy    User?           @relation("OrderCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  auditLogs      AuditLog[]      @relation("OrderAuditLogs")
  orderEvents    OrderEvent[]

  @@index([encounterId])
  @@index([facilityId])
  @@index([patientId])
  @@index([status])
  @@index([pathwaySessionId])
  @@index([cancelledByUserId])
}

model OrderItem {
  id                          String                       @id @default(uuid())
  orderId                     String
  /// Référence catalogue (nullable si saisie manuelle — `manualLabel` requis dans ce cas).
  catalogItemId               String?
  catalogItemType             String // "LAB_TEST", "IMAGING_STUDY", "MEDICATION"
  /// Libellé saisi à la main lorsque l’article n’existe pas au catalogue (analyse, examen, médicament).
  manualLabel                 String?
  /// Précision (ex. région imagerie) ou texte secondaire d’affichage.
  manualSecondaryText         String?
  quantity                    Int?
  notes                       String?
  strength                    String? // e.g. "500 mg" for medication
  route                       String? // medication route snapshot, e.g. PO / IM / IVP / IVPB
  refillCount                 Int? // number of refills for Rx
  medicationFulfillmentIntent MedicationFulfillmentIntent?
  /// Administration prévue (information clinique, pas planification récurrente).
  intendedAdministrationAt    DateTime?
  completedAt                 DateTime?
  completedByUserId           String?
  completedByNurse            User?                        @relation("OrderItemNurseCompleted", fields: [completedByUserId], references: [id], onDelete: SetNull)
  status                      OrderStatus                  @default(PENDING)
  /// Explicit visit lifecycle — kept in sync with `status` in application code; `REVIEWED` = chart/review closure.
  lifecycleState              OrderItemLifecycleState      @default(ORDERED)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  order                     Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  result                    Result?
  pharmacyDispenseRecord    MedicationDispense?
  medicationAdministrations MedicationAdministration[]
  billingReviewDecisions    BillingReviewDecision[]

  @@index([orderId])
  @@index([status])
  @@index([lifecycleState])
  @@index([catalogItemType])
  @@index([catalogItemId])
  @@index([completedByUserId])
  @@index([medicationFulfillmentIntent])
}

/// ER-ORDER-LIFECYCLE: immutable audit events for all order domains.
model OrderEvent {
  id                String              @id @default(cuid())
  facilityId        String
  encounterId       String
  orderId           String
  orderType         OrderEventOrderType
  eventType         OrderEventType
  performedByUserId String
  performedAt       DateTime            @default(now())
  roleSnapshot      String
  note              String?
  metadata          Json?
  createdAt         DateTime            @default(now())

  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  performedBy User      @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([encounterId])
  @@index([orderId])
  @@index([performedAt])
  @@index([facilityId, encounterId, performedAt])
}

/// Append-only encounter-level clinical events (vitals saves, documentation, signatures, handoffs).
/// Application rule: INSERT only — never UPDATE or DELETE.
model EncounterClinicalEvent {
  id              String                     @id @default(uuid())
  facilityId      String
  encounterId     String
  patientId       String
  eventType       EncounterClinicalEventType
  payloadJson     Json
  createdByUserId String
  createdAt       DateTime                   @default(now())

  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy User      @relation("EncounterClinicalEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([facilityId, encounterId, createdAt])
  @@index([encounterId, createdAt])
  @@index([patientId, createdAt])
  @@index([createdByUserId])
}

model Triage {
  id               String    @id @default(uuid())
  encounterId      String    @unique
  facilityId       String
  chiefComplaint   String?
  onsetAt          DateTime?
  esi              Int?
  vitalsJson       Json?
  strokeScreen     Json?
  sepsisScreen     Json?
  triageCompleteAt DateTime?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  encounter            Encounter             @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility             Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  triageVitalsReadings TriageVitalsReading[]

  @@index([facilityId])
  @@index([encounterId])
}

/// Append-only vitals readings per triage save (Signes vitaux); `Triage.vitalsJson` remains current row.
model TriageVitalsReading {
  id               String    @id @default(uuid())
  facilityId       String
  patientId        String
  encounterId      String
  triageId         String
  vitalsJson       Json
  triageCompleteAt DateTime?
  recordedAt       DateTime  @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  triage    Triage    @relation(fields: [triageId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([patientId, recordedAt])
  @@index([encounterId])
  @@index([triageId])
}

model Result {
  id                       String    @id @default(uuid())
  orderItemId              String    @unique
  facilityId               String
  resultData               Json?
  resultText               String?
  criticalValue            Boolean   @default(false)
  /// Department user who last saved substantive result text/attachments (lab/radiology); not physician sign-off.
  verifiedByUserId         String?
  verifiedAt               DateTime?
  acknowledgedByProviderAt DateTime?
  /// Receiving clinician who acknowledged the result in-chart (distinct from `verifiedByUserId`).
  acknowledgedByUserId     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([orderItemId])
  @@index([criticalValue])
  @@index([acknowledgedByUserId])
}

/// Shared catalog row: stable `code`, human-readable labels, `searchText` for unified search, `updatedAt` for sync.
model CatalogLabTest {
  id                 String   @id @default(uuid())
  code               String   @unique
  /// Legacy internal / compat field; historically French-first for Haiti seeds. Do not use as English UI — use `displayNameEn`.
  name               String
  /// English-primary display label for catalog search, orders, MAR, and billing-enrichment line text.
  displayNameEn      String?
  /// French display label; must not be overwritten by English backfill workflows.
  displayNameFr      String?
  /// Optional U.S. CPT/HCPCS-style code suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description        String?
  searchText         String?
  sortPriority       Int      @default(0)
  isEssential        Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  aliases LabTestAlias[]
}

model LabTestAlias {
  id               String   @id @default(uuid())
  catalogLabTestId String
  alias            String
  language         String?
  createdAt        DateTime @default(now())

  catalogLabTest CatalogLabTest @relation(fields: [catalogLabTestId], references: [id], onDelete: Cascade)

  @@unique([catalogLabTestId, alias])
  @@index([catalogLabTestId])
  @@index([alias])
}

/// Shared catalog row: stable `code`, human-readable labels, `searchText` for unified search, `updatedAt` for sync.
model CatalogImagingStudy {
  id                 String   @id @default(uuid())
  code               String   @unique
  /// Legacy internal / compat field; French-first for Haiti seeds. Do not use as English UI — use `displayNameEn`.
  name               String
  /// English-primary display label for catalog search, orders, and billing-enrichment line text.
  displayNameEn      String?
  /// French display label; must not be overwritten by English backfill workflows.
  displayNameFr      String?
  /// Optional U.S. CPT/HCPCS-style code suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description        String?
  modality           String?
  bodyRegion         String?
  searchText         String?
  sortPriority       Int      @default(0)
  isEssential        Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  aliases ImagingStudyAlias[]
}

model ImagingStudyAlias {
  id                    String   @id @default(uuid())
  catalogImagingStudyId String
  alias                 String
  language              String?
  createdAt             DateTime @default(now())

  catalogImagingStudy CatalogImagingStudy @relation(fields: [catalogImagingStudyId], references: [id], onDelete: Cascade)

  @@unique([catalogImagingStudyId, alias])
  @@index([catalogImagingStudyId])
  @@index([alias])
}

/// Shared catalog row: stable `code`, human-readable labels, `searchText` for unified search, `updatedAt` for sync.
model CatalogMedication {
  id                 String   @id @default(uuid())
  code               String   @unique
  /// Legacy internal / compat (often mirrors `displayNameFr`). Do not use as English UI — use `displayNameEn`.
  name               String
  /// English-primary display label for pharmacy, search, orders, and MAR surfaces.
  displayNameEn      String?
  /// Optional HCPCS/J-code-style suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  /// ER-3: normalized National Drug Code (11 digits). Optional until local catalog quality is complete.
  ndc11              String?  @db.VarChar(11)
  /// ER-3: display NDC as entered/imported (e.g. 12345-6789-01) for UI readability.
  ndcDisplay         String?  @db.VarChar(32)
  /// ER-3: preferred quantity basis for billing math (e.g. mg, mL, each, unit).
  billingUnitType    String?  @db.VarChar(32)
  isControlled       Boolean  @default(false)
  controlledSchedule String?
  requiresWitness    Boolean  @default(false)
  requiresDoubleSign Boolean  @default(false)
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  genericName        String?
  /// French display label; must not be overwritten by English backfill workflows.
  displayNameFr      String?
  strength           String?
  dosageForm         String?
  route              String?
  /// Structured administration hint: INFUSION | PUSH | ORAL | IM | SQ | OTHER | UNKNOWN (optional; null = legacy / unspecified).
  administrationType String?  @db.VarChar(32)
  /// Structured billing-review class: HYDRATION | THERAPEUTIC | DRUG_SUPPLY | UNKNOWN (optional; suggestions only).
  billingClass       String?  @db.VarChar(32)
  therapeuticClass   String?
  sortPriority       Int      @default(0)
  isEssential        Boolean  @default(false)
  searchText         String?

  inventoryItems           InventoryItem[]
  medicationDispenses      MedicationDispense[]
  aliases                  MedicationAlias[]
  facilityMedicationUsages FacilityMedicationUsage[]

  @@index([ndc11])
}

model MedicationAlias {
  id                  String   @id @default(uuid())
  catalogMedicationId String
  alias               String
  language            String?
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())

  catalogMedication CatalogMedication @relation(fields: [catalogMedicationId], references: [id], onDelete: Cascade)

  @@unique([catalogMedicationId, alias])
  @@index([catalogMedicationId])
  @@index([alias])
}

model PathwaySession {
  id          String        @id @default(uuid())
  encounterId String        @unique
  facilityId  String
  type        PathwayType
  status      PathwayStatus @default(ACTIVE)
  contextJson Json?
  activatedAt DateTime      @default(now())
  pausedAt    DateTime?
  completedAt DateTime?
  activatedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  encounter  Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility   Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  milestones PathwayMilestone[]
  orders     Order[]

  @@index([encounterId])
  @@index([facilityId])
  @@index([type])
  @@index([status])
  @@map("PathwaySession")
}

model PathwayMilestone {
  id               String                 @id @default(uuid())
  pathwaySessionId String
  name             String
  description      String?
  targetMinutes    Int // Target time in minutes from activation
  status           PathwayMilestoneStatus @default(PENDING)
  metAt            DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  pathwaySession PathwaySession @relation(fields: [pathwaySessionId], references: [id], onDelete: Cascade)

  @@index([pathwaySessionId])
  @@index([status])
  @@map("PathwayMilestone")
}

model ProtocolOrderSet {
  id          String      @id @default(uuid())
  facilityId  String
  pathwayType PathwayType
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  facility Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  items    ProtocolOrderSetItem[]

  @@unique([facilityId, pathwayType])
  @@index([facilityId])
  @@index([pathwayType])
  @@index([isActive])
  @@map("ProtocolOrderSet")
}

model ProtocolOrderSetItem {
  id                    String        @id @default(uuid())
  protocolOrderSetId    String
  catalogLabTestId      String?
  catalogImagingStudyId String?
  catalogMedicationId   String?
  priority              OrderPriority @default(ROUTINE)
  sequence              Int // Order within the set
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  protocolOrderSet ProtocolOrderSet @relation(fields: [protocolOrderSetId], references: [id], onDelete: Cascade)

  @@index([protocolOrderSetId])
  @@index([sequence])
  @@map("ProtocolOrderSetItem")
}

/// ICD-10-CM reference rows (loaded from CMS-style files — not shipped as production-complete data).
model Icd10DiagnosisCode {
  id               String   @id @default(uuid())
  /// Canonical display code (typically with dots, e.g. R50.9).
  code             String   @unique
  /// Uppercase, dotless form for deterministic matching and search.
  normalizedCode   String
  shortDescription String
  longDescription  String?  @db.Text
  chapter          String?
  category         String?
  isBillable       Boolean  @default(true)
  isActive         Boolean  @default(true)
  /// Optional calendar year this row was introduced or last verified in Medora.
  effectiveYear    Int?
  /// Optional CMS / vendor file label (e.g. FY2025).
  codeSetVersion   String?  @db.VarChar(32)
  /// Denormalized lowercase text for simple contains search (code + descriptions).
  searchText       String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  diagnoses Diagnosis[]

  @@index([code])
  @@index([normalizedCode])
  @@index([isActive])
  @@index([shortDescription])
  @@index([normalizedCode, isActive])
}

/// CPT / HCPCS Level I & Level II reference rows (imported from vendor/CMS-style files — sample CSV in repo is not production-complete).
model BillingProcedureCode {
  id               String                     @id @default(uuid())
  /// Canonical display code (e.g. 99283, A0429).
  code             String
  /// Uppercase, normalized for matching (alphanumeric only, no spaces).
  normalizedCode   String
  codeSystem       BillingProcedureCodeSystem
  shortDescription String
  longDescription  String?                    @db.Text
  isActive         Boolean                    @default(true)
  effectiveYear    Int?
  codeSetVersion   String?                    @db.VarChar(32)
  /// Lowercase denormalized search blob (code + descriptions).
  searchText       String?                    @db.Text
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([codeSystem, normalizedCode])
  @@index([isActive])
  @@index([codeSystem])
}

// --- Medora Core: continuity / diagnoses ---
model Diagnosis {
  id             String              @id @default(uuid())
  patientId      String
  encounterId    String
  facilityId     String
  code           String
  description    String?
  status         DiagnosisStatus     @default(ACTIVE)
  onsetDate      DateTime?
  resolvedDate   DateTime?
  notes          String?
  /// Encounter-scoped ordering: lower = earlier in claim / primary-first convention (0 = principal).
  sortOrder      Int                 @default(0)
  icd10CatalogId String?
  codeSource     DiagnosisCodeSource @default(LEGACY)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  icd10Catalog Icd10DiagnosisCode? @relation(fields: [icd10CatalogId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([encounterId])
  @@index([encounterId, sortOrder])
  @@index([facilityId])
  @@index([status])
  @@index([code])
  @@index([icd10CatalogId])
}

// --- Medora Pharmacy: inventory + dispensing ---
model InventoryItem {
  id                  String    @id @default(uuid())
  facilityId          String
  catalogMedicationId String
  sku                 String
  lotNumber           String?
  expirationDate      DateTime?
  quantityOnHand      Int       @default(0)
  reorderLevel        Int       @default(0)
  unit                String?
  isActive            Boolean   @default(true)
  isFavorite          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  facility            Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  catalogMedication   CatalogMedication      @relation(fields: [catalogMedicationId], references: [id], onDelete: Restrict)
  medicationDispenses MedicationDispense[]
  transactions        InventoryTransaction[]

  @@unique([facilityId, sku])
  @@index([facilityId])
  @@index([catalogMedicationId])
  @@index([isActive])
  @@index([isFavorite])
}

model FacilityMedicationUsage {
  id                  String    @id @default(uuid())
  facilityId          String
  catalogMedicationId String
  inventoryAddsCount  Int       @default(0)
  dispenseCount       Int       @default(0)
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  facility          Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  catalogMedication CatalogMedication @relation(fields: [catalogMedicationId], references: [id], onDelete: Cascade)

  @@unique([facilityId, catalogMedicationId])
  @@index([facilityId, lastUsedAt])
  @@index([facilityId, dispenseCount])
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  inventoryItemId   String
  facilityId        String
  type              InventoryTransactionType
  quantity          Int
  performedByUserId String
  patientId         String?
  encounterId       String?
  notes             String?
  createdAt         DateTime                 @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  facility      Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  performedBy   User          @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([facilityId])
  @@index([type])
  @@index([createdAt])
}

model MedicationDispense {
  id                    String   @id @default(uuid())
  patientId             String
  encounterId           String
  facilityId            String
  /// Null si dispensation liée à une ligne d’ordonnance sans entrée catalogue (saisie manuelle).
  catalogMedicationId   String?
  /// Libellé figé lorsque `catalogMedicationId` est absent (même source que `OrderItem.manualLabel`).
  manualMedicationLabel String?
  /// When null, dispense is documentation-only (no stock movement), e.g. ordonnance remise.
  inventoryItemId       String?
  orderItemId           String?  @unique
  quantityDispensed     Int
  /// ER-3: structured dose value for billing-safe medication capture.
  doseValue             Decimal? @db.Decimal(12, 4)
  /// ER-3: structured dose unit (mg, mL, unit, each, etc.).
  doseUnit              String?  @db.VarChar(32)
  /// ER-3: billing quantity snapshot (can differ from quantityDispensed in future payer logic).
  billingQuantity       Decimal? @db.Decimal(12, 4)
  /// ER-3: quantity unit (tablet, mL, vial, each, etc.).
  quantityUnit          String?  @db.VarChar(32)
  /// ER-3: normalized NDC snapshot at dispense time (11 digits), optional.
  ndc11Snapshot         String?  @db.VarChar(11)
  /// ER-3: human display NDC snapshot (hyphenated), optional.
  ndcDisplaySnapshot    String?  @db.VarChar(32)
  dosageInstructions    String?
  dispensedByUserId     String
  dispensedAt           DateTime @default(now())
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter         Encounter          @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility          Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  catalogMedication CatalogMedication? @relation(fields: [catalogMedicationId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  orderItem         OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  dispensedBy       User               @relation(fields: [dispensedByUserId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([encounterId])
  @@index([facilityId])
  @@index([inventoryItemId])
  @@index([dispensedAt])
  @@index([ndc11Snapshot])
}

/// Append-only bedside medication administrations (MAR log); does not replace OrderItem lifecycle.
model MedicationAdministration {
  id                      String   @id @default(uuid())
  facilityId              String
  patientId               String
  encounterId             String
  orderItemId             String?
  medicationLabelSnapshot String?
  /// Route as documented at administration time (e.g. IV, IM, SQ, PO); preferred over catalog for billing CPT inference.
  route                   String?
  /// ER-3: structured dose value documented at administration.
  doseValue               Decimal? @db.Decimal(12, 4)
  /// ER-3: dose unit (mg, mL, unit, each, etc.).
  doseUnit                String?  @db.VarChar(32)
  /// ER-3: administered quantity documented by nurse/provider.
  administeredQuantity    Decimal? @db.Decimal(12, 4)
  /// ER-3: quantity captured for billing prep (defaults to administeredQuantity when omitted).
  billingQuantity         Decimal? @db.Decimal(12, 4)
  /// ER-3: quantity unit snapshot.
  quantityUnit            String?  @db.VarChar(32)
  /// ER-3: normalized NDC snapshot at administration time (11 digits), optional.
  ndc11Snapshot           String?  @db.VarChar(11)
  /// ER-3: display NDC snapshot at administration time, optional.
  ndcDisplaySnapshot      String?  @db.VarChar(32)
  administeredAt          DateTime @default(now())
  administeredByUserId    String
  /// ER-3.2: primary MAR outcome; null = legacy row (derive from notes only for display).
  marAction               MedicationMarAction?
  notes                   String?
  createdAt               DateTime @default(now())

  facility       Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter  @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  orderItem      OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  administeredBy User       @relation(fields: [administeredByUserId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([administeredAt])
  @@index([ndc11Snapshot])
}

// --- Medora Public Health: vaccination + disease reporting ---
model VaccineCatalog {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  /// Optional CPT/HCPCS-style suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description        String?
  manufacturer       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vaccineAdministrations VaccineAdministration[]
}

model VaccineAdministration {
  id                   String    @id @default(uuid())
  patientId            String
  facilityId           String
  encounterId          String?
  vaccineCatalogId     String
  doseNumber           Int?
  lotNumber            String?
  administeredAt       DateTime  @default(now())
  administeredByUserId String?
  nextDueAt            DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter      Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  vaccineCatalog VaccineCatalog @relation(fields: [vaccineCatalogId], references: [id], onDelete: Restrict)
  administeredBy User?          @relation(fields: [administeredByUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([facilityId])
  @@index([encounterId])
  @@index([vaccineCatalogId])
  @@index([administeredAt])
}

model DiseaseCaseReport {
  id               String            @id @default(uuid())
  patientId        String?
  facilityId       String
  encounterId      String?
  diseaseCode      String
  diseaseName      String
  status           DiseaseCaseStatus
  reportedAt       DateTime          @default(now())
  /// Date de début des signes (équivalent dossier initial « symptom onset »).
  onsetDate        DateTime?
  commune          String?
  department       String?
  /// Référentiel national GeoCommune (obligatoire à la création via API ; dénormalisation `commune`/`department` pour affichage).
  geoCommuneId     String?
  notes            String?
  reportedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Dossier initial — signes (pas de champs de décision MSPP département/central ici).
  feverReported                 Boolean?
  symptomDuration               String?                 @db.VarChar(256)
  hospitalized                  Boolean?
  outcomeStatus                 String?                 @db.VarChar(128)
  labConfirmed                  Boolean?
  labEvidenceType               MsppLabEvidenceType?
  epiLinkedCase                 Boolean?
  travelOrExposureContext       String?                 @db.Text
  clinicalSummary               String?                 @db.Text
  provisionalCaseClassification MsppCaseClassification?

  patient       Patient?                    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  facility      Facility                    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter     Encounter?                  @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  reportedBy    User?                       @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  geoCommune    GeoCommune?                 @relation(fields: [geoCommuneId], references: [id], onDelete: SetNull)
  msppFeedbacks MsppDiseaseReportFeedback[]

  @@index([facilityId])
  @@index([patientId])
  @@index([diseaseCode])
  @@index([status])
  @@index([reportedAt])
  @@index([geoCommuneId])
}

/// FRONT_DESK (and others) create via API; `encounterId` optional for registration desk follow-ups.
model FollowUp {
  id              String         @id @default(uuid())
  patientId       String
  facilityId      String
  encounterId     String?
  dueDate         DateTime
  reason          String?
  status          FollowUpStatus @default(OPEN)
  notes           String?
  createdByUserId String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([facilityId])
  @@index([dueDate])
  @@index([status])
  @@index([facilityId, status, dueDate])
}

/// Classification du cas pour la revue de surveillance (MSPP).
enum MsppCaseClassification {
  SUSPECT
  PROBABLE
  CONFIRMED
  NOT_A_CASE
}

/// Type de preuve biologique documentée à la revue.
enum MsppLabEvidenceType {
  NONE
  PCR
  RAPID_ANTIGEN
  CULTURE
  SEROLOGY
  OTHER
}

/// MSPP-style review record. Phase 1: optional `diseaseCaseReportId` without FK to `DiseaseCaseReport` until relations are confirmed.
model DiseaseCaseReview {
  id                       String                  @id @default(uuid())
  diseaseCaseReportId      String?
  reviewerUserId           String?
  status                   String
  reviewerLevel            String
  departmentId             String
  notes                    String?
  reviewedAt               DateTime?
  /// Dernière décision : critère structuré — présence de fièvre (oui/non).
  validationFever          Boolean?
  /// Durée des signes ou de l’épisode (texte court).
  validationDuration       String?
  /// Confirmation biologique (oui/non).
  validationLabConfirmed   Boolean?
  /// Risque d’exposition : LOW | MEDIUM | HIGH | UNKNOWN.
  validationExposureRisk   String?
  /// Classification épidémiologique du cas (revue structurée).
  caseClassification       MsppCaseClassification?
  inclusionCriteriaSummary String?                 @db.Text
  exclusionCriteriaSummary String?                 @db.Text
  symptomOnsetDate         DateTime?
  hospitalized             Boolean?
  outcomeStatus            String?                 @db.VarChar(128)
  labEvidenceType          MsppLabEvidenceType?
  epiLinkedCase            Boolean?
  travelOrExposureContext  String?                 @db.Text
  finalDecisionRationale   String?                 @db.Text
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  auditEvents   MsppReviewAuditEvent[]
  msppFeedbacks MsppDiseaseReportFeedback[]

  @@unique([diseaseCaseReportId])
  @@index([reviewerUserId])
  @@index([departmentId])
}

/// Immutable MSPP validation/review events (append-only; complements `notes` on DiseaseCaseReview).
model MsppReviewAuditEvent {
  id                  String   @id @default(uuid())
  diseaseCaseReviewId String
  diseaseCaseReportId String?
  /// e.g. DEPARTMENT_APPROVE, CENTRAL_REQUEUE — see `mspp.constants` / app layer.
  action              String
  reviewerUserId      String
  /// DEPARTMENT | CENTRAL — niveau de la décision ou de la file concernée.
  reviewerLevel       String
  statusBefore        String?
  statusAfter         String?
  requeued            Boolean  @default(false)
  criteriaSnapshot    Json?
  createdAt           DateTime @default(now())

  diseaseCaseReview DiseaseCaseReview @relation(fields: [diseaseCaseReviewId], references: [id], onDelete: Cascade)
  reviewer          User              @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([diseaseCaseReviewId])
  @@index([diseaseCaseReportId])
  @@index([createdAt])
}

/// Haiti national geographic department (département).
model GeoDepartment {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  sortOrder Int?
  communes  GeoCommune[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Commune within a geographic department.
model GeoCommune {
  id                 String              @id @default(uuid())
  geoDepartmentId    String
  department         GeoDepartment       @relation(fields: [geoDepartmentId], references: [id], onDelete: Restrict)
  code               String?
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  diseaseCaseReports DiseaseCaseReport[]

  @@unique([geoDepartmentId, name])
  @@index([geoDepartmentId])
  @@index([name])
}

/// Internal handling state for national escalation rows (not disease validation).
enum MsppAlertTriageStatus {
  NEW
  ACKNOWLEDGED
  UNDER_REVIEW
  ESCALATED_INTERNAL
  CLOSED
}

/// Per-window triage for computed MSPP escalation rows (`alertKey` from `computeMsppAlertKey`).
model MsppAlertTriage {
  id                   String                @id @default(uuid())
  alertKey             String                @unique
  windowCurrentStart   DateTime
  windowCurrentEnd     DateTime
  scope                String
  escalationLevel      String
  diseaseCode          String
  departmentId         String
  geoCommuneId         String?
  triageStatus         MsppAlertTriageStatus @default(NEW)
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  assignedToUserId     String?
  triageNote           String?               @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  acknowledgedBy User?                   @relation("MsppAlertTriageAckBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  assignedTo     User?                   @relation("MsppAlertTriageAssignTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  investigation  MsppAlertInvestigation?

  @@index([triageStatus])
  @@index([departmentId])
  @@index([updatedAt])
}

/// Suivi opérationnel interne lié à une alerte d’escalade (pas déclaration d’épidémie ; distinct du triage).
enum MsppAlertInvestigationStatus {
  OPEN
  FIELD_VERIFICATION
  LAB_FOLLOWUP
  COORDINATION_ACTIVE
  CLOSED
}

enum MsppAlertInvestigationEventAction {
  OPENED
  STATUS_CHANGED
  NOTE_ADDED
  ASSIGNED
}

model MsppAlertInvestigation {
  id                  String                       @id @default(uuid())
  alertKey            String                       @unique
  msppAlertTriageId   String?                      @unique
  diseaseCode         String
  escalationLevel     String
  departmentId        String
  geoCommuneId        String?
  investigationStatus MsppAlertInvestigationStatus @default(OPEN)
  openedAt            DateTime                     @default(now())
  openedByUserId      String
  assignedToUserId    String?
  summary             String?                      @db.Text
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  msppAlertTriage MsppAlertTriage?              @relation(fields: [msppAlertTriageId], references: [id], onDelete: SetNull)
  openedBy        User                          @relation("MsppAlertInvestigationOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedTo      User?                         @relation("MsppAlertInvestigationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  events          MsppAlertInvestigationEvent[]

  @@index([investigationStatus])
  @@index([departmentId])
  @@index([updatedAt])
}

model MsppAlertInvestigationEvent {
  id               String                            @id @default(uuid())
  investigationId  String
  action           MsppAlertInvestigationEventAction
  note             String?                           @db.Text
  statusBefore     MsppAlertInvestigationStatus?
  statusAfter      MsppAlertInvestigationStatus?
  assignedToUserId String?
  createdByUserId  String
  createdAt        DateTime                          @default(now())

  investigation MsppAlertInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("MsppAlertInvestigationEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([investigationId, createdAt])
}

/// Structured quality feedback from MSPP to facilities (does not mutate the declaration).
enum MsppDiseaseReportFeedbackCategory {
  GEO_INCOMPLETE
  CLINICAL_INCOMPLETE
  LAB_MISSING
  CODE_VERIFY
  DUPLICATE_SUSPECTED
  DATA_INCONSISTENT
  OTHER
}

enum MsppDiseaseReportFeedbackSeverity {
  INFO
  WARNING
  ACTION_REQUIRED
}

enum MsppDiseaseReportFeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model MsppDiseaseReportFeedback {
  id                       String                            @id @default(uuid())
  diseaseCaseReportId      String
  diseaseCaseReviewId      String?
  category                 MsppDiseaseReportFeedbackCategory
  severity                 MsppDiseaseReportFeedbackSeverity
  feedbackText             String                            @db.Text
  status                   MsppDiseaseReportFeedbackStatus   @default(OPEN)
  createdByUserId          String
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  facilityReviewedAt       DateTime?
  facilityReviewedByUserId String?
  resolvedAt               DateTime?
  resolvedByUserId         String?

  report             DiseaseCaseReport  @relation(fields: [diseaseCaseReportId], references: [id], onDelete: Restrict)
  review             DiseaseCaseReview? @relation(fields: [diseaseCaseReviewId], references: [id], onDelete: SetNull)
  createdBy          User               @relation("MsppDiseaseReportFeedbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  facilityReviewedBy User?              @relation("MsppDiseaseReportFeedbackFacilityReviewedBy", fields: [facilityReviewedByUserId], references: [id], onDelete: SetNull)
  resolvedBy         User?              @relation("MsppDiseaseReportFeedbackResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([diseaseCaseReportId])
  @@index([status])
  @@index([severity])
}

/// National MSPP access (not tied to facility `UserRole`). For `MSPP_VALIDATOR_DEPT`: either `geoDepartmentId` or `allGeoDepartments`.
model MsppUserRoleAssignment {
  id                String       @id @default(uuid())
  userId            String
  role              MsppRoleCode
  geoDepartmentId   String?
  /// When true with `MSPP_VALIDATOR_DEPT`, user may act on every geographic department (national dept-level scope).
  allGeoDepartments Boolean      @default(false)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([geoDepartmentId])
  @@index([userId, role])
  @@index([userId, role, allGeoDepartments])
}

/// Per-facility monotonic sequences for X12 control numbers (ISA / GS / ST, etc.).
model ClaimControlCounter {
  id         String   @id @default(cuid())
  facilityId String
  /// ISA | GS | ST — extensible string discriminator
  type       String
  lastValue  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, type])
}

/// One interchange envelope batch (ISA/IEA) — may contain multiple GS groups / ST sets.
model ClaimSubmissionBatch {
  id                 String   @id @default(cuid())
  facilityId         String
  interchangeCtrl    String
  groupCtrl          String
  senderId           String?
  receiverId         String?
  /// Full interchange text (ISA…IEA) for audit; optional if generation failed mid-flight.
  interchangeX12Text String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  facility        Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  submissions     ClaimSubmission[]
  acknowledgments ClaimAcknowledgment[]

  @@index([facilityId])
  @@index([interchangeCtrl])
}

/// One persisted 837 transaction artifact tied to an encounter package side.
model ClaimSubmission {
  id                String                @id @default(cuid())
  facilityId        String
  encounterId       String
  claimType         ClaimSubmissionKind
  status            ClaimSubmissionStatus @default(DRAFT)
  batchId           String?
  transactionCtrl   String?
  /// Transaction-local ST…SE text (this claim only).
  x12Text           String?               @db.Text
  exportJson        Json?
  warningsJson      Json?
  missingFieldsJson Json?
  externalReference String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  batch             ClaimSubmissionBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  facility          Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter         Encounter                @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  attempts          ClaimSubmissionAttempt[]
  acknowledgments   ClaimAcknowledgment[]
  operationalEvents ClaimOperationalEvent[]

  @@index([encounterId])
  @@index([facilityId, status])
  @@index([batchId])
  @@index([claimType])
}

/// Transmission attempts for one submission (manual/stub transport audit trail).
model ClaimSubmissionAttempt {
  id               String    @id @default(cuid())
  submissionId     String
  transport        String
  ok               Boolean
  requestMetaJson  Json?
  responseMetaJson Json?
  errorMessage     String?
  /// Phase 6.6 — operational classification (e.g. same as errorMessage or normalized token).
  failureCode      String?
  retryEligible    Boolean   @default(false)
  nextRetryAt      DateTime?
  createdAt        DateTime  @default(now())

  submission ClaimSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([retryEligible, nextRetryAt])
}

/// Persisted clearinghouse acknowledgments (999/277CA) including unmatched rows.
model ClaimAcknowledgment {
  id           String   @id @default(cuid())
  facilityId   String
  submissionId String?
  batchId      String?
  kind         String
  rawText      String   @db.Text
  parsedJson   Json?
  statusCode   String?
  message      String?
  warningCode  String?
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  facility   Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  submission ClaimSubmission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  batch      ClaimSubmissionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([facilityId, receivedAt])
  @@index([submissionId])
  @@index([batchId])
  @@index([kind])
}

/// Inbound ACK payloads that failed validation/parse — preserved for operator replay (Phase 6.6).
model ClaimAcknowledgmentDeadLetter {
  id              String    @id @default(cuid())
  facilityId      String
  rawText         String    @db.Text
  source          String
  failureCode     String
  failureDetail   String?   @db.Text
  vendorMeta      Json?
  replayedAt      DateTime?
  replayedToAckId String?
  createdAt       DateTime  @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@index([facilityId, replayedAt])
}

/// Phase 8.2 — append-only clearinghouse / claim operational audit (durable observability).
model ClaimOperationalEvent {
  id           String               @id @default(cuid())
  facilityId   String
  encounterId  String?
  submissionId String?
  batchId      String?
  eventType    String
  eventAt      DateTime             @default(now())
  claimType    ClaimSubmissionKind?
  statusBefore String?
  statusAfter  String?
  reasonCode   String?
  message      String?              @db.Text
  metadataJson Json?

  facility   Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  submission ClaimSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([facilityId, eventAt])
  @@index([submissionId, eventAt])
  @@index([facilityId, eventType, eventAt])
  @@index([encounterId, eventAt])
}
