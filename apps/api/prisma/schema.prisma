  updatedAt           DateTime          @updatedAt
  facility            Facility          @relation(fields: [facilityId], references: [id])
  inventoryItem       InventoryItem?    @relation(fields: [inventoryItemId], references: [id])
  package             MedicationPackage @relation(fields: [packageId], references: [id])

  @@unique([facilityId, packageId])
  @@index([facilityId])
  @@index([packageId])
  @@index([inventoryItemId])
  @@index([isEDFormulary])
  @@index([favoriteTier])
}

model MedicationBillingProfile {
  id                             String            @id @default(uuid())
  packageId                      String
  payerProfileId                 String?           @db.VarChar(64)
  hcpcsCodeSuggested             String?           @db.VarChar(16)
  hcpcsUnitType                  String?           @db.VarChar(32)
  revenueCodeSuggested           String?           @db.VarChar(16)
  billableUnitRule               String?           @db.VarChar(32)
  companionProcedureCptSuggested String?           @db.VarChar(16)
  wastageBillable                Boolean           @default(false)
  requiresManualReview           Boolean           @default(true)
  mappingStatus                  String            @default("CANDIDATE") @db.VarChar(32)
