  mappingCandidates       RxNormMappingCandidate[]
  verifiedMappings        RxNormVerifiedMapping[]
  conflicts               RxNormImportConflict[]

  @@unique([releaseId, rowChecksum])
  @@index([releaseId, rxcui])
  @@index([rxcui, termType])
  @@index([normalizedTerm])
  @@index([validationStatus])
}

model RxNormMappingCandidate {
  id                           String                   @id @default(uuid())
  releaseId                    String
  stagingConceptId             String
  targetKind                   String                   @db.VarChar(32)
  targetId                     String
  targetCode                   String?                  @db.VarChar(128)
  status                       String                   @default("CANDIDATE") @db.VarChar(32)
  confidence                   String?                  @db.VarChar(16)
  evidenceJson                 Json
  autoVerified                 Boolean                  @default(false)
  reviewVersion                Int                      @default(0)
  rejectionReasonCategory      String?                  @db.VarChar(48)
  conflictOverrideAcknowledged Boolean                  @default(false)
  conflictOverrideReasons      Json?
  decisionEvidenceJson         Json?
  verifiedMappingId            String?                  @unique
  reviewedAt                   DateTime?
  reviewedByUserId             String?
  reviewNotes                  String?
  /// Phase 6 — reviewer work-queue assignment (non-clinical).
  assignedToUserId             String?
  assignedAt                   DateTime?
  reviewStartedAt              DateTime?
  deferredAt                   DateTime?
  deferredReason               String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  release                      RxNormReferenceRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  stagingConcept               RxNormStagingConcept     @relation(fields: [stagingConceptId], references: [id], onDelete: Cascade)
  reviewedBy                   User?                    @relation("RxNormMappingCandidateReviewedBy", fields: [reviewedByUserId], references: [id])
  assignedTo                   User?                    @relation("RxNormMappingCandidateAssignedTo", fields: [assignedToUserId], references: [id])
  verifiedMapping              RxNormVerifiedMapping?   @relation(fields: [verifiedMappingId], references: [id])
  reviewAuditEvents            RxNormReviewAuditEvent[]

  @@unique([stagingConceptId, targetKind, targetId])
  @@index([releaseId])
  @@index([status])
  @@index([targetKind, targetId])
  @@index([verifiedMappingId])
  @@index([assignedToUserId])
}

/// Phase 6 — deterministic RxNorm review audit trail (governance only; not clinical).
model RxNormReviewAuditEvent {
  id               String                 @id @default(uuid())
