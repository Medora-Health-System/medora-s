  @@index([facilityId])
  @@index([correctedByUserId])
  @@index([status])
  @@index([createdAt])
  @@index([medicationAdministrationId], map: "MedicationAdministrationCorrection_medicationAdministrationId_i")
}

/// M1.3F.1 — pharmacy verification queue state per order line (not enforced at runtime).
