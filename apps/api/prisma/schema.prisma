  concentrationDenominators  MedicationConcentration[]         @relation("MedicationConcentrationDenominatorUnit")
  concentrationNumerators    MedicationConcentration[]         @relation("MedicationConcentrationNumeratorUnit")
  concentrationTotalVolumes  MedicationConcentration[]         @relation("MedicationConcentrationTotalVolumeUnit")
  packageContentsUnits       MedicationPackage[]               @relation("MedicationPackageContentsUnit")
