  evidenceJson     Json?
  createdAt        DateTime               @default(now())
  candidate        RxNormMappingCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  actor            User?                  @relation("RxNormReviewAuditEventActor", fields: [actorUserId], references: [id])

  @@index([candidateId])
  @@index([verifiedMappingId])
  @@index([action])
  @@index([actorUserId])
  @@index([createdAt])
}

/// Phase 6.5 — governed Emergency Medicine controlled pilot manifest.
model MedicationPilotManifest {
  id                         String   @id @default(uuid())
  pilotId                    String   @unique @db.VarChar(64)
