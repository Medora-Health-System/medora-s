  /// DEPARTMENT | CENTRAL — niveau de la décision ou de la file concernée.
  reviewerLevel       String
  statusBefore        String?
  statusAfter         String?
  requeued            Boolean           @default(false)
  criteriaSnapshot    Json?
  createdAt           DateTime          @default(now())
  diseaseCaseReview   DiseaseCaseReview @relation(fields: [diseaseCaseReviewId], references: [id], onDelete: Cascade)
  reviewer            User              @relation(fields: [reviewerUserId], references: [id])

  @@index([diseaseCaseReviewId])
  @@index([diseaseCaseReportId])
  @@index([createdAt])
}

/// Haiti national geographic department (département).
model GeoDepartment {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  sortOrder Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  communes  GeoCommune[]
}

/// Commune within a geographic department.
model GeoCommune {
  id                 String              @id @default(uuid())
  geoDepartmentId    String
  code               String?
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  diseaseCaseReports DiseaseCaseReport[]
  department         GeoDepartment       @relation(fields: [geoDepartmentId], references: [id])

  @@unique([geoDepartmentId, name])
  @@index([geoDepartmentId])
  @@index([name])
}

/// Per-window triage for computed MSPP escalation rows (`alertKey` from `computeMsppAlertKey`).
model MsppAlertTriage {
  id                   String                  @id @default(uuid())
  alertKey             String                  @unique
  windowCurrentStart   DateTime
  windowCurrentEnd     DateTime
  scope                String
  escalationLevel      String
  diseaseCode          String
  departmentId         String
  geoCommuneId         String?
  triageStatus         MsppAlertTriageStatus   @default(NEW)
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  assignedToUserId     String?
  triageNote           String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  investigation        MsppAlertInvestigation?
  acknowledgedBy       User?                   @relation("MsppAlertTriageAckBy", fields: [acknowledgedByUserId], references: [id])
  assignedTo           User?                   @relation("MsppAlertTriageAssignTo", fields: [assignedToUserId], references: [id])

  @@index([triageStatus])
  @@index([departmentId])
  @@index([updatedAt])
}

model MsppAlertInvestigation {
  id                  String                        @id @default(uuid())
  alertKey            String                        @unique
  msppAlertTriageId   String?                       @unique
  diseaseCode         String
  escalationLevel     String
  departmentId        String
  geoCommuneId        String?
  investigationStatus MsppAlertInvestigationStatus  @default(OPEN)
  openedAt            DateTime                      @default(now())
  openedByUserId      String
  assignedToUserId    String?
  summary             String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  assignedTo          User?                         @relation("MsppAlertInvestigationAssignedTo", fields: [assignedToUserId], references: [id])
  msppAlertTriage     MsppAlertTriage?              @relation(fields: [msppAlertTriageId], references: [id])
  openedBy            User                          @relation("MsppAlertInvestigationOpenedBy", fields: [openedByUserId], references: [id])
  events              MsppAlertInvestigationEvent[]

  @@index([investigationStatus])
  @@index([departmentId])
  @@index([updatedAt])
}

model MsppAlertInvestigationEvent {
  id               String                            @id @default(uuid())
  investigationId  String
  action           MsppAlertInvestigationEventAction
  note             String?
  statusBefore     MsppAlertInvestigationStatus?
  statusAfter      MsppAlertInvestigationStatus?
  assignedToUserId String?
  createdByUserId  String
  createdAt        DateTime                          @default(now())
  createdBy        User                              @relation("MsppAlertInvestigationEventCreatedBy", fields: [createdByUserId], references: [id])
  investigation    MsppAlertInvestigation            @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
}

model MsppDiseaseReportFeedback {
  id                       String                            @id @default(uuid())
  diseaseCaseReportId      String
  diseaseCaseReviewId      String?
  category                 MsppDiseaseReportFeedbackCategory
  severity                 MsppDiseaseReportFeedbackSeverity
  feedbackText             String
  status                   MsppDiseaseReportFeedbackStatus   @default(OPEN)
  createdByUserId          String
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  facilityReviewedAt       DateTime?
  facilityReviewedByUserId String?
  resolvedAt               DateTime?
  resolvedByUserId         String?
  createdBy                User                              @relation("MsppDiseaseReportFeedbackCreatedBy", fields: [createdByUserId], references: [id])
  report                   DiseaseCaseReport                 @relation(fields: [diseaseCaseReportId], references: [id])
  review                   DiseaseCaseReview?                @relation(fields: [diseaseCaseReviewId], references: [id])
  facilityReviewedBy       User?                             @relation("MsppDiseaseReportFeedbackFacilityReviewedBy", fields: [facilityReviewedByUserId], references: [id])
  resolvedBy               User?                             @relation("MsppDiseaseReportFeedbackResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([diseaseCaseReportId])
  @@index([status])
  @@index([severity])
}

/// National MSPP access (not tied to facility `UserRole`). For `MSPP_VALIDATOR_DEPT`: either `geoDepartmentId` or `allGeoDepartments`.
model MsppUserRoleAssignment {
  id                String       @id @default(uuid())
  userId            String
  role              MsppRoleCode
  geoDepartmentId   String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  /// When true with `MSPP_VALIDATOR_DEPT`, user may act on every geographic department (national dept-level scope).
  allGeoDepartments Boolean      @default(false)
  user              User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([geoDepartmentId])
  @@index([userId, role])
  @@index([userId, role, allGeoDepartments])
}

/// Per-facility monotonic sequences for X12 control numbers (ISA / GS / ST, etc.).
model ClaimControlCounter {
  id         String   @id @default(cuid())
  facilityId String
  /// ISA | GS | ST — extensible string discriminator
  type       String
  lastValue  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  facility   Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, type])
}

/// One interchange envelope batch (ISA/IEA) — may contain multiple GS groups / ST sets.
model ClaimSubmissionBatch {
  id                 String                @id @default(cuid())
  facilityId         String
  interchangeCtrl    String
  groupCtrl          String
  senderId           String?
  receiverId         String?
  /// Full interchange text (ISA…IEA) for audit; optional if generation failed mid-flight.
  interchangeX12Text String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  acknowledgments    ClaimAcknowledgment[]
  submissions        ClaimSubmission[]
  facility           Facility              @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([interchangeCtrl])
}

/// One persisted 837 transaction artifact tied to an encounter package side.
model ClaimSubmission {
  id                String                   @id @default(cuid())
  facilityId        String
  encounterId       String
  claimType         ClaimSubmissionKind
  status            ClaimSubmissionStatus    @default(DRAFT)
  batchId           String?
  transactionCtrl   String?
  /// Transaction-local ST…SE text (this claim only).
  x12Text           String?
  exportJson        Json?
  warningsJson      Json?
  missingFieldsJson Json?
  externalReference String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  acknowledgments   ClaimAcknowledgment[]
  operationalEvents ClaimOperationalEvent[]
  batch             ClaimSubmissionBatch?    @relation(fields: [batchId], references: [id])
  encounter         Encounter                @relation(fields: [encounterId], references: [id])
  facility          Facility                 @relation(fields: [facilityId], references: [id])
  attempts          ClaimSubmissionAttempt[]

  @@index([encounterId])
  @@index([facilityId, status])
  @@index([batchId])
  @@index([claimType])
}

/// Transmission attempts for one submission (manual/stub transport audit trail).
model ClaimSubmissionAttempt {
  id               String          @id @default(cuid())
  submissionId     String
  transport        String
  ok               Boolean
  requestMetaJson  Json?
  responseMetaJson Json?
  errorMessage     String?
  createdAt        DateTime        @default(now())
  /// Phase 6.6 — operational classification (e.g. same as errorMessage or normalized token).
  failureCode      String?
  retryEligible    Boolean         @default(false)
  nextRetryAt      DateTime?
  submission       ClaimSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([retryEligible, nextRetryAt])
}

/// Persisted clearinghouse acknowledgments (999/277CA) including unmatched rows.
model ClaimAcknowledgment {
  id           String                @id @default(cuid())
  facilityId   String
  submissionId String?
  batchId      String?
  kind         String
  rawText      String
  parsedJson   Json?
  statusCode   String?
  message      String?
  warningCode  String?
  receivedAt   DateTime              @default(now())
  createdAt    DateTime              @default(now())
  batch        ClaimSubmissionBatch? @relation(fields: [batchId], references: [id])
  facility     Facility              @relation(fields: [facilityId], references: [id])
  submission   ClaimSubmission?      @relation(fields: [submissionId], references: [id])

  @@index([facilityId, receivedAt])
  @@index([submissionId])
  @@index([batchId])
  @@index([kind])
}

/// Inbound ACK payloads that failed validation/parse — preserved for operator replay (Phase 6.6).
model ClaimAcknowledgmentDeadLetter {
  id              String    @id @default(cuid())
  facilityId      String
  rawText         String
  source          String
  failureCode     String
  failureDetail   String?
  vendorMeta      Json?
  replayedAt      DateTime?
  replayedToAckId String?
  createdAt       DateTime  @default(now())
  facility        Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@index([facilityId, replayedAt])
}

/// Phase 8.2 — append-only clearinghouse / claim operational audit (durable observability).
model ClaimOperationalEvent {
  id           String               @id @default(cuid())
  facilityId   String
  encounterId  String?
  submissionId String?
  batchId      String?
  eventType    String
  eventAt      DateTime             @default(now())
  claimType    ClaimSubmissionKind?
  statusBefore String?
  statusAfter  String?
  reasonCode   String?
  message      String?
  metadataJson Json?
  facility     Facility             @relation(fields: [facilityId], references: [id])
  submission   ClaimSubmission?     @relation(fields: [submissionId], references: [id])

  @@index([facilityId, eventAt])
  @@index([submissionId, eventAt])
  @@index([facilityId, eventType, eventAt])
  @@index([encounterId, eventAt])
}

/// Phase 14G-A — non-clinical platform announcements (no PHI; not patient-scoped).
model PlatformAnnouncement {
  id               String                                @id @default(cuid())
  title            String
  body             String
  severity         String?
  versionKey       String                                @unique
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean                               @default(true)
  createdByUserId  String?
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @default(now()) @updatedAt
  createdBy        User?                                 @relation("PlatformAnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  acknowledgements PlatformAnnouncementAcknowledgement[]

  @@index([isActive, startsAt, expiresAt, createdAt])
}

model PlatformAnnouncementAcknowledgement {
  id             String               @id @default(cuid())
  announcementId String
  userId         String
  acknowledgedAt DateTime             @default(now())
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

