  findingsSuppressed          Int      @default(0)
  findingsDeduplicated        Int      @default(0)
  errorsJson                  Json?
  engineVersion               String   @db.VarChar(64)
  correlationId               String?  @db.VarChar(128)
  durationMs                  Int?
  knowledgeRetrievalMs        Int?
  ruleEvaluationMs            Int?
  findingPersistenceMs        Int?
