  code      String       @unique
  name      String
  sortOrder Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  communes  GeoCommune[]
}

/// Commune within a geographic department.
model GeoCommune {
  id                 String              @id @default(uuid())
