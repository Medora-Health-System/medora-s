model MedicationDispense {
  id                    String             @id @default(uuid())
  patientId             String
  encounterId           String
  facilityId            String
  /// Null si dispensation liée à une ligne d’ordonnance sans entrée catalogue (saisie manuelle).
  catalogMedicationId   String?
  /// When null, dispense is documentation-only (no stock movement), e.g. ordonnance remise.
  inventoryItemId       String?
  quantityDispensed     Int
  dosageInstructions    String?
  dispensedByUserId     String
  dispensedAt           DateTime           @default(now())
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  orderItemId           String?            @unique
  /// Libellé figé lorsque `catalogMedicationId` est absent (même source que `OrderItem.manualLabel`).
  manualMedicationLabel String?
  /// ER-3: structured dose value for billing-safe medication capture.
  doseValue             Decimal?           @db.Decimal(12, 4)
  /// ER-3: structured dose unit (mg, mL, unit, each, etc.).
  doseUnit              String?            @db.VarChar(32)
  /// ER-3: billing quantity snapshot (can differ from quantityDispensed in future payer logic).
  billingQuantity       Decimal?           @db.Decimal(12, 4)
  /// ER-3: quantity unit (tablet, mL, vial, each, etc.).
  quantityUnit          String?            @db.VarChar(32)
  /// ER-3: normalized NDC snapshot at dispense time (11 digits), optional.
  ndc11Snapshot         String?            @db.VarChar(11)
  /// ER-3: human display NDC snapshot (hyphenated), optional.
  ndcDisplaySnapshot    String?            @db.VarChar(32)
  /// Phase 19B.1 — future dual-write to canonical package (nullable; not populated in this phase).
  medicationPackageId   String?
  /// Phase 19B.1 — future dual-write to canonical product (nullable; not populated in this phase).
  medicationProductId   String?
  catalogMedication     CatalogMedication? @relation(fields: [catalogMedicationId], references: [id], onDelete: Restrict)
  dispensedBy           User               @relation(fields: [dispensedByUserId], references: [id])
  encounter             Encounter          @relation(fields: [encounterId], references: [id])
  facility              Facility           @relation(fields: [facilityId], references: [id])
  inventoryItem         InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  medicationPackage     MedicationPackage? @relation(fields: [medicationPackageId], references: [id])
  medicationProduct     MedicationProduct? @relation(fields: [medicationProductId], references: [id])
  orderItem             OrderItem?         @relation(fields: [orderItemId], references: [id])
  patient               Patient            @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([encounterId])
  @@index([facilityId])
  @@index([inventoryItemId])
  @@index([medicationProductId])
  @@index([medicationPackageId])
  @@index([dispensedAt])
  @@index([ndc11Snapshot])
}

/// Append-only bedside medication administrations (MAR log); does not replace OrderItem lifecycle.
model MedicationAdministration {
  id                                 String                                 @id @default(uuid())
  facilityId                         String
  patientId                          String
  encounterId                        String
  orderItemId                        String?
  administeredAt                     DateTime                               @default(now())
  administeredByUserId               String
  notes                              String?
  createdAt                          DateTime                               @default(now())
  medicationLabelSnapshot            String?
  /// Route as documented at administration time (e.g. IV, IM, SQ, PO); preferred over catalog for billing CPT inference.
  route                              String?
  /// ER-3: structured dose value documented at administration.
  doseValue                          Decimal?                               @db.Decimal(12, 4)
  /// ER-3: dose unit (mg, mL, unit, each, etc.).
  doseUnit                           String?                                @db.VarChar(32)
  /// ER-3: administered quantity documented by nurse/provider.
  administeredQuantity               Decimal?                               @db.Decimal(12, 4)
  /// ER-3: quantity captured for billing prep (defaults to administeredQuantity when omitted).
  billingQuantity                    Decimal?                               @db.Decimal(12, 4)
  /// ER-3: quantity unit snapshot.
  quantityUnit                       String?                                @db.VarChar(32)
  /// ER-3: normalized NDC snapshot at administration time (11 digits), optional.
  ndc11Snapshot                      String?                                @db.VarChar(11)
  /// ER-3: display NDC snapshot at administration time, optional.
  ndcDisplaySnapshot                 String?                                @db.VarChar(32)
  /// ER-3.2: primary MAR outcome; null = legacy row (derive from notes only for display).
  marAction                          MedicationMarAction?
  /// Phase 15F-B: corrected clinical administration instant; never overwrites `administeredAt`.
  effectiveAdministeredAt            DateTime?
  effectiveAdministeredAtSetAt       DateTime?
  effectiveAdministeredAtSetByUserId String?
  effectiveAdministeredAtReason      String?
  effectiveAdministeredAtVersion     Int                                    @default(0)
  /// Phase 15F-B.1: infusion START (in-progress) vs STOP (terminal) MAR documentation.
  infusionPhase                      MedicationAdministrationInfusionPhase?
  /// Matches OrderEvent metadata `infusionSessionKey` for the same IV session.
  infusionSessionKey                 String?                                @db.VarChar(64)
  /// Phase 19B.1 — future canonical infusion session (nullable; not wired to runtime yet).
  infusionSessionId                  String?
  /// Phase 19B.1 — future dual-write to canonical package (nullable; not populated in this phase).
  medicationPackageId                String?
  /// Phase 19B.1 — future dual-write to canonical product (nullable; not populated in this phase).
  medicationProductId                String?
  /// M1.8B.7G — future dose-gated MAR linkage (nullable; not read or written at runtime in this phase).
  medicationDoseInstanceId           String?
  administeredBy                     User                                   @relation(fields: [administeredByUserId], references: [id])
  encounter                          Encounter                              @relation(fields: [encounterId], references: [id])
  facility                           Facility                               @relation(fields: [facilityId], references: [id])
  infusionSession                    InfusionSession?                       @relation(fields: [infusionSessionId], references: [id])
  medicationPackage                  MedicationPackage?                     @relation(fields: [medicationPackageId], references: [id])
  medicationProduct                  MedicationProduct?                     @relation(fields: [medicationProductId], references: [id])
  medicationDoseInstance             MedicationDoseInstance?                @relation("MedicationDoseInstanceMar", fields: [medicationDoseInstanceId], references: [id], onDelete: Restrict)
  orderItem                          OrderItem?                             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  patient                            Patient                                @relation(fields: [patientId], references: [id])
  terminalForDoseInstances           MedicationDoseInstance[]               @relation("MedicationDoseInstanceTerminalMar")
  corrections                        MedicationAdministrationCorrection[]
  overrides                          MedicationAdministrationOverride[]
  verifications                      MedicationAdministrationVerification[]
  wasteDocumentations                MedicationWasteDocumentation[]

  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([infusionSessionId])
  @@index([medicationDoseInstanceId])
  @@index([medicationProductId])
  @@index([medicationPackageId])
  @@index([administeredAt])
  @@index([ndc11Snapshot])
  @@index([infusionSessionKey])
}

/// M1.3F.1 — witness, cosign, dual verification, high-alert / LASA checks (not enforced at runtime).
model MedicationAdministrationVerification {
  id                         String                       @id @default(uuid())
  facilityId                 String
  medicationAdministrationId String
  encounterId                String
  orderItemId                String?
  catalogMedicationId        String?
  verificationType           MedicationVerificationType
  verificationStatus         MedicationVerificationStatus @default(PENDING)
  verifierUserId             String
  witnessedByUserId          String?
  reason                     String?
  metadata                   Json?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  catalogMedication          CatalogMedication?           @relation(fields: [catalogMedicationId], references: [id])
  encounter                  Encounter                    @relation(fields: [encounterId], references: [id])
  facility                   Facility                     @relation(fields: [facilityId], references: [id])
  medicationAdministration   MedicationAdministration     @relation(fields: [medicationAdministrationId], references: [id], map: "MedicationAdministrationVerification_medicationAdministrationId")
  orderItem                  OrderItem?                   @relation(fields: [orderItemId], references: [id])
  verifier                   User                         @relation("MedicationAdministrationVerificationVerifier", fields: [verifierUserId], references: [id])
  witnessedBy                User?                        @relation("MedicationAdministrationVerificationWitness", fields: [witnessedByUserId], references: [id])

  @@index([facilityId])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([catalogMedicationId])
  @@index([verificationType])
  @@index([verificationStatus])
  @@index([verifierUserId])
  @@index([witnessedByUserId])
  @@index([createdAt])
  @@index([medicationAdministrationId], map: "MedAdminVerification_medAdminId_idx")
}

/// M1.3F.1 — controlled-substance and partial-dose waste documentation (not enforced at runtime).
model MedicationWasteDocumentation {
  id                         String                   @id @default(uuid())
  facilityId                 String
  medicationAdministrationId String
  encounterId                String
  orderItemId                String?
  catalogMedicationId        String?
  wastedAmount               Decimal                  @db.Decimal(12, 4)
  wastedUnit                 String                   @db.VarChar(32)
  wasteReason                String?
  witnessUserId              String?
  documentedByUserId         String
  status                     MedicationWasteStatus    @default(DRAFT)
  metadata                   Json?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  catalogMedication          CatalogMedication?       @relation(fields: [catalogMedicationId], references: [id])
  documentedBy               User                     @relation("MedicationWasteDocumentedBy", fields: [documentedByUserId], references: [id])
  encounter                  Encounter                @relation(fields: [encounterId], references: [id])
  facility                   Facility                 @relation(fields: [facilityId], references: [id])
  medicationAdministration   MedicationAdministration @relation(fields: [medicationAdministrationId], references: [id])
  orderItem                  OrderItem?               @relation(fields: [orderItemId], references: [id])
  witness                    User?                    @relation("MedicationWasteWitness", fields: [witnessUserId], references: [id])

  @@index([facilityId])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([medicationAdministrationId])
  @@index([catalogMedicationId])
  @@index([status])
  @@index([documentedByUserId])
  @@index([witnessUserId])
  @@index([createdAt])
