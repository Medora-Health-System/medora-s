  /// MANUAL_ADMIN_TEST | ORDER_DRAFT_SHADOW | ORDER_SIGN_SHADOW | ...
  triggerType                 String   @db.VarChar(48)
  /// DISABLED | SHADOW
  operatingMode               String   @db.VarChar(16)
  /// QUEUED | RUNNING | COMPLETED | COMPLETED_WITH_WARNINGS | FAILED | CANCELLED
  status                      String   @default("QUEUED") @db.VarChar(32)
