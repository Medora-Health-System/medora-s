  status             String   @default("DRAFT") @db.VarChar(32)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  source             MedicationSafetyKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
