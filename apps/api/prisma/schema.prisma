/// Enterprise-wide document storage for all Medora modules (registration, ED, billing, etc.).
model EnterpriseDocument {
  id             String    @id @default(uuid())
  patientId      String?
  encounterId    String?
  facilityId     String?
  category       String
  type           String
  status         String    @default("ACTIVE")
  title          String?
  fileName       String
  mimeType       String
  fileSize       Int
  storagePath    String
  checksumSha256 String?
  pageCount      Int?
  source         String?
  notes          String?
  uploadedById   String?
  uploadedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  signatureStatus String?
  lockedAt        DateTime?
  lockedById      String?

  patient    Patient?   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  facility   Facility?  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  uploadedBy User?      @relation("EnterpriseDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  lockedBy   User?      @relation("EnterpriseDocumentLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  signatures EnterpriseDocumentSignature[]
  blob       EnterpriseDocumentBlob?
  packetSource EnterpriseDocumentPacketSource?

  @@index([patientId])
  @@index([encounterId])
  @@index([facilityId])
  @@index([category])
  @@index([type])
  @@index([status])
  @@index([uploadedAt])
  @@index([signatureStatus])
}

model EnterpriseDocumentSignature {
  id             String   @id @default(uuid())
  documentId     String
  signerType     String
  signerName     String
  signerRole     String?
  relationship   String?
  signedAt       DateTime @default(now())
  signatureData  Json
  attestation    String?
  ipAddress      String?
  userAgent      String?
  signedByUserId String?
  createdAt      DateTime @default(now())

  document     EnterpriseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signedByUser User?              @relation("EnterpriseDocSignatureUser", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([signerType])
  @@index([signedAt])
}

model EnterpriseDocumentBlob {
  id         String   @id @default(uuid())
  documentId String   @unique
  data       Bytes
  createdAt  DateTime @default(now())

  document EnterpriseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model EnterpriseDocumentPacketSource {
  id                 String    @id @default(uuid())
  documentId         String    @unique
  packetType         String
  packetVersion      String    @default("1.0")
  locale             String    @default("en")
  facilityId         String?
  patientId          String?
  encounterId        String?
  /// Optional link to published enterprise template version (back-compat packets may be null).
  templateVersionId  String?
  sourceJson         Json
  sourceHashSha256   String?
  renderedHashSha256 String?
  generatedAt        DateTime  @default(now())
  finalizedAt        DateTime?
  createdById        String?

  document         EnterpriseDocument               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  facility         Facility?                        @relation("PacketSourceFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  patient          Patient?                         @relation("PacketSourcePatient", fields: [patientId], references: [id], onDelete: SetNull)
  encounter        Encounter?                       @relation("PacketSourceEncounter", fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy        User?                            @relation("PacketSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  templateVersion  RegistrationPacketTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  answers          RegistrationPacketAnswer[]

  @@index([packetType])
  @@index([patientId])
  @@index([facilityId])
  @@index([generatedAt])
  @@index([templateVersionId])
}

/// Enterprise registration packet template catalog (configurable; not hard-coded React).
model RegistrationPacketTemplate {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  /// FacilityType scope hint (e.g. FREESTANDING_ER); null = multi-type.
  facilityTypeScope String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions RegistrationPacketTemplateVersion[]
  themes   RegistrationPacketTheme[]
}

model RegistrationPacketTemplateVersion {
  id               String                            @id @default(uuid())
  templateId       String
  version          String
  status           RegistrationPacketTemplateStatus  @default(DRAFT)
  localeDefault    String                            @default("en")
  /// JSON string array, e.g. ["en","fr","es"].
  supportedLocales Json                              @default("[\"en\",\"fr\"]")
  publishedAt      DateTime?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  template     RegistrationPacketTemplate           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sections     RegistrationPacketSection[]
  rules        RegistrationPacketConditionalRule[]
  themes       RegistrationPacketTheme[]
  packetSources EnterpriseDocumentPacketSource[]

  @@unique([templateId, version])
  @@index([status])
}

model RegistrationPacketSection {
  id                String   @id @default(uuid())
  templateVersionId String
  key               String
  sortOrder         Int
  /// Localized titles: { en, fr, es? }.
  titleJson         Json
  helpTextJson      Json?
  /// Concise patient-facing summary: { en, fr, es? }.
  conciseSummaryJson Json?
  /// Full approved legal text for PDF / See more: { en, fr, es? }.
  fullBodyJson       Json?
  sourceLabel        String?
  sourceUrl          String?
  /// FEDERAL | STATE | FACILITY_POLICY | INTERNAL
  authorityType      String?
  /// DRAFT | LEGAL_REVIEW | APPROVED | PUBLISHED | RETIRED
  legalReviewStatus  LegalContentReviewStatus @default(DRAFT)
  legalReviewedBy    String?
  legalReviewedAt    DateTime?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  contentVersion     String?
  acknowledgmentRequired Boolean @default(false)
  acknowledgmentTextJson Json?
  separateSignatureRequired Boolean @default(false)
  /// FULL_BODY | SUMMARY_AND_FULL | SUMMARY_ONLY
  pdfInclusionPolicy String? @default("FULL_BODY")
  /// Extra disclosure metadata (optional JSON).
  disclosureMetaJson Json?
  isRequired        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  templateVersion RegistrationPacketTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  fields          RegistrationPacketField[]
  rules           RegistrationPacketConditionalRule[]

  @@unique([templateVersionId, key])
  @@index([templateVersionId, sortOrder])
  @@index([legalReviewStatus])
}

/// Facility-approved registration disclosure settings (never hard-code in React).
model FacilityRegistrationDisclosureConfig {
  id                 String               @id @default(uuid())
  facilityId         String               @unique
  emtalaApplicability EmtalaApplicability @default(NOT_CONFIGURED)
  medicareParticipation ParticipationStatus @default(NOT_CONFIGURED)
  medicaidParticipation ParticipationStatus @default(NOT_CONFIGURED)
  noSurprisesApplicability Boolean        @default(false)
  nondiscriminationApplicability Boolean  @default(true)
  hospitalAffiliation  String?
  physicianOwnershipJson Json?
  networkDisclosureJson  Json?
  /// Fee/range disclosures only when facility-approved (effective dates inside JSON).
  facilityFeeDisclosureJson Json?
  observationDisclosureJson Json?
  separateBillingEntitiesJson Json?
  privacyOfficerName   String?
  privacyOfficerEmail  String?
  privacyOfficerPhone  String?
  grievanceContactJson Json?
  billingContactJson   Json?
  approvedLegalPacketVersion String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId])
}

model RegistrationPacketField {
  id         String                       @id @default(uuid())
  sectionId  String
  key        String
  fieldType  RegistrationPacketFieldType
  sortOrder  Int
  labelJson  Json?
  helpTextJson Json?
  /// Static localized content (legal text, etc.): { en, fr, es? }.
  contentJson Json?
  optionsJson Json?
  isRequired Boolean                      @default(false)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  section RegistrationPacketSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers RegistrationPacketAnswer[]
  rules   RegistrationPacketConditionalRule[]

  @@unique([sectionId, key])
  @@index([sectionId, sortOrder])
}

model RegistrationPacketConditionalRule {
  id                String   @id @default(uuid())
  templateVersionId String
  sectionId         String?
  fieldId           String?
  name              String
  /// SHOW_IF | HIDE_IF | REQUIRE_IF
  action            String
  /// MINOR | WORKERS_COMP | SELF_PAY | MEDICARE | MEDICAID | TRAUMA | PEDIATRIC | EMERGENCY | URGENT_CARE | FREESTANDING_ER | HOSPITAL | CLINIC
  conditionKey      String
  conditionEquals   Boolean  @default(true)
  expressionJson    Json?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  templateVersion RegistrationPacketTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  section         RegistrationPacketSection?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  field           RegistrationPacketField?          @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([templateVersionId])
  @@index([conditionKey])
}

model RegistrationPacketTheme {
  id                   String   @id @default(uuid())
  templateId           String?
  templateVersionId    String?
  facilityId           String?
  name                 String   @default("default")
  logoUrl              String?
  facilityNameOverride String?
  addressLine          String?
  phone                String?
  footerJson           Json?
  legalNoticesJson     Json?
  brandingJson         Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  template        RegistrationPacketTemplate?        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion RegistrationPacketTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  facility        Facility?                          @relation("RegistrationPacketThemeFacility", fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([templateVersionId])
  @@index([facilityId])
}

/// Patient/staff answers for a generated packet instance — never mutates the template.
model RegistrationPacketAnswer {
  id             String   @id @default(uuid())
  packetSourceId String
  fieldId        String?
  fieldKey       String
  sectionKey     String?
  valueJson      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  packetSource EnterpriseDocumentPacketSource @relation(fields: [packetSourceId], references: [id], onDelete: Cascade)
  field        RegistrationPacketField?       @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@unique([packetSourceId, fieldKey])
  @@index([packetSourceId])
  @@index([fieldId])
}

enum RegistrationPacketTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Legal section / content lifecycle (distinct from template version publish status).
enum LegalContentReviewStatus {
  DRAFT
  LEGAL_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

