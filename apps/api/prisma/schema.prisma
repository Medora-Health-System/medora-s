model MedicationTherapeuticClass {
  id                             String                       @id @default(uuid())
  code                           String                       @unique
  name                           String
  /// Phase 9 — optional terminology metadata (extends existing class identity).
  codeSystem                     String?                      @db.VarChar(64)
  normalizedName                 String?                      @db.VarChar(255)
  displayNameFr                  String?
  description                    String?
  active                         Boolean                      @default(true)
  parentId                       String?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  concepts                       MedicationConcept[]
  safetyProfilesDuplicateTherapy MedicationSafetyProfile[]    @relation("MedicationSafetyDuplicateTherapyClass")
  parent                         MedicationTherapeuticClass?  @relation("MedicationTherapeuticClassHierarchy", fields: [parentId], references: [id])
  children                       MedicationTherapeuticClass[] @relation("MedicationTherapeuticClassHierarchy")
  classMemberships               MedicationTherapeuticClassMembership[]
  drugClassInteractions          MedicationDrugClassInteraction[]
  subjectClassInteractions       MedicationClassInteraction[] @relation("MedicationClassInteractionSubject")
  objectClassInteractions        MedicationClassInteraction[] @relation("MedicationClassInteractionObject")
  allergenMappings               MedicationAllergenMapping[]
  crossReactivityRules           MedicationAllergyCrossReactivityRule[]

  @@index([parentId])
  @@index([active])
  @@index([normalizedName])
}

model MedicationRoute {
  id                   String                             @id @default(uuid())
  code                 String                             @unique
  label                String
  isActive             Boolean                            @default(true)
  sortOrder            Int                                @default(0)
  /// ORAL | INJECTABLE | TOPICAL | INHALED | OTHER
  clinicalCategory     String?                            @db.VarChar(32)
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
  orderSetLinksDefault MedicationOrderSetLink[]
