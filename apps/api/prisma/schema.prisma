  updatedAt            DateTime                @updatedAt
  release              RxNormReferenceRelease  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  stagingConcept       RxNormStagingConcept    @relation(fields: [stagingConceptId], references: [id], onDelete: Cascade)
  verifiedBy           User?                   @relation("RxNormVerifiedMappingVerifiedBy", fields: [verifiedByUserId], references: [id])
  retiredBy            User?                   @relation("RxNormVerifiedMappingRetiredBy", fields: [retiredByUserId], references: [id])
  supersedesMapping    RxNormVerifiedMapping?  @relation("RxNormVerifiedMappingSupersession", fields: [supersedesMappingId], references: [id])
  supersededByRecords  RxNormVerifiedMapping[] @relation("RxNormVerifiedMappingSupersession")
  supersededByMapping  RxNormVerifiedMapping?  @relation("RxNormVerifiedMappingSupersededBy", fields: [supersededByMappingId], references: [id])
  supersedesRecords    RxNormVerifiedMapping[] @relation("RxNormVerifiedMappingSupersededBy")
  linkedCandidate      RxNormMappingCandidate?

  @@index([targetKind, targetId])
  @@index([rxcui])
  @@index([lifecycleStatus])
  @@index([isActive])
  @@index([releaseId])
  @@index([candidateId])
  @@index([stagingConceptId])
}

