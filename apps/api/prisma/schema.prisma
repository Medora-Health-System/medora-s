model PathwaySession {
  id          String        @id @default(uuid())
  encounterId String        @unique
  facilityId  String
  type        PathwayType
  status      PathwayStatus @default(ACTIVE)
  contextJson Json?
  activatedAt DateTime      @default(now())
  pausedAt    DateTime?
  completedAt DateTime?
  activatedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  encounter  Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  facility   Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  milestones PathwayMilestone[]
  orders     Order[]

  @@index([encounterId])
  @@index([facilityId])
  @@index([type])
  @@index([status])
  @@map("PathwaySession")
}

model PathwayMilestone {
  id               String                 @id @default(uuid())
  pathwaySessionId String
  name             String
  description      String?
  targetMinutes    Int // Target time in minutes from activation
  status           PathwayMilestoneStatus @default(PENDING)
  metAt            DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  pathwaySession PathwaySession @relation(fields: [pathwaySessionId], references: [id], onDelete: Cascade)

  @@index([pathwaySessionId])
  @@index([status])
  @@map("PathwayMilestone")
}

model ProtocolOrderSet {
  id          String      @id @default(uuid())
  facilityId  String
  pathwayType PathwayType
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  facility Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  items    ProtocolOrderSetItem[]

  @@unique([facilityId, pathwayType])
  @@index([facilityId])
  @@index([pathwayType])
  @@index([isActive])
  @@map("ProtocolOrderSet")
}

model ProtocolOrderSetItem {
  id                    String        @id @default(uuid())
  protocolOrderSetId    String
  catalogLabTestId      String?
  catalogImagingStudyId String?
  catalogMedicationId   String?
  priority              OrderPriority @default(ROUTINE)
  sequence              Int // Order within the set
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  protocolOrderSet ProtocolOrderSet @relation(fields: [protocolOrderSetId], references: [id], onDelete: Cascade)

  @@index([protocolOrderSetId])
  @@index([sequence])
  @@map("ProtocolOrderSetItem")
}

// --- Medora Core: continuity / diagnoses ---
model Diagnosis {
  id           String          @id @default(uuid())
  patientId    String
  encounterId  String
  facilityId   String
  code         String
  description  String?
  status       DiagnosisStatus @default(ACTIVE)
  onsetDate    DateTime?
  resolvedDate DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility  Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([encounterId])
  @@index([facilityId])
  @@index([status])
  @@index([code])
}

// --- Medora Pharmacy: inventory + dispensing ---
model InventoryItem {
  id                  String    @id @default(uuid())
  facilityId          String
  catalogMedicationId String
  sku                 String
  lotNumber           String?
  expirationDate      DateTime?
  quantityOnHand      Int       @default(0)
  reorderLevel        Int       @default(0)
  unit                String?
  isActive            Boolean   @default(true)
  isFavorite          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  facility            Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  catalogMedication   CatalogMedication      @relation(fields: [catalogMedicationId], references: [id], onDelete: Restrict)
  medicationDispenses MedicationDispense[]
  transactions        InventoryTransaction[]

  @@unique([facilityId, sku])
  @@index([facilityId])
  @@index([catalogMedicationId])
  @@index([isActive])
  @@index([isFavorite])
}

model FacilityMedicationUsage {
  id                  String   @id @default(uuid())
  facilityId          String
  catalogMedicationId String
  inventoryAddsCount  Int      @default(0)
  dispenseCount       Int      @default(0)
  lastUsedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  facility          Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  catalogMedication CatalogMedication @relation(fields: [catalogMedicationId], references: [id], onDelete: Cascade)

  @@unique([facilityId, catalogMedicationId])
  @@index([facilityId, lastUsedAt])
  @@index([facilityId, dispenseCount])
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  inventoryItemId   String
  facilityId        String
  type              InventoryTransactionType
  quantity          Int
  performedByUserId String
  patientId         String?
  encounterId       String?
  notes             String?
  createdAt         DateTime                 @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  facility      Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  performedBy   User          @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([facilityId])
  @@index([type])
  @@index([createdAt])
}

model MedicationDispense {
  id                  String   @id @default(uuid())
  patientId           String
  encounterId         String
  facilityId          String
  /// Null si dispensation liée à une ligne d’ordonnance sans entrée catalogue (saisie manuelle).
  catalogMedicationId String?
  /// Libellé figé lorsque `catalogMedicationId` est absent (même source que `OrderItem.manualLabel`).
  manualMedicationLabel String?
  /// When null, dispense is documentation-only (no stock movement), e.g. ordonnance remise.
  inventoryItemId     String?
  orderItemId         String?  @unique
  quantityDispensed   Int
  dosageInstructions  String?
  dispensedByUserId   String
  dispensedAt         DateTime @default(now())
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter         Encounter          @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  facility          Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  catalogMedication CatalogMedication? @relation(fields: [catalogMedicationId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  orderItem         OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  dispensedBy       User              @relation(fields: [dispensedByUserId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([encounterId])
  @@index([facilityId])
  @@index([inventoryItemId])
  @@index([dispensedAt])
}

/// Append-only bedside medication administrations (MAR log); does not replace OrderItem lifecycle.
model MedicationAdministration {
  id                      String   @id @default(uuid())
  facilityId              String
  patientId               String
  encounterId             String
  orderItemId             String?
  medicationLabelSnapshot String?
  /// Route as documented at administration time (e.g. IV, IM, SQ, PO); preferred over catalog for billing CPT inference.
  route                   String?
  administeredAt          DateTime @default(now())
  administeredByUserId    String
  notes                   String?
  createdAt               DateTime @default(now())

  facility       Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter  @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  orderItem      OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  administeredBy User       @relation(fields: [administeredByUserId], references: [id], onDelete: Restrict)

  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderItemId])
  @@index([administeredAt])
}

// --- Medora Public Health: vaccination + disease reporting ---
model VaccineCatalog {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  /// Optional CPT/HCPCS-style suggestion for billing; not validated or auto-applied.
  billingCodeDefault String?
  description  String?
  manufacturer String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vaccineAdministrations VaccineAdministration[]
}

model VaccineAdministration {
  id                   String    @id @default(uuid())
  patientId            String
  facilityId           String
  encounterId          String?
  vaccineCatalogId     String
  doseNumber           Int?
  lotNumber            String?
  administeredAt       DateTime  @default(now())
  administeredByUserId String?
  nextDueAt            DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter      Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  vaccineCatalog VaccineCatalog @relation(fields: [vaccineCatalogId], references: [id], onDelete: Restrict)
  administeredBy User?          @relation(fields: [administeredByUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([facilityId])
  @@index([encounterId])
  @@index([vaccineCatalogId])
  @@index([administeredAt])
}

model DiseaseCaseReport {
  id               String            @id @default(uuid())
  patientId        String?
  facilityId       String
  encounterId      String?
  diseaseCode      String
  diseaseName      String
  status           DiseaseCaseStatus
  reportedAt       DateTime          @default(now())
  /// Date de début des signes (équivalent dossier initial « symptom onset »).
  onsetDate        DateTime?
  commune          String?
  department       String?
  /// Référentiel national GeoCommune (obligatoire à la création via API ; dénormalisation `commune`/`department` pour affichage).
  geoCommuneId     String?
  notes            String?
  reportedByUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Dossier initial — signes (pas de champs de décision MSPP département/central ici).
  feverReported    Boolean?
  symptomDuration  String?           @db.VarChar(256)
  hospitalized     Boolean?
  outcomeStatus    String?           @db.VarChar(128)
  labConfirmed     Boolean?
  labEvidenceType  MsppLabEvidenceType?
  epiLinkedCase    Boolean?
  travelOrExposureContext String?    @db.Text
  clinicalSummary  String?           @db.Text
  provisionalCaseClassification MsppCaseClassification?

  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter   Encounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  reportedBy  User?        @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)
  geoCommune  GeoCommune?  @relation(fields: [geoCommuneId], references: [id], onDelete: SetNull)
  msppFeedbacks MsppDiseaseReportFeedback[]

  @@index([facilityId])
  @@index([patientId])
  @@index([diseaseCode])
  @@index([status])
  @@index([reportedAt])
  @@index([geoCommuneId])
}

/// FRONT_DESK (and others) create via API; `encounterId` optional for registration desk follow-ups.
model FollowUp {
  id               String         @id @default(uuid())
  patientId        String
  facilityId       String
  encounterId      String?
  dueDate          DateTime
  reason           String?
  status           FollowUpStatus  @default(OPEN)
  notes            String?
  createdByUserId  String?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facility  Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([facilityId])
  @@index([dueDate])
  @@index([status])
  @@index([facilityId, status, dueDate])
}

/// Classification du cas pour la revue de surveillance (MSPP).
enum MsppCaseClassification {
  SUSPECT
  PROBABLE
  CONFIRMED
  NOT_A_CASE
}

/// Type de preuve biologique documentée à la revue.
enum MsppLabEvidenceType {
  NONE
  PCR
  RAPID_ANTIGEN
  CULTURE
  SEROLOGY
  OTHER
}

/// MSPP-style review record. Phase 1: optional `diseaseCaseReportId` without FK to `DiseaseCaseReport` until relations are confirmed.
model DiseaseCaseReview {
  id                  String    @id @default(uuid())
  diseaseCaseReportId String?
  reviewerUserId      String?
  status              String
  reviewerLevel       String
  departmentId        String
  notes               String?
  reviewedAt          DateTime?
  /// Dernière décision : critère structuré — présence de fièvre (oui/non).
  validationFever         Boolean?
  /// Durée des signes ou de l’épisode (texte court).
  validationDuration      String?
  /// Confirmation biologique (oui/non).
  validationLabConfirmed  Boolean?
  /// Risque d’exposition : LOW | MEDIUM | HIGH | UNKNOWN.
  validationExposureRisk  String?
  /// Classification épidémiologique du cas (revue structurée).
  caseClassification       MsppCaseClassification?
  inclusionCriteriaSummary String?                 @db.Text
  exclusionCriteriaSummary String?                 @db.Text
  symptomOnsetDate         DateTime?
  hospitalized             Boolean?
  outcomeStatus            String?                 @db.VarChar(128)
  labEvidenceType          MsppLabEvidenceType?
  epiLinkedCase            Boolean?
  travelOrExposureContext  String?                 @db.Text
  finalDecisionRationale   String?                 @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditEvents MsppReviewAuditEvent[]
  msppFeedbacks MsppDiseaseReportFeedback[]

  @@unique([diseaseCaseReportId])
  @@index([reviewerUserId])
  @@index([departmentId])
}

/// Immutable MSPP validation/review events (append-only; complements `notes` on DiseaseCaseReview).
model MsppReviewAuditEvent {
  id                  String   @id @default(uuid())
  diseaseCaseReviewId String
  diseaseCaseReportId String?
  /// e.g. DEPARTMENT_APPROVE, CENTRAL_REQUEUE — see `mspp.constants` / app layer.
  action              String
  reviewerUserId      String
  /// DEPARTMENT | CENTRAL — niveau de la décision ou de la file concernée.
  reviewerLevel       String
  statusBefore        String?
  statusAfter         String?
  requeued            Boolean  @default(false)
  criteriaSnapshot    Json?
  createdAt           DateTime @default(now())

  diseaseCaseReview DiseaseCaseReview @relation(fields: [diseaseCaseReviewId], references: [id], onDelete: Cascade)
  reviewer          User              @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([diseaseCaseReviewId])
  @@index([diseaseCaseReportId])
  @@index([createdAt])
}

/// Haiti national geographic department (département).
model GeoDepartment {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  sortOrder Int?
  communes  GeoCommune[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Commune within a geographic department.
model GeoCommune {
  id              String            @id @default(uuid())
  geoDepartmentId String
  department      GeoDepartment     @relation(fields: [geoDepartmentId], references: [id], onDelete: Restrict)
  code            String?
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  diseaseCaseReports DiseaseCaseReport[]

  @@unique([geoDepartmentId, name])
  @@index([geoDepartmentId])
  @@index([name])
}

/// Internal handling state for national escalation rows (not disease validation).
enum MsppAlertTriageStatus {
  NEW
  ACKNOWLEDGED
  UNDER_REVIEW
  ESCALATED_INTERNAL
  CLOSED
}

/// Per-window triage for computed MSPP escalation rows (`alertKey` from `computeMsppAlertKey`).
model MsppAlertTriage {
  id                   String                @id @default(uuid())
  alertKey             String                @unique
  windowCurrentStart   DateTime
  windowCurrentEnd     DateTime
  scope                String
  escalationLevel      String
  diseaseCode          String
  departmentId         String
  geoCommuneId         String?
  triageStatus         MsppAlertTriageStatus @default(NEW)
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  assignedToUserId     String?
  triageNote           String?               @db.Text
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  acknowledgedBy User? @relation("MsppAlertTriageAckBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  assignedTo     User? @relation("MsppAlertTriageAssignTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  investigation  MsppAlertInvestigation?

  @@index([triageStatus])
  @@index([departmentId])
  @@index([updatedAt])
}

/// Suivi opérationnel interne lié à une alerte d’escalade (pas déclaration d’épidémie ; distinct du triage).
enum MsppAlertInvestigationStatus {
  OPEN
  FIELD_VERIFICATION
  LAB_FOLLOWUP
  COORDINATION_ACTIVE
  CLOSED
}

enum MsppAlertInvestigationEventAction {
  OPENED
  STATUS_CHANGED
  NOTE_ADDED
  ASSIGNED
}

model MsppAlertInvestigation {
  id                  String                       @id @default(uuid())
  alertKey            String                       @unique
  msppAlertTriageId   String?                      @unique
  diseaseCode         String
  escalationLevel     String
  departmentId        String
  geoCommuneId        String?
  investigationStatus MsppAlertInvestigationStatus @default(OPEN)
  openedAt            DateTime                     @default(now())
  openedByUserId      String
  assignedToUserId    String?
  summary             String?                      @db.Text
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  msppAlertTriage MsppAlertTriage? @relation(fields: [msppAlertTriageId], references: [id], onDelete: SetNull)
  openedBy       User @relation("MsppAlertInvestigationOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedTo     User? @relation("MsppAlertInvestigationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  events         MsppAlertInvestigationEvent[]

  @@index([investigationStatus])
  @@index([departmentId])
  @@index([updatedAt])
}

model MsppAlertInvestigationEvent {
  id               String                         @id @default(uuid())
  investigationId  String
  action           MsppAlertInvestigationEventAction
  note             String?                        @db.Text
  statusBefore     MsppAlertInvestigationStatus?
  statusAfter      MsppAlertInvestigationStatus?
  assignedToUserId String?
  createdByUserId  String
  createdAt        DateTime                       @default(now())

  investigation MsppAlertInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  createdBy     User @relation("MsppAlertInvestigationEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([investigationId, createdAt])
}

/// Structured quality feedback from MSPP to facilities (does not mutate the declaration).
enum MsppDiseaseReportFeedbackCategory {
  GEO_INCOMPLETE
  CLINICAL_INCOMPLETE
  LAB_MISSING
  CODE_VERIFY
  DUPLICATE_SUSPECTED
  DATA_INCONSISTENT
  OTHER
}

enum MsppDiseaseReportFeedbackSeverity {
  INFO
  WARNING
  ACTION_REQUIRED
}

enum MsppDiseaseReportFeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model MsppDiseaseReportFeedback {
  id                       String                            @id @default(uuid())
  diseaseCaseReportId      String
  diseaseCaseReviewId      String?
  category                 MsppDiseaseReportFeedbackCategory
  severity                 MsppDiseaseReportFeedbackSeverity
  feedbackText             String                            @db.Text
  status                   MsppDiseaseReportFeedbackStatus @default(OPEN)
  createdByUserId          String
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  facilityReviewedAt       DateTime?
  facilityReviewedByUserId String?
  resolvedAt               DateTime?
  resolvedByUserId         String?

  report             DiseaseCaseReport @relation(fields: [diseaseCaseReportId], references: [id], onDelete: Restrict)
  review             DiseaseCaseReview? @relation(fields: [diseaseCaseReviewId], references: [id], onDelete: SetNull)
  createdBy          User              @relation("MsppDiseaseReportFeedbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  facilityReviewedBy User?             @relation("MsppDiseaseReportFeedbackFacilityReviewedBy", fields: [facilityReviewedByUserId], references: [id], onDelete: SetNull)
  resolvedBy         User?             @relation("MsppDiseaseReportFeedbackResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([diseaseCaseReportId])
  @@index([status])
  @@index([severity])
}

/// National MSPP access (not tied to facility `UserRole`). For `MSPP_VALIDATOR_DEPT`: either `geoDepartmentId` or `allGeoDepartments`.
model MsppUserRoleAssignment {
  id                 String       @id @default(uuid())
  userId             String
  role               MsppRoleCode
  geoDepartmentId    String?
  /// When true with `MSPP_VALIDATOR_DEPT`, user may act on every geographic department (national dept-level scope).
  allGeoDepartments    Boolean      @default(false)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([geoDepartmentId])
  @@index([userId, role])
  @@index([userId, role, allGeoDepartments])
}

/// Per-facility monotonic sequences for X12 control numbers (ISA / GS / ST, etc.).
model ClaimControlCounter {
  id         String   @id @default(cuid())
  facilityId String
  /// ISA | GS | ST — extensible string discriminator
  type       String
  lastValue  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, type])
}

/// One interchange envelope batch (ISA/IEA) — may contain multiple GS groups / ST sets.
model ClaimSubmissionBatch {
  id                 String   @id @default(cuid())
  facilityId         String
  interchangeCtrl    String
  groupCtrl          String
  senderId           String?
  receiverId         String?
  /// Full interchange text (ISA…IEA) for audit; optional if generation failed mid-flight.
  interchangeX12Text String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  facility     Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  submissions  ClaimSubmission[]
  acknowledgments ClaimAcknowledgment[]

  @@index([facilityId])
  @@index([interchangeCtrl])
}

/// One persisted 837 transaction artifact tied to an encounter package side.
model ClaimSubmission {
  id                String                @id @default(cuid())
  facilityId        String
  encounterId       String
  claimType         ClaimSubmissionKind
  status            ClaimSubmissionStatus @default(DRAFT)
  batchId           String?
  transactionCtrl   String?
  /// Transaction-local ST…SE text (this claim only).
  x12Text           String?               @db.Text
  exportJson        Json?
  warningsJson      Json?
  missingFieldsJson Json?
  externalReference String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  batch     ClaimSubmissionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  facility  Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  encounter Encounter             @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  attempts  ClaimSubmissionAttempt[]
  acknowledgments ClaimAcknowledgment[]

  @@index([encounterId])
  @@index([facilityId, status])
  @@index([batchId])
  @@index([claimType])
}

/// Transmission attempts for one submission (manual/stub transport audit trail).
model ClaimSubmissionAttempt {
  id              String   @id @default(cuid())
  submissionId    String
  transport       String
  ok              Boolean
  requestMetaJson Json?
  responseMetaJson Json?
  errorMessage    String?
  /// Phase 6.6 — operational classification (e.g. same as errorMessage or normalized token).
  failureCode     String?
  retryEligible   Boolean  @default(false)
  nextRetryAt     DateTime?
  createdAt       DateTime @default(now())

  submission ClaimSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([retryEligible, nextRetryAt])
}

/// Persisted clearinghouse acknowledgments (999/277CA) including unmatched rows.
model ClaimAcknowledgment {
  id              String   @id @default(cuid())
  facilityId      String
  submissionId    String?
  batchId         String?
  kind            String
  rawText         String   @db.Text
  parsedJson      Json?
  statusCode      String?
  message         String?
  warningCode     String?
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  facility   Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  submission ClaimSubmission?      @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  batch      ClaimSubmissionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([facilityId, receivedAt])
  @@index([submissionId])
  @@index([batchId])
  @@index([kind])
}

/// Inbound ACK payloads that failed validation/parse — preserved for operator replay (Phase 6.6).
model ClaimAcknowledgmentDeadLetter {
  id              String    @id @default(cuid())
  facilityId      String
  rawText         String    @db.Text
  source          String
  failureCode     String
  failureDetail   String?   @db.Text
  vendorMeta      Json?
  replayedAt      DateTime?
  replayedToAckId String?
  createdAt       DateTime  @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@index([facilityId, replayedAt])
}
