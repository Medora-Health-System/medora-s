/// Phase 9 — drug–drug interaction knowledge (no patient evaluation).
model MedicationDrugInteraction {
  id                              String   @id @default(uuid())
  subjectMedicationConceptId      String?
  objectMedicationConceptId       String?
  subjectMedicationProductId      String?
  objectMedicationProductId       String?
  /// Symmetric: lower|higher|scope|sourceVersionId; directional: DIR|subject|object|scope|sourceVersionId
  normalizedPairKey               String   @db.VarChar(512)
  directional                     Boolean  @default(false)
  /// CONCEPT_TO_CONCEPT | PRODUCT_TO_PRODUCT | CONCEPT_TO_PRODUCT | INGREDIENT_TO_INGREDIENT
  interactionScope                String   @db.VarChar(48)
  interactionType                 String   @db.VarChar(48)
  severity                        String   @db.VarChar(32)
  clinicalSignificance            String?  @db.VarChar(32)
  evidenceLevel                   String?  @db.VarChar(48)
  onset                           String?  @db.VarChar(32)
  mechanism                       String?
  clinicalEffect                  String?
  managementRecommendation        String?
  monitoringRecommendation        String?
  administrationSeparationMinutes Int?
  contraindicatedCombination      Boolean  @default(false)
  emergencyContextNotesJson       Json?
  futureAlertEligible             Boolean  @default(false)
  clinicalActivationAllowed       Boolean  @default(false)
  sourceVersionId                 String
  /// DRAFT | UNDER_REVIEW | APPROVED | SUPERSEDED | RETIRED | REJECTED
  status                          String   @default("DRAFT") @db.VarChar(32)
  reviewedByUserId                String?
  reviewedAt                      DateTime?
  approvedByUserId                String?
  approvedAt                      DateTime?
  effectiveDate                   DateTime?
  supersedesId                    String?
  notes                           String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  subjectConcept                  MedicationConcept? @relation("MedicationDrugInteractionSubjectConcept", fields: [subjectMedicationConceptId], references: [id], onDelete: Restrict)
  objectConcept                   MedicationConcept? @relation("MedicationDrugInteractionObjectConcept", fields: [objectMedicationConceptId], references: [id], onDelete: Restrict)
  subjectProduct                  MedicationProduct? @relation("MedicationDrugInteractionSubjectProduct", fields: [subjectMedicationProductId], references: [id], onDelete: Restrict)
  objectProduct                   MedicationProduct? @relation("MedicationDrugInteractionObjectProduct", fields: [objectMedicationProductId], references: [id], onDelete: Restrict)
  sourceVersion                   MedicationSafetyKnowledgeVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  supersedes                      MedicationDrugInteraction? @relation("MedicationDrugInteractionSupersession", fields: [supersedesId], references: [id])
  supersededBy                    MedicationDrugInteraction[] @relation("MedicationDrugInteractionSupersession")
  evidenceRows                    MedicationSafetyEvidence[]

  @@index([normalizedPairKey])
  @@index([sourceVersionId])
  @@index([status])
  @@index([severity])
  @@index([directional])
  @@index([futureAlertEligible])
  @@index([clinicalActivationAllowed])
  @@index([subjectMedicationConceptId])
  @@index([objectMedicationConceptId])
}

