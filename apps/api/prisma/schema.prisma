  code               String                      @unique
  genericName        String
  displayName        String
  therapeuticClassId String?
  rxNormConceptId    String?                     @db.VarChar(64)
  isActive           Boolean                     @default(true)
  retiredAt          DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
