  precautions                     MedicationPrecaution[]
  blackBoxWarnings                MedicationBlackBoxWarning[]
  pregnancyInformation            MedicationPregnancyInformation[]
  lactationInformation            MedicationLactationInformation[]
  highAlertProfiles               MedicationHighAlertProfile[]
  emergencyProfiles               MedicationEmergencyProfile[]
  storageRequirements             MedicationStorageRequirement[]
  reconstitutionInstructions      MedicationReconstitutionInstruction[]

  @@index([conceptId])
  @@index([productId])
  @@index([sourceId])
  @@index([knowledgeVersionId])
  @@index([lifecycleStatus])
  @@index([clinicalActivationAllowed])
}

