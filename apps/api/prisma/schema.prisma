model MedicationProductRoutePermission {
  id                    String            @id @default(uuid())
  productId             String
  routeId               String
  /// ALLOWED | RESTRICTED | INACTIVE | DEPRECATED | REQUIRES_CONFIGURATION | NOT_VERIFIED
  eligibilityStatus     String            @default("NOT_VERIFIED") @db.VarChar(32)
  requiresConfiguration Boolean           @default(false)
  notes                 String?
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  product               MedicationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  route                 MedicationRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([productId, routeId])
  @@index([productId])
  @@index([routeId])
  @@index([eligibilityStatus])
}

/// RxNorm reference release registry — staging only in Phase 3; not wired to clinical order search.
model RxNormReferenceRelease {
  id                   String                   @id @default(uuid())
  sourceVocabulary     String                   @default("RXNORM") @db.VarChar(32)
  releaseIdentifier    String                   @db.VarChar(64)
  releaseDate          DateTime?
  importedAt           DateTime?
  sourceFilename       String?                  @db.VarChar(255)
  sourceChecksumSha256 String                   @db.VarChar(64)
  sourceFormat         String                   @db.VarChar(32)
  importStatus         String                   @default("REGISTERED") @db.VarChar(32)
  importModeLast       String?                  @db.VarChar(32)
  isSynthetic          Boolean                  @default(false)
  isActiveReference    Boolean                  @default(false)
  /// NLM_OFFICIAL | APPROVED_NLM_EXTRACT | SYNTHETIC_FIXTURE | DEV_SAMPLE | UNKNOWN
  sourceClassification String?                  @db.VarChar(32)
  /// LIMITED_APPROVED_EXTRACT | DEVELOPMENT_SUBSET | TERM_TYPE_SCOPED_IMPORT | RXCUI_ALLOWLIST | FULL_RELEASE
  releaseScope         String?                  @db.VarChar(32)
  releaseVersionOfficial String?                @db.VarChar(64)
  retrievedAt          DateTime?
  sourceUrlOrDescription String?
  licenseAcknowledged  Boolean                  @default(false)
  importPurpose        String?                  @db.VarChar(64)
  authorizedOperator   String?                  @db.VarChar(128)
  manifestJson         Json?
  manifestHashSha256   String?                  @db.VarChar(64)
  fileManifestJson     Json?
  normalizationVersion String?                  @default("RXNORM_NORMALIZATION_V1") @db.VarChar(64)
  parsingVersion       String?                  @default("RXNCONSO_PARSER_V1") @db.VarChar(64)
  /// REFERENCE_RELEASE_ACTIVE | CLINICALLY_ACTIVE (Phase 5 never sets CLINICALLY_ACTIVE)
  referenceActivationStatus String?             @db.VarChar(32)
  lastCheckpointJson   Json?
  recordCount          Int                      @default(0)
  acceptedCount        Int                      @default(0)
  rejectedCount        Int                      @default(0)
  duplicateCount       Int                      @default(0)
  conflictCount        Int                      @default(0)
  warningCount         Int                      @default(0)
  errorCount           Int                      @default(0)
  startedByUserId      String?
  startedAt            DateTime?
  completedAt          DateTime?
  failureReason        String?
  supersededByReleaseId String?
  rollbackStatus       String?                  @db.VarChar(32)
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  jobs                 RxNormImportJob[]
  stagingConcepts      RxNormStagingConcept[]
  mappingCandidates    RxNormMappingCandidate[]
  verifiedMappings     RxNormVerifiedMapping[]
  conflicts            RxNormImportConflict[]
  startedBy            User?                    @relation("RxNormReferenceReleaseStartedBy", fields: [startedByUserId], references: [id])
  supersededBy         RxNormReferenceRelease?  @relation("RxNormReferenceReleaseSupersession", fields: [supersededByReleaseId], references: [id])
  supersedes           RxNormReferenceRelease[] @relation("RxNormReferenceReleaseSupersession")

  @@unique([sourceVocabulary, releaseIdentifier])
  @@index([sourceChecksumSha256])
  @@index([importStatus])
  @@index([isActiveReference])
  @@index([sourceClassification])
  @@index([releaseScope])
  @@index([manifestHashSha256])
}

model RxNormImportJob {
  id              String               @id @default(uuid())
  releaseId       String
  mode            String               @db.VarChar(32)
  status          String               @default("PENDING") @db.VarChar(32)
  dryRun          Boolean              @default(false)
  startedByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  acceptedCount   Int                  @default(0)
  rejectedCount   Int                  @default(0)
  duplicateCount  Int                  @default(0)
  conflictCount   Int                  @default(0)
  warningCount    Int                  @default(0)
  errorCount      Int                  @default(0)
  failureReason   String?
  resultSummaryJson Json?
  manifestHashSha256 String?           @db.VarChar(64)
  rowsRead        Int                  @default(0)
  rowsSkipped     Int                  @default(0)
  malformedRows   Int                  @default(0)
  checkpointJson  Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  release         RxNormReferenceRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  startedBy       User?                @relation("RxNormImportJobStartedBy", fields: [startedByUserId], references: [id])

  @@index([releaseId])
  @@index([status])
  @@index([mode])
  @@index([manifestHashSha256])
}

model RxNormStagingConcept {
  id                      String                 @id @default(uuid())
  releaseId               String
  rxcui                   String                 @db.VarChar(64)
  termType                String                 @db.VarChar(16)
  language                String?                @db.VarChar(16)
  suppressFlag            String?                @db.VarChar(8)
  sourceVocabulary        String                 @default("RXNORM") @db.VarChar(32)
  sourceCode              String?                @db.VarChar(64)
  displayTerm             String
  normalizedTerm          String
  ingredientIdentity      String?                @db.VarChar(128)
  strengthText            String?                @db.VarChar(128)
  doseFormText            String?                @db.VarChar(128)
  brandName               String?                @db.VarChar(128)
  relationshipMetadata    Json?
  sourceRowNumber         Int?
  rowChecksum             String                 @db.VarChar(64)
  parsingStatus           String                 @default("PARSED") @db.VarChar(32)
  validationStatus        String                 @default("ACCEPTED") @db.VarChar(32)
  conflictStatus          String                 @default("NONE") @db.VarChar(32)
  rejectionReason         String?
  isSearchableReference   Boolean                @default(false)
  isOrderableEligible     Boolean                @default(false)
