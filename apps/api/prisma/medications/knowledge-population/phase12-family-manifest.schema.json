{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase12-family-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestKey",
    "version",
    "families",
    "clinicalActivationAllowed"
  ],
  "properties": {
    "manifestKey": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "clinicalActivationAllowed": {
      "const": false
    },
    "providerFacingAlertsAllowed": {
      "const": false
    },
    "orderBlockingAllowed": {
      "const": false
    },
    "automaticApprovalAllowed": {
      "const": false
    },
    "fixtureMarker": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "families": {
      "type": "array",
      "minItems": 1
    }
  }
}