{
  "name": "@medora/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "pnpm --filter @medora/shared build",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 5000",
    "lint": "node -e \"console.log('lint not configured yet')\"",
