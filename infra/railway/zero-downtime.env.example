# =============================================================================
# PLAT.AVAIL.1A — MANUAL Railway API settings (examples only)
# =============================================================================
# These values are documentation for operators to copy into the Railway
# dashboard (API service → Settings / Variables).
#
# This file is NOT read by Medora at runtime.
# Committing it does NOT automatically configure Railway.
# Railway does not apply these keys unless they are set in the Railway UI
# (or Railway’s own deployment settings).
#
# Healthcheck Path (Railway Settings → Healthcheck):
#   /health/ready
#
# Recommended Railway settings:
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=60
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
#
# Replica count: keep 1 until in-memory and local-filesystem blockers are solved.
# Do not raise replicas in this repository.
#
# -----------------------------------------------------------------------------
# VOLUME / OVERLAP WARNING
# -----------------------------------------------------------------------------
# Overlapping (zero-downtime) deployment is NOT guaranteed if the API service
# has an attached persistent volume. Railway cannot run two replicas that both
# mount the same volume.
#
# If the API service has an attached persistent volume:
#   do not enable or claim overlapping zero-downtime deployment until the
#   storage architecture is corrected.
#
# Volume attachment status is UNKNOWN until checked in the Railway UI.
# Code default local document path is /tmp/medora-documents (ephemeral).
# That does not prove Railway has (or does not have) a volume attached.
#
# Keep replica count at 1 while any of these remain:
#   - FailedLoginTracker is in-memory
#   - medication / billing schedulers and SFTP poller would duplicate
#   - document storage is filesystem-local
# =============================================================================
