{
  "name": "medora-s",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "bash scripts/verify-stability.sh",
    "verify:shared": "pnpm --filter @medora/shared build",
    "verify:web": "pnpm --filter @medora/web exec tsc --noEmit",
    "verify:api": "pnpm --filter @medora/api exec prisma generate && pnpm --filter @medora/api exec tsc --noEmit -p tsconfig.build.json",
    "db:clear:patients": "pnpm --filter @medora/api run db:clear:patients",
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@medora/web",
    "dev:api": "npm run dev --workspace=@medora/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "handbook:diagrams": "node scripts/handbook/render-diagrams.mjs --png",
    "handbook:screenshots:placeholders": "node scripts/handbook/render-screenshot-placeholders.mjs",
    "handbook:assemble": "node scripts/handbook/assemble-handbook.mjs",
    "handbook:export": "node scripts/handbook/export-handbook.mjs",
    "handbook:assets": "pnpm handbook:diagrams && pnpm handbook:screenshots:placeholders && pnpm handbook:assemble"
  }
}

